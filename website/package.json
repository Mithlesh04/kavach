{
  "name": "website",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "node scripts/dev-search.mjs && next dev",
    "build": "next build && node -e \"require('fs').rmSync('out/pagefind-dev', { recursive: true, force: true })\" && pagefind --site out",
    "start": "next start",
    "lint": "eslint",
    "check": "node scripts/build-benchmarks.mjs && node scripts/build-tokens.mjs && tsc --noEmit && eslint . && node scripts/check-refs.mjs && node scripts/check-samples.mjs && npm run build",
    "check:samples": "node scripts/check-samples.mjs",
    "check:refs": "node scripts/check-refs.mjs",
    "benchmarks": "node scripts/build-benchmarks.mjs",
    "tokens": "node scripts/build-tokens.mjs",
    "deploy:pages": "node scripts/deploy-pages.mjs"
  },
  "dependencies": {
    "@mdx-js/loader": "^3.1.1",
    "@mdx-js/react": "^3.1.1",
    "@next/mdx": "^16.4.3",
    "@types/mdx": "^2.0.14",
    "next": "16.4.3",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "shiki": "^4.5.0"
  },
  "devDependencies": {
    "@tailwindcss/turbopack": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.4.3",
    "pagefind": "^1.6.0",
    "tailwindcss": "^4",
    "typescript": "^5"
  }
}