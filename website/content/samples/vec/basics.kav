use std.vec

fn main() {
    const ship = Vec2(x: 3.0, y: 4.0)
    const target = Vec2(x: 6.0, y: 8.0)
    print(ship.length())
    print(ship.distance(target))
    print(ship.lerp(target, 0.5))
    print((target - ship).normalized())
    print(ship * 2.0)
    const up = Vec3(x: 0.0, y: 1.0, z: 0.0)
    print(Vec3(x: 3.0, y: 4.0, z: 0.0).cross(up))
}
