type Box<T> {
    pub value: T
    fn get(self) -> T { self.value }
}

fn main() {
    for m in Box.members() {
        print(`{m.kind} {m.name} -> {m.result}`)
    }
    for m in List.members().filter(m => m.name == "first" or m.name == "push") {
        print(`{m.name}({m.params.map(p => p.type_name).join(", ")}) -> {m.result}`)
    }
    for m in Dict.members().filter(m => m.name == "get") {
        print(`{m.name}({m.params.map(p => `{p.name}: {p.type_name}`).join(", ")}) -> {m.result}`)
    }
}
