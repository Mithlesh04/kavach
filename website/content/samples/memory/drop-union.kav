type Seat: Drop = Booked(name: String) | Empty

extend Seat {
    fn drop(self) uses Console {
        match self {
            Seat.Booked(name) => print("released the seat of {name}"),
            Seat.Empty => print("nothing to release"),
        }
    }
}

fn main() {
    const _first = Seat.Booked(name: "Asha")
    const _second = Seat.Empty
    print("the show starts")
}
