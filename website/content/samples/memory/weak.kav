type Room {
    name: String
    doors: Shared<[Door]>
}

type Door {
    to: Weak<Room>            // a door doesn't keep its room alive
}

fn main() {
    const no_doors: [Door] = []
    const hall = Shared(Room(name: "hall", doors: Shared(no_doors)))
    const back = hall.weak()
    hall.get().doors.update(doors => {
        let more = doors
        more.push(Door(to: back))
        more
    })
    if let room = back.shared() {
        print(room.get().name)
    }
    const lost = Shared(5).weak()   // nothing holds the 5
    print(lost)
    print(lost.shared() == none)
}
