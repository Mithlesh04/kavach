type Note: Drop {
    name: String

    fn drop(self) uses Console {
        print("freed {self.name}")
    }
}

fn find(name: String) -> Note? {
    if name.len() > 0 {
        return Note(name: name)
    }
    none
}

fn main() {
    if let n = find("receipt") {
        print("found {n.name}")
    }
    print("after the if let")
}
