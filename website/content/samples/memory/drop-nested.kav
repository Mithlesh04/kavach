type Note: Drop {
    name: String

    fn drop(self) uses Console {
        print("freed {self.name}")
    }
}

fn outer(n: Note) -> fn() -> fn() -> String {
    () => () => n.name          // the inner lambda holds a copy too
}

fn main() {
    const make = outer(Note(name: "deep"))
    const inner = make()
    print("inner says {inner()}")
    print("end of main")
}
