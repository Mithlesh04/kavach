type Note: Drop {
    name: String

    fn drop(self) uses Console {
        print("freed {self.name}")
    }
}

fn renew(inout n: Note) {
    n = Note(name: "second")
    print("renew: new value given")
}

fn main() {
    let n = Note(name: "first")
    renew(n)
    print("back in main: {n.name}")
}
