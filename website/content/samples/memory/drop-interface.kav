interface Named {
    fn name(self) -> String
}

type Note: Drop, Named {
    text: String

    fn name(self) -> String {
        self.text
    }

    fn drop(self) uses Console {
        print("freed {self.text}")
    }
}

fn main() {
    const n: Named = Note(text: "boxed")
    print("named {n.name()}")
    print("end of main")
}
