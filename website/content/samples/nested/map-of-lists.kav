fn main() {
    let groups: {String: [String]} = {
        "fruit": ["apple"],
        "veg": [],
    }
    print(groups["fruit"] ?? [])          // a dict gives an optional

    groups["fruit"].push("mango")          // changes the list in the dict

    groups["nuts"] = ["almond", "cashew"]  // a new key with a new list
    for (name, items) in groups {
        print(`{name}: {items.len()}`)
    }
}
