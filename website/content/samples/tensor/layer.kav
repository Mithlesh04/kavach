use std.tensor

// One layer of a small neural network: four inputs, two batches, three outputs.
fn main() {
    const inputs = tensor.of_rows([[1.0, 0.0, 2.0, -1.0], [0.5, 1.0, 0.0, 2.0]])
    const weights = tensor.full([4, 3], 0.5)
    const bias = tensor.of_rows([[0.1, -3.0, 0.2], [0.1, -3.0, 0.2]])
    const out = (inputs @ weights + bias).map(v => if v > 0.0 { v } else { 0.0 })
    print(out.shape)
    print(out.items)
    print(out.max() ?? 0.0)
}
