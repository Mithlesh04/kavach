use std.tensor

fn main() {
    const t = tensor.arange(0, 6).reshape([2, 3])   // [[0, 1, 2], [3, 4, 5]]
    print(t[1, 0])
    print(t[1, #1])              // #1: the last of its own dimension
    print(t[#2, 0])
    print(t.get([1, 2]) ?? -1)
    print(t.get([2, 0]) ?? -1)   // out of range: none
    print(tensor.full([], 2.5).item())
}
