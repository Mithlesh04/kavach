gpu fn brighten(p: Float32) -> Float32 {
    (p * 1.5).clamp(0.0, 1.0)
}

fn main() {
    const numbers = [5, 3, 9, 1]
    const sorted = on cores(1) numbers.sort()   // library work on at most 1 core
    print(sorted)
    const pixels: [Float32] = [0.2, 0.5, 0.8]
    const bright = on cpu pixels.map(brighten)  // this map stays on the CPU
    print(bright)
    print(pixels.map(brighten) == bright)       // the same value without `on`
}
