fn first_over(xs: [Int], limit: Int) -> Int? {
    on cores for i in 0..xs.len() {
        if xs[i] > limit {
            return i
        }
    }
    none
}

fn main() {
    let xs: [Int] = []
    for i in 0..100_000 {
        xs.push(i % 1000)
    }
    print(first_over(xs, 998))
    print(first_over(xs, 5000))
}
