fn main() {
    const (send, receive) = Channel<String>(capacity: 2)
    send.put("first")
    send.close()
    for _ in 1..=2 {
        match receive.take() {
            Taken.Item(text) => print("took {text}"),
            Taken.Closed => print("closed: nothing more will come"),
        }
    }
}
