fn main() {
    const (send, receive) = Channel<String>(capacity: 1)
    const next = receive.take().timeout(200.ms) catch e => {
        print("no message: {e}")
        Taken.Closed
    }
    match next {
        Taken.Item(text) => print(text),
        Taken.Closed => print("nothing came"),
    }
    send.close()
}
