use std.log

fn main() ! Error {
    print(log.trace_id() ?? "no trace outside a span")
    log.span("request") {
        const id = log.trace_id() ?? ""
        print("trace id: {id.len()} hex digits")
        const header = log.traceparent() ?? ""
        print("traceparent: {header.len()} characters, starts {header.slice(0, 3)}")
        const task = spawn log.trace_id()
        print("a task keeps it: {(try task.wait()) == id}")
    }
    print(log.trace_id() ?? "no trace after it")

    const continued = log.span("next", from: "00-4bf92f3577b34da6a3ce929d0e0e4736-00f067aa0ba902b7-01") {
        log.trace_id() ?? ""
    }
    print(continued)
}
