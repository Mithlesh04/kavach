use std.http
use std.net

fn echo(r: Request) -> Response {
    const auth = r.header("authorization") ?? "none"
    http.text(200, "{r.method} {r.path}, auth: {auth}, body: {r.body.text() ?? ""}")
}

fn main() ! Error {
    const listener = try net.listen("127.0.0.1:0")
    const _server = spawn http.serve(listener, echo)
    const url = "http://{listener.address()}/orders/7"
    const token = Header(name: "authorization", value: "Bearer test-token")
    const put = try http.request("PUT", url, headers: [token], body: "paid".bytes())
    print(put.body.text() ?? "")
    const gone = try http.request("DELETE", url)
    print(gone.body.text() ?? "")
}
