use std.fs
use std.http
use std.net

fn report(r: Request) -> Response uses Fs.read {
    http.file("report.txt") catch _ => http.text(404, "no such file")
}

fn main() ! Error {
    try fs.write_text("report.txt", `sales up\n`.repeat(1000))
    const listener = try net.listen("127.0.0.1:0")
    const _server = spawn http.serve(listener, report)
    const session = try http.open(`http://{listener.address()}`)
    const head = try session.request("HEAD", "/")
    print(`HEAD: {head.status}, length {head.header("content-length") ?? "?"}, {head.body.len()} bytes came`)
    const page = try session.get("/")
    print(`GET: {page.status}, {page.body.len()} bytes came`)
    session.close()
    try fs.remove("report.txt")
}
