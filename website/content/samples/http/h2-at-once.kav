use std.http
use std.http.h2
use std.net
use std.time

/// Asks for `path`, and prints the answer as soon as it comes.
fn show(c: H2Client, path: String) ! H2Error uses Net, Console {
    const reply = try c.request([
        Header(name: ":method", value: "GET"),
        Header(name: ":scheme", value: "http"),
        Header(name: ":authority", value: "localhost"),
        Header(name: ":path", value: path),
    ], Bytes([]))
    print("got {path}: {reply.body.text() ?? "?"}")
}

fn main() ! Error uses Clock {
    const listener = try net.listen("127.0.0.1:0")
    const _server = spawn http.serve(listener, r => {
        if r.path == "/report" {
            time.sleep(300.ms)      // a slow request
        }
        print("answered {r.path}")
        http.text(200, "done")
    })
    const c = try h2.connect(try net.connect(listener.address()))
    const slow = spawn show(c, "/report")
    const fast = spawn show(c, "/ping")
    try slow.wait()
    try fast.wait()
    c.close()
}
