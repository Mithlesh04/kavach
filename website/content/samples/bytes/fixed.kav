use std.crypto

fn key_of(text: String) -> Bytes<len: 32> {
    crypto.sha256(text.bytes())
}

fn main() {
    const k = key_of("asha")
    print(k.len())
    print(k[31] == k[#1])
    const plain: Bytes = k                        // fits where any `Bytes` may go
    const back = Bytes<len: 32>(plain) catch _ => k
    print(back == k)
    const short = Bytes<len: 32>(Bytes([1, 2, 3])) catch e => {
        print(e)
        k
    }
    print(short == k)
}
