use std.grpc
use std.net

type Order {
    id: Int
    item: String
    qty: Int = 1
}

type Placed {
    id: Int
    total: Float
}

fn orders(call: GrpcCall) -> GrpcReply {
    const order = grpc.read<Order>(call) catch _ => Order(id: 0, item: "")
    if order.id == 0 {
        return grpc.failed(3, "not an order")
    }
    grpc.reply(Placed(id: order.id, total: 2.5 * Float(order.qty)))
}

fn main() ! Error {
    const listener = try net.listen("127.0.0.1:0")
    const _server = spawn grpc.serve(listener, orders)
    const target = "http://{listener.address()}"
    const placed = try grpc.call<Order, Placed>(target, "/shop.Orders/Place", Order(id: 7, item: "pen", qty: 2))
    print(placed.total)
    const bad = grpc.call<Order, Placed>(target, "/shop.Orders/Place", Order(id: 0, item: "")) catch e => {
        print("failed: {e}")
        return
    }
    print(bad.total)
}
