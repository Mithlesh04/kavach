use std.fs

/// Reads a note: it only reads files.
pub fn read(name: String) -> String ! FsError uses Fs.read {
    try fs.read_text("notes/{name}.txt")
}

/// Saves a note: it writes files.
pub fn save(name: String, text: String) ! FsError uses Fs.write {
    try fs.write_text("notes/{name}.txt", text)
}
