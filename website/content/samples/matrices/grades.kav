use std.tensor

fn main() {
    // One row per student, one column per test.
    const marks = tensor.of_rows([
        [80.0, 70.0, 90.0],
        [60.0, 90.0, 75.0],
    ])
    // How much each test counts.
    const weights = tensor.of_rows([[0.25], [0.25], [0.5]])
    print((marks @ weights).to_rows())
    print(marks.sum(axis: 0).items)
}
