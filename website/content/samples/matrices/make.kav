use std.matrix

fn main() uses Console {
    const grid = matrix.of([[1, 2, 3], [4, 5, 6]])
    print("row 1: {grid.row(1)}, column 2: {grid.col(2)}")
    print(grid.slice(0, 2, 1, 3).to_rows())
    print(matrix.identity(3, 1).to_rows())

    let board = matrix.filled(2, 3, 0)
    board.items[board.index(1, 2)] = 9
    print(board.to_rows())
}
