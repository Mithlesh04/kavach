use std.tensor

fn main() {
    const a = tensor.of_rows([[1.0, 2.0], [3.0, 4.0]])
    const b = tensor.of_rows([[5.0, 6.0], [7.0, 8.0]])
    print((a @ b).to_rows())
    print((a * b).to_rows())
    print((a + b).to_rows())
    print(a.transpose().to_rows())
    print(`{a.shape}, item (1, 0) is {a[1, 0]}`)
}
