use std.json

type Item {
    name: String
    qty: Int
}

fn main() {
    const text = "[\{\"name\": 5, \"qty\": 1}, \{\"qty\": 2}, \{\"name\": \"cup\", \"qty\": \"x\"}]"
    const items = json.decode<[Item]>(text) catch e => match e {
        JsonError.Invalid(problems) => {
            print("{problems.len()} problems:")
            for p in problems {
                print("  {p.path}: {p.expected}")
            }
            []
        }
        _ => [],
    }
    print(items.len())
}
