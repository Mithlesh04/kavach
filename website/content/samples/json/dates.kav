use std.json
use std.time.{Date, DateTime}

type Booking {
    day: Date
    made: DateTime
}

fn read(text: String) {
    match json.decode<Booking>(text) {
        ok(b) => {
            print(b.made.iso())
            print(json.stringify(b))
        }
        err(JsonError.Invalid(problems)) => {
            for p in problems {
                print("[{p.path}] {p.expected}")
            }
        }
        err(e) => print(e)
    }
}

fn main() {
    read("\{\"day\": \"2024-01-02\", \"made\": \"2024-01-01T02:00:00+05:30\"}")
    read("\{\"day\": \"infinity\", \"made\": \"2024-01-02 03:04\"}")
    print(json.schema<Date>())
}
