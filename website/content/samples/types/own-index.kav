type Playlist: Index<Int, String>, IndexSet<Int, String>, Slice {
    songs: [String]

    fn len(self) -> Int { self.songs.len() }
    fn index(self, key: Int) -> String { self.songs[key] }

    fn index_set(self, key: Int, value: String) -> Playlist {
        let songs = self.songs
        songs[key] = value
        Playlist(songs: songs)
    }

    fn slice(self, part: Part) -> Playlist {
        const (start, end, step) = part.bounds(self.songs.len())
        Playlist(songs: self.songs[start:end:step])
    }
}

fn main() {
    let p = Playlist(songs: ["intro", "rain", "roads", "home"])
    print(p[0])                 // p.index(0)
    print(p[#1])                // p.index(p.len() - 1)
    p[1] = "storm"              // p = p.index_set(1, "storm")
    print(p[1:3].songs)         // p.slice(...), given start 1 and end 3
    print(p[::-1].songs)
}
