type Vec2: Mul<Vec2>, Mul<Float> {
    x: Float
    y: Float

    fn mul(self, other: Vec2) -> Vec2 { Vec2(x: self.x * other.x, y: self.y * other.y) }
    fn mul(self, other: Float) -> Vec2 { Vec2(x: self.x * other, y: self.y * other) }
}

fn main() {
    const v = Vec2(x: 1.0, y: 2.0)
    const n: Int = 3
    print(v * n)
}
