interface Shape {
    fn area(self) -> Float
    fn name(self) -> String
}

type Circle: Shape {
    radius: Float

    fn area(self) -> Float { 3.14 * self.radius * self.radius }
    fn name(self) -> String { "circle" }
}

type Square: Shape {
    side: Float

    fn area(self) -> Float { self.side * self.side }
    fn name(self) -> String { "square" }
}

type Label {
    text: String
    shape: Shape

    fn describe(self) -> String {
        "{self.text}: a {self.shape.name()} of area {self.shape.area()}"
    }
}

fn main() {
    const shapes: [Shape] = [Circle(radius: 1.0), Square(side: 2.0)]
    for s in shapes {
        print("{s.name()}: {s.area()}")
    }
    print(Label(text: "logo", shape: Square(side: 3.0)).describe())
}
