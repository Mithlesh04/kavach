/// A row of seats, numbered from 0.
type Row: IndexSet<Part, [String]> {
    seats: [String]

    fn index_set(self, key: Part, value: [String]) -> Row {
        const (start, end, step) = key.bounds(self.seats.len())
        let seats = self.seats
        seats[start:end:step] = value
        Row(seats: seats)
    }
}

fn main() {
    let r = Row(seats: ["a", "b", "c", "d"])
    r[1:3] = ["x", "y"]
    print(r.seats)
}
