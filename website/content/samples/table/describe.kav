use std.table

type Sale {
    region: String
    month: Int
    amount: Float
}

fn main() {
    const sales = table.of([
        Sale(region: "north", month: 1, amount: 120.0),
        Sale(region: "south", month: 1, amount: 80.0),
        Sale(region: "north", month: 2, amount: 100.0),
    ])
    const all = sales.describe()             // each number column
    print(all.keys())
    const amount = all["amount"] ?? return
    print(`{amount.count} {amount.mean} {amount.min} {amount.max}`)
    print(sales.describe(.month)?.median ?? 0.0)   // one column, as on a list
}
