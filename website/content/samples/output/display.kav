type Celsius: Display {
    pub degrees: Float

    fn display(self) -> String {
        "{self.degrees}°C"
    }
}

type Reading {
    pub city: String
    pub temp: Celsius
}

fn main() {
    const today = Celsius(degrees: 31.5)
    print(today)
    print("Today: {today}")
    print(String(today).len())
    print([Celsius(degrees: 18.0), Celsius(degrees: -2.5)])
    print({"Pune": today})
    print(Reading(city: "Pune", temp: today))
}
