type Rgb {
    r: Float32
    g: Float32
    b: Float32
}

gpu fn gray(r: Float32, g: Float32, b: Float32) -> Float32 {
    0.2126 * r + 0.7152 * g + 0.0722 * b
}

fn main() {
    const colors = [Rgb(r: 1.0, g: 0.0, b: 0.0), Rgb(r: 0.0, g: 1.0, b: 0.0), Rgb(r: 1.0, g: 1.0, b: 1.0)]
    print(colors.map(c => gray(c.r, c.g, c.b)))
}
