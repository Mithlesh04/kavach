gpu fn glow(x: Float32, gain: Float32) -> Float32 {
    let v = x
    for _ in 0..100 {
        v = v * 0.99 + gain
    }
    v
}

fn main() {
    let pixels: [Float32] = []
    for i in 0..1_000_000 {
        pixels.push(Float32(i % 256) / 255.0)
    }
    const lit = pixels.map(p => glow(p, 0.25))
    print(lit.len())
    print(lit.all(v => 15.8 < v < 16.3))
}
