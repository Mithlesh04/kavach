gpu fn glow(x: Float32) -> Float32 {
    x * 0.5 + 0.1
}

gpu fn dim(x: Float32) -> Float32 {
    x * 0.9
}

fn main() {
    const xs: [Float32] = [1.0, 2.0, 3.0]
    const soft = xs.map(p => glow(p)).map(p => dim(p))
    print(soft)
    const lit = xs.map(p => glow(p))
    print(lit.map(p => dim(p)))
    print(soft.filter(v => v > 1.0).sum(v => v))
}
