use std.fs

fn load(path: String) -> String ! FsError {
    try fs.read_text(path)
}

fn main() {
    const text = load("settings.toml") catch e => match e {
        FsError.NotFound(path) => "no {path} yet: using the defaults",
        FsError.Denied(path) => "not allowed to read {path}",
        FsError.Failed(path, reason) => "{path} is broken: {reason}",
    }
    print(text)
}
