use std.fs

fn main() ! Error {
    try fs.write_text("notes.txt", "first line\nsecond line\n")
    try fs.append_text("notes.txt", "third line\n")
    print(try fs.read_text("notes.txt"))
    for line in try fs.lines("notes.txt") {
        print(line.upper())
    }
    print(fs.exists("notes.txt"))
    try fs.remove("notes.txt")
    print(fs.exists("notes.txt"))
}
