use std.collections

fn main() {
    const items = ["pen", "ink", "pen", "pad", "pen"]
    print(collections.chunks([1, 2, 3, 4, 5], 2))
    print(collections.zip(["a", "b", "c"], [1, 2]))
    print(collections.unique(items))
    print(collections.counts(items))
    print(collections.flatten([[1, 2], [], [3]]))
}
