fn main() {
    const queue = ["asha", "ravi", "meera", "john", "lin"]
    print(queue[0])          // the first
    print(queue[#1])         // the last
    print(queue[:2])         // the first two
    print(queue[2:])         // all but the first two
    print(queue[1:3])        // from 1 up to, not including, 3
    print(queue[#2:])        // the last two
    print(queue[:#1])        // all but the last
    print(queue[::2])        // every second one
    print(queue[::-1])       // turned around
}
