type Order {
    item: String
    qty: Int
}

type ShopError = OutOfStock(item: String) | TooMany(qty: Int)

fn place(o: Order) -> String ! ShopError {
    if o.qty > 10 {
        fail ShopError.TooMany(qty: o.qty)
    }
    if o.item == "kite" {
        fail ShopError.OutOfStock(item: o.item)
    }
    "{o.qty} x {o.item}"
}

fn handle<P, R, E>(input: P, handler: fn(P) -> R ! E) -> R ! E {
    try handler(input)
}

fn main() {
    for o in [Order(item: "pen", qty: 2), Order(item: "kite", qty: 1), Order(item: "cup", qty: 50)] {
        const said = handle(o, place) catch e => match e {
            ShopError.OutOfStock(item) => "no {item} left",
            ShopError.TooMany(qty) => "{qty} is too many",
        }
        print(said)
    }
}
