use std.time

fn report(name: String, ms: Int) -> String {
    time.sleep_ms(ms)
    print("{name} done")
    name
}

fn main() ! Error {
    const slow = spawn report("slow", 200)
    const fast = spawn report("fast", 100)
    print("both started")
    print("{try slow.wait()} and {try fast.wait()} are back")
}
