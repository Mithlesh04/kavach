fn save(report: String) -> Int ! Error {
    fail Error(`no room for {report}`)
}

fn greet(name: String) {
    print(`hello, {name}`)
}

fn main() {
    spawn greet("ann")              // nobody waits for it
    spawn save("weekly report")     // nor for this one, and its error is printed
    print("main goes on")
}
