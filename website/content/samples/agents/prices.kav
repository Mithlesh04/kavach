use std.ai

fn main() {
    if let p = Anthropic().price("claude-opus-5-5") {
        print(`{p.input} in, {p.output} out, {p.cached_input ?? p.input} cached, per {p.per} tokens`)
        print(`as of {p.as_of.year}-{p.as_of.month}-{p.as_of.day}, from {p.from}`)
    }
    print(Anthropic().price("claude-opus-4-1"))
}
