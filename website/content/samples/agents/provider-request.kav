use std.json

fn main() {
    // Only to look at the request Anthropic() writes: nothing is sent.
    const m = Model(name: "claude-sonnet-5-5", effort: Effort.High, max_tokens: 300,
        instructions: "Be brief.", stop: ["END"])
    const schema = json.parse(`\{"type":"object"}`) catch _e => Json.Null
    const p = Anthropic()
    const r = p.request(AskCall(model: m, prompt: "Refund?", schema: schema, strict: true))
    print(r.url)
    print(r.headers)
    print(r.body)
    print(p.auth(m))
    print(p.key_variable())
}
