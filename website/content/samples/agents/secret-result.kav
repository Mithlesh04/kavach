type Config {
    shop: String
    secret api_key: String
}

fn api_key(config: Config) -> secret String {
    config.api_key
}

fn main() {
    const config = Config(shop: "pens", api_key: "sk_test_4f9a2c")
    const key = api_key(config)
    print("{config.shop}: a key of {reveal(key).len()} characters")
}
