type Order {
    id: Int
    secret card: String
}

fn main() {
    const order = Order(id: 7, card: "4242424242421881")
    const has_card = if order.card == "" { "no card" } else { "a card" }
    print(`order {order.id} has {has_card}`)
    const upper = order.card.upper()
    print(`checked: {reveal(upper == order.card)}`)
}
