type PayError = Declined | Denied(reason: String)

type Receipt {
    id: String
}

capability Payments {
    fn refund(order: Int, amount: Int) -> Receipt ! PayError
}

type Bank: Payments {
    fn refund(self, order: Int, amount: Int) -> Receipt ! PayError {
        print("the bank moves real money here")
        Receipt(id: "r{order}")
    }
}

agent Refunder {
    can Payments.refund, Console

    limit Payments.refund {
        amount <= 500
    }

    on refund(order: Int, amount: Int) ! PayError {
        const receipt = try Payments.refund(order, amount)
        print("order {order}: receipt {receipt.id}")
    }
}

fn main() {
    const bot = Refunder.start(Payments: Bank())
    bot.refund(1, 400) catch e => print("refused: {e}")
    bot.refund(2, 900) catch e => print("refused: {e}")
}
