// Rule: A lambda keeps a copy of the outside values it uses, taken when it is created.
// Spec: 3.3
// expect output: false
// expect output: 15

fn make_adder(k: Int) -> fn(Int) -> Int {
    x => x + k
}

fn main() {
    let limit = 10
    const over = n => n > limit
    limit = 0
    print(over(5))
    const add5 = make_adder(5)
    print(add5(10))
}
