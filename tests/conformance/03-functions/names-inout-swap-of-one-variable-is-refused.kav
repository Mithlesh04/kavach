// Rule: One variable can't be given for two `inout` parameters of one call: that would be two names for one value.
// Spec: 3.9
// expect compile error

fn swap(inout a: Int, inout b: Int) {
    const t = a
    a = b
    b = t
}

fn main() {
    let x = 1
    swap(x, x)                      // error: x is given twice, as inout
    print(x)
}
