// Rule: A lambda that changes an outside variable, with `+=` or a changing method such as `push`, changes its own copy, made for each call; the compiler warns.
// Spec: 3.3
// expect warning
// expect output: [1, 2, 3]
// expect output: 0
// expect output: [2, 2, 2]
// expect output: [0]

fn main() {
    let total = 0
    const sums = [1, 2, 3].map(x => {
        total += x       // warning: `total` is a copy inside this lambda
        total
    })
    print(sums)
    print(total)
    let log = [0]
    const lens = [1, 2, 3].map(x => {
        log.push(x)      // warning: `log` is a copy inside this lambda
        log.len()
    })
    print(lens)
    print(log)
}
