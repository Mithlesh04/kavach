// Rule: A recursive function can pass large values down and back up, and each call's value stays its own.
// Spec: 3.8, 6.1
// expect output: 100000 4999950000 1000
// expect output: 1000 999
// expect output: 100000 0

fn walk(xs: [Int], depth: Int, seen: Int) -> (Int, Int, Int) {
    if depth == 0 {
        return (xs.len(), xs.sum(x => x), seen)
    }
    walk(xs, depth - 1, seen + 1)
}

fn grow(xs: [Int], n: Int) -> [Int] {
    if n == 0 {
        return xs
    }
    let mine = xs
    mine.push(n - 1)
    grow(mine, n - 1)
}

fn changes_its_copy(xs: [Int], depth: Int) -> Int {
    if depth == 0 {
        return xs[0]
    }
    let mine = xs
    mine[0] = depth
    const _ = changes_its_copy(mine, depth - 1)
    xs[0]
}

fn main() {
    let big: [Int] = []
    for i in 0..100_000 {
        big.push(i)
    }
    const (len, sum, seen) = walk(big, 1000, 0)
    print(`{len} {sum} {seen}`)
    const built = grow([], 1000)
    print(`{built.len()} {built[0]}`)
    print(`{big.len()} {changes_its_copy(big, 500)}`)
}
