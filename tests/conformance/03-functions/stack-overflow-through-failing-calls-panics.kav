// Rule: Running out of stack through calls to a function that can fail is the same panic, at the line of the call that went too deep.
// Spec: 3.8, 5.6
// expect panic: stack-overflow-through-failing-calls-panics.kav:12
// expect exit: 101

type Stop = Never

fn forever(n: Int) -> Int ! Stop {
    if n < 0 {
        fail Stop.Never
    }
    try forever(n + 1)
}

fn main() {
    const _ = forever(0) catch _ => 0
}
