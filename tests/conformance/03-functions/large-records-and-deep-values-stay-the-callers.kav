// Rule: A record holding a 10,000-entry map and a deeply nested value arrive whole, and a change to the callee's copy never reaches the caller's value.
// Spec: 3.1, 6.1
// expect output: 10000 49995000 9999
// expect output: 10000 -5 none
// expect output: 10000 49995000 none
// expect output: 200 7
// expect output: 201 8
// expect output: 200 7

type Stock {
    name: String
    counts: [String: Int]
}

type Node = Leaf(value: Int) | Branch(inner: Node, depth: Int)

fn total(s: Stock) -> String {
    "{s.counts.len()} {s.counts.values().sum(x => x)} {s.counts.get("k9999") ?? -1}"
}

fn restocked(s: Stock) -> Stock {
    let mine = s
    mine.counts["new"] = -5
    mine.counts.remove("k9999")
    mine
}

fn deepest(n: Node) -> (Int, Int) {
    match n {
        Node.Leaf(value) => (0, value),
        Node.Branch(inner, depth: _) => {
            const (d, v) = deepest(inner)
            (d + 1, v)
        },
    }
}

fn relabel(n: Node, leaf: Int) -> Node {
    match n {
        Node.Leaf(value: _) => Node.Leaf(value: leaf),
        Node.Branch(inner, depth) => Node.Branch(inner: relabel(inner, leaf), depth: depth),
    }
}

fn wrap(levels: Int, leaf: Int) -> Node {
    if levels == 0 {
        return Node.Leaf(value: leaf)
    }
    Node.Branch(inner: wrap(levels - 1, leaf), depth: levels)
}

fn main() {
    let s = Stock(name: "shop", counts: [:])
    for i in 0..10_000 {
        s.counts["k{i}"] = i
    }
    print(total(s))
    const r = restocked(s)
    print("{r.counts.len()} {r.counts["new"] ?? 0} {r.counts.get("k9999")}")
    print("{s.counts.len()} {s.counts.values().sum(x => x)} {s.counts.get("new")}")
    const deep = wrap(200, 7)
    const (d, v) = deepest(deep)
    print("{d} {v}")
    const deeper = Node.Branch(inner: relabel(deep, 8), depth: 201)
    const (d2, v2) = deepest(deeper)
    print("{d2} {v2}")
    const (d3, v3) = deepest(deep)
    print("{d3} {v3}")
}
