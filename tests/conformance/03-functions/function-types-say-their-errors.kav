// Rule: a function type can say what its functions fail with, `fn(P) -> R ! E`; the error may be a type parameter, so generic code keeps it, and a function that can't fail fits too.
// Spec: 3.4
// expect output: made 2 pen
// expect output: out of pen
// expect output: made 1 cup

type Order {
    item: String
    qty: Int
}

type ApiError = OutOfStock(item: String) | Bad(reason: String)

fn create(o: Order) -> String ! ApiError {
    if o.qty > 5 {
        fail ApiError.OutOfStock(item: o.item)
    }
    "made {o.qty} {o.item}"
}

fn always(o: Order) -> String {
    "made {o.qty} {o.item}"
}

fn route<P, R, E>(input: P, handler: fn(P) -> R ! E) -> R ! E {
    try handler(input)
}

fn main() {
    print(route(Order(item: "pen", qty: 2), create) catch _ => "failed")
    const stocked = route(Order(item: "pen", qty: 9), create) catch e => match e {
        ApiError.OutOfStock(item) => "out of {item}",
        ApiError.Bad(reason) => "bad: {reason}",
    }
    print(stocked)
    print(route(Order(item: "cup", qty: 1), always))
}
