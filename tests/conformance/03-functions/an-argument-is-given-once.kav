// Rule: Each parameter gets one argument: a parameter given by position and again by name is an error.
// Spec: 3.2
// expect compile error

fn order(name: String, count: Int = 0) -> String {
    "{name} {count}"
}

fn main() {
    print(order("a"))
    print(order("a", 3, count: 4))    // error: `count` is given twice
}
