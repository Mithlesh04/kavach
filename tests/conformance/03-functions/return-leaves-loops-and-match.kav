// Rule: `return` exits the whole function from anywhere in it: inside a `for`, a `while`, nested loops, or a `match` arm; a function without `->` can `return` with no value.
// Spec: 3.1
// expect output: 3 -1
// expect output: 16 none
// expect output: (2, 1) (-1, -1)
// expect output: small big other
// expect output: before

fn index_of(xs: [Int], want: Int) -> Int {
    for i in 0..xs.len() {
        if xs[i] == want {
            return i
        }
    }
    -1
}

fn first_square_over(n: Int) -> Int? {
    let i = 1
    while i < 100 {
        if i * i > n {
            return i * i
        }
        i += 1
    }
    none
}

fn find(grid: [[Int]], want: Int) -> (Int, Int) {
    for r in 0..grid.len() {
        for c in 0..grid[r].len() {
            if grid[r][c] == want {
                return (r, c)
            }
        }
    }
    (-1, -1)
}

fn size(n: Int) -> String {
    match n {
        0 => return "small",
        1 => {
            if n > 0 {
                return "big"
            }
            "never"
        },
        _ => "other",
    }
}

fn say(stop: Bool) {
    print("before")
    if stop {
        return
    }
    print("after")
}

fn main() {
    print(`{index_of([5, 6, 7, 8], 8)} {index_of([5], 9)}`)
    print(`{first_square_over(10) ?? 0} {first_square_over(100_000)}`)
    print(`{find([[1, 2], [3, 4], [5, 6]], 6)} {find([[1]], 9)}`)
    print(`{size(0)} {size(1)} {size(2)}`)
    say(true)
}
