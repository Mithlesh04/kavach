// Rule: Each parameter gets one argument: naming the same parameter twice is an error.
// Spec: 3.2
// expect compile error

fn order(name: String, count: Int = 0) -> String {
    "{name} {count}"
}

fn main() {
    print(order("a"))
    print(order("a", count: 3, count: 4))    // error: `count` is given twice
}
