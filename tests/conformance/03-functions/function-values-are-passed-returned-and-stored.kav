// Rule: Function values can be returned, passed on, kept in lists, maps and records, and called through a field; each keeps the values it was made with.
// Spec: 3.4, 3.3
// expect output: 7 13 23
// expect output: 10 -3 12
// expect output: 1.5 -1.5
// expect output: 15 115
// expect output: 21

type Pipeline {
    name: String
    step: fn(Int) -> Int
}

type Holder {
    inner: Pipeline
}

fn adder(n: Int) -> fn(Int) -> Int {
    x => x + n
}

fn twice(f: fn(Int) -> Int) -> fn(Int) -> Int {
    x => f(f(x))
}

fn mix(a: Int8, b: Float32, c: String) -> Float {
    Float(a) + Float(b) * Float(c.len())
}

fn run_all(steps: [fn(Int) -> Int], start: Int) -> Int {
    let at = start
    for s in steps {
        at = s(at)
    }
    at
}

fn main() {
    const add3 = adder(3)
    print("{add3(4)} {adder(10)(3)} {twice(adder(10))(3)}")
    const ops: {String: fn(Int, Int) -> Int} = {"add": (a, b) => a + b, "sub": (a, b) => a - b}
    print("{(ops["add"] ?? ((a, b) => 0))(4, 6)} {(ops["sub"] ?? ((a, b) => 0))(1, 4)} {run_all([adder(1), x => x * 3, adder(-3)], 4)}")
    const m: fn(Int8, Float32, String) -> Float = mix
    print("{m(-1, 1.25, "ab")} {m(1, -1.25, "ab")}")
    const p = Pipeline(name: "p", step: adder(5))
    const h = Holder(inner: p with { step: twice(p.step) })
    print("{h.inner.step(5)} {Holder(inner: p).inner.step(110)}")
    const steps = [adder(1), adder(2)]
    print(steps[1](steps[0](18)))
}
