    t += 1
    t += 1
    t += 1
    t += 1

    t += 1
    t += 1
    t += 1
    t += 1
    // a comment line counts too
    t += 1
    t += 1
    t += 1
    t += 1

    t += 1
    t += 1
    t += 1
    t += 1
    // a comment line counts too
    t += 1
    t += 1
    t += 1
    t += 1

    t += 1
    t += 1
    t += 1
    t += 1
    // a comment line counts too
    t += 1
    t += 1
    t += 1
    t += 1

    t += 1
    t += 1
    t += 1
    t += 1
    // a comment line counts too
    t += 1
    t += 1
    t += 1
    t += 1

    t += 1
    t += 1
    t += 1
    t += 1
    // a comment line counts too
    t += 1
    t += 1
    t += 1
    t += 1

    t += 1
    t += 1
    t += 1
    t += 1
    // a comment line counts too
    t += 1
    t += 1
    t += 1
    t += 1

    t += 1
    t += 1
    t += 1
    t += 1
    // a comment line counts too
    t += 1
    t += 1
    t += 1
    t += 1

    t += 1
    t += 1
    t += 1
    t += 1
    // a comment line counts too
    t += 1
    t += 1
    t += 1
    t += 1

    t += 1
    t += 1
    t += 1
    t
}

fn main() {
    print(fits() + too_long())
}
