// Rule: Lambdas are written `x => …`, `(a, b) => …` or with a block body.
// Spec: 3.3
// expect output: 8
// expect output: 7
// expect output: 5

fn main() {
    const double = x => x * 2
    const add = (a, b) => a + b
    const length = text => {
        const trimmed = text
        trimmed.len()
    }
    print(double(4))
    print(add(3, 4))
    print(length("hello"))
}
