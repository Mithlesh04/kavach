// Rule: A task's error that no `.wait()` read is printed to standard error, with where the task was spawned, and the program goes on.
// Spec: 9.1
// expect output: main goes on
// expect stderr: error in a task nobody waited for: disk full (spawned at errors-nobody-reads-are-printed.kav:15)

use std.time

fn risky() -> Int ! Error {
    fail Error("disk full")
}

fn main() uses Console, Clock {
    // `_` says nobody waits for it on purpose: no warning, and the error
    // is still printed.
    const _late = spawn risky()
    time.sleep(10.ms)       // the task runs and fails meanwhile
    print("main goes on")
}
