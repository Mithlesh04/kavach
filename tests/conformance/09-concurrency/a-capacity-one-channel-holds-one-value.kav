// Rule: a channel of capacity 1 holds one value: a second `put` waits until it is taken, so a producer and a taker alternate.
// Spec: 9.4, 9.7
// expect output: true false
// expect output: put 1
// expect output: took 1
// expect output: put 2
// expect output: took 2
// expect output: put 3
// expect output: took 3

fn main() {
    const (probe, probe_in) = Channel<Int>(capacity: 1)
    print("{probe.try_put(0)} {probe.try_put(0)}")
    const _ = probe_in.take()
    const (send, receive) = Channel<Int>(capacity: 1)
    const _producer = spawn {
        for i in 1..=3 {
            send.put(i)
            print("put {i}")
        }
        send.close()
    }
    for n in receive {
        print("took {n}")
    }
}
