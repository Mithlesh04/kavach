// Rule: A spawned call's arguments, and the value a method is called on, are worked out at the spawn, in the order they are written; the task then makes the call with those values. A spawned block runs whole in the task.
// Spec: 9.1
// expect output: working out start
// expect output: working out end
// expect output: making a bag
// expect output: working out extra
// expect output: spawned
// expect output: the task sums [2, 3]
// expect output: the bag's task runs
// expect output: 5
// expect output: 13
// expect output: working out in the task
// expect output: the task sums [1, 2]
// expect output: 3

type Bag {
    items: [Int]

    fn total_with(self, extra: Int) -> Int {
        print("the bag's task runs")
        self.items.sum(n => n) + extra
    }
}

fn noted(name: String, n: Int) -> Int {
    print(`working out {name}`)
    n
}

fn bag() -> Bag {
    print("making a bag")
    Bag(items: [1, 2])
}

fn total(xs: [Int]) -> Int {
    print(`the task sums {xs}`)
    xs.sum(x => x)
}

fn main() {
    const xs = [1, 2, 3, 4]
    const t = spawn total(xs[noted("start", 1):noted("end", 3)])
    const u = spawn bag().total_with(noted("extra", 10))
    print("spawned")
    print(t.wait() catch 0)
    print(u.wait() catch 0)
    const v = spawn { total(xs[noted("in the task", 0):2]) }
    print(v.wait() catch 0)
}
