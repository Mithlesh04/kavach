// Rule: A panic while a spawned call's arguments are worked out happens at the spawn, in the spawning code, and no task starts.
// Spec: 9.1
// expect output: before
// expect panic
// expect stderr: panic: index 5 is out of range: the list has 3 items
// expect stderr:   at a-panic-in-a-spawned-argument-happens-at-the-spawn.kav:16

fn first(n: Int) -> Int {
    print("the task runs")
    n
}

fn start(xs: [Int]) {
    const n = xs.len()
    print("before")
    const t = spawn first(xs[n + 2])
    print("after")
    print(t.wait() catch 0)
}

fn main() {
    start([1, 2, 3])
}
