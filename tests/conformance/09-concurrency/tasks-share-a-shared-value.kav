// Rule: tasks that hold a `Shared` value change that one value, in the order of their turns.
// Spec: 9.5, 6.2
// expect output: [10, 20, 30, 40]
// expect output: 10

fn main() {
    const visits = Shared(0)
    const pages = [1, 2, 3, 4].parallel_map(n => {
        visits.update(v => v + n)
        n * 10
    })
    print(pages)
    print(visits.get())
}
