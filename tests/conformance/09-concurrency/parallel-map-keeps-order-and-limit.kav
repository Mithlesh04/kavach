// Rule: `parallel_map` runs each item in a task of its own, at most `max` at a time (waiting for task `i - max` before starting task `i`), and gives the results in order.
// Spec: 9.3, 9.7
// expect output: start 1
// expect output: start 2
// expect output: end 1
// expect output: start 3
// expect output: end 2
// expect output: start 4
// expect output: end 3
// expect output: start 5
// expect output: end 4
// expect output: end 5
// expect output: [1, 4, 9, 16, 25]
// expect output: throttled: true
// expect output: ["#7", "#8"]

use std.time

fn slow_square(n: Int) -> Int {
    print("start {n}")
    time.sleep_ms(n * 100)
    print("end {n}")
    n * n
}

fn main() {
    const start = time.monotonic_ms()
    const squares = [1, 2, 3, 4, 5].parallel_map(n => slow_square(n), max: 2)
    print(squares)
    // With at most 2 at a time the longest chain is 1 → 3 → 5:
    // 100 + 300 + 500 ms. All five at once would finish in about 500 ms,
    // so the elapsed time proves the limit; load only raises it. Events
    // are 100 ms apart, so a busy machine doesn't swap printed lines.
    print("throttled: {time.monotonic_ms() - start >= 850}")
    print([7, 8].parallel_map(n => "#{n}"))
}
