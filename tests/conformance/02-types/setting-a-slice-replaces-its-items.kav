// Rule: `xs[a:b:step] = ys` replaces the items of a `let` list that the slice names with the items of `ys`, in order; `#k` sets an item from the end.
// Spec: 2.19
// expect output: [1, 7, 8, 4, 5]
// expect output: [1, 7, 8, 0, 0]
// expect output: [9, 7, 9, 0, 9]
// expect output: [9, 7, 9, 0, 6]

fn main() {
    let xs = [1, 2, 3, 4, 5]
    xs[1:3] = [7, 8]
    print(xs)
    xs[#2:] = [0, 0]
    print(xs)
    xs[::2] = [9, 9, 9]
    print(xs)
    xs[#1] = 6
    print(xs)
}
