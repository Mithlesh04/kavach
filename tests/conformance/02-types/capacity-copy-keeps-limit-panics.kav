// Rule: A copy of a collection made by `capacity(n)` keeps the limit, so adding past it panics.
// Spec: 2.2
// expect output: [1, 2]
// expect output: [1]
// expect panic: the list is full (max 2)

fn main() {
    let n = 2
    let a: [Int32] = List.capacity(n, [1])
    let b = a
    b.push(2)
    print(b)
    print(a)
    b.push(3)
}
