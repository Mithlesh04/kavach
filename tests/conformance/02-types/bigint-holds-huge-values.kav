// Rule: A `BigInt` holds a whole number of any size, negative too, and keeps every digit through arithmetic and comparison.
// Spec: 2.1
// expect output: 1606938044258990275541962092341162602522202993782792835301376
// expect output: 2 0 true
// expect output: -9223372036854775809 18446744073709551615
// expect output: -1606938044258990275541962092341162602522202993782792835301375

fn main() {
    const two: BigInt = 2
    const huge = two ** 200
    print(huge)
    const half = two ** 199
    print(`{huge / half} {huge % half} {huge > half * BigInt(1)}`)
    print(`{-9223372036854775809} {2 ** 64 - 1}`)
    print(1 - huge)
}
