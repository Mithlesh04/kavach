// Rule: A slice is a new value: changing it never changes the list it came from, and changing the list never changes it.
// Spec: 2.19
// expect output: [9, 2] [1, 2, 3]
// expect output: [9, 2] [1, 8, 3]

fn main() {
    let xs = [1, 2, 3]
    let part = xs[:2]
    part[0] = 9
    print(`{part} {xs}`)
    xs[1] = 8
    print(`{part} {xs}`)
}
