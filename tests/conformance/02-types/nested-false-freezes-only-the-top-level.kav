// Rule: `freeze(nested: false)` freezes only the top level: the values inside its items may still change in place.
// Spec: 2.20
// expect output: [[0, 5], [0, 0]]
// expect output: Bag(items: [1, 2])

type Bag {
    items: [Int]
}

fn main() {
    let grid = [[0, 0], [0, 0]].freeze(nested: false)
    grid[0][1] = 5
    print(grid)
    let bag = Bag(items: [1]).freeze(nested: false)
    bag.items.push(2)
    print(bag)
}
