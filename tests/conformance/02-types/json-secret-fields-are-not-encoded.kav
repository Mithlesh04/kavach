// Rule: A record with a `secret` field can't be encoded as JSON.
// Spec: 2.12, 2.11
// expect compile error

use std.json

type Card {
    holder: String
    secret number: String
}

fn main() {
    const card = Card(holder: "Asha", number: "4242")
    print(json.of(card))       // error: a secret field must not leave as JSON
}
