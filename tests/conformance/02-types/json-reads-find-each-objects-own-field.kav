// Rule: `j["key"]` gives each object's own field, wherever the key is in the object and whatever made it, or `Null` when it has none.
// Spec: 2.12
// expect output: 106
// expect output: 30
// expect output: 106
// expect output: 9
// expect output: 30

use std.json

/// Each object's `qty` in a text of its own, or 100 when it has none.
fn parsed_total(text: String) -> Int ! JsonError {
    let sum = 0
    for o in (try json.parse(text)).list() ?? [] {
        sum += o["qty"].int() ?? 100
    }
    sum
}

fn main() ! Error {
    // The same key at another place in each object, and missing from one.
    const a = try json.parse("[\{\"qty\": 1, \"sku\": \"a\"}, \{\"sku\": \"b\", \"qty\": 2}, \{\"sku\": \"c\"}, \{\"note\": \"x\", \"sku\": \"d\", \"qty\": 3}]")
    // Another text: its keys are its own.
    const b = try json.parse("[\{\"qty\": 10}, \{\"qty\": 10}, \{\"note\": \"y\", \"qty\": 10}]")
    // Objects the program builds.
    const c: Json = [["qty": 4], ["sku": "e", "qty": 5]]
    for doc in [a, b, a, c] {
        let sum = 0
        for o in doc.list() ?? [] {
            sum += o["qty"].int() ?? 100
        }
        print(sum)
    }
    // In a task on a thread of its own.
    const task = spawn thread parsed_total("[\{\"qty\": 10}, \{\"qty\": 20}]")
    print(try task.wait())
}
