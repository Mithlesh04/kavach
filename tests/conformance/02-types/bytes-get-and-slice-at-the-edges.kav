// Rule: `b.get(i)` gives `none` outside the bytes, a negative `i` too; `b.slice` clamps positions past the end; empty `Bytes` print as `Bytes()`.
// Spec: 2.13
// expect output: 104 111 none none
// expect output: Bytes(656c6c6f) Bytes() Bytes()
// expect output: 0 true

fn main() {
    const b = "hello".bytes()
    print("{b.get(0)} {b.get(4)} {b.get(5)} {b.get(-1)}")
    print("{b.slice(1, 99)} {b.slice(7, 9)} {Bytes([])}")
    const none_left = b.slice(5, 5)
    print("{none_left.len()} {none_left == Bytes([])}")
}
