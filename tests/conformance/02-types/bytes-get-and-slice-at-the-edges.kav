// Rule: `b.get(i)` gives `none` outside the bytes, a negative `i` too; a slice `b[start:end]` clamps positions past the end; empty `Bytes` print as `Bytes()`.
// Spec: 2.13
// expect output: 104 111 none none
// expect output: Bytes(656c6c6f) Bytes() Bytes()
// expect output: 0 true

fn main() {
    const b = "hello".bytes()
    print(`{b.get(0)} {b.get(4)} {b.get(5)} {b.get(-1)}`)
    print(`{b[1:99]} {b[7:9]} {Bytes([])}`)
    const none_left = b[5:5]
    print(`{none_left.len()} {none_left == Bytes([])}`)
}
