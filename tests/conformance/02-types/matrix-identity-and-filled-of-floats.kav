// Rule: `matrix.identity(n, one)` has `one` on the diagonal and zeros of its type elsewhere; `matrix.filled` repeats its value.
// Spec: 2.17
// expect output: [[1.0, 0.0], [0.0, 1.0]]
// expect output: 2 3 [0.5, 0.5, 0.5, 0.5, 0.5, 0.5]
// expect output: [[1.0, 2.0], [3.0, 4.0]]

use std.matrix

fn main() {
    const i = matrix.identity(2, 1.0)
    print(i.to_rows())
    const h = matrix.filled(2, 3, 0.5)
    print("{h.rows} {h.cols} {h.items}")
    const a = matrix.of([[1.0, 2.0], [3.0, 4.0]])
    print((a @ i).to_rows())
}
