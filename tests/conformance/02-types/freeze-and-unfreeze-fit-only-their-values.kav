// Rule: Freezing a value that is already frozen, and unfreezing one that isn't, are compile errors; `nested:` is written `true` or `false`.
// Spec: 2.20
// expect compile error

fn main() {
    const deep = true
    const xs = [1, 2].freeze()
    const twice = xs.freeze()               // error: already frozen
    const plain = [3].unfreeze()            // error: not frozen
    const ys = [4].freeze(nested: deep)     // error: `nested:` is written `true` or `false`
    print(`{twice} {plain} {ys}`)
}
