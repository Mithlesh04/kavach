// Rule: A secret value must not flow into `debug`.
// Spec: 2.11, 8.7
// expect compile error

type Customer {
    name: String
    secret card_number: String
}

fn main() {
    const c = Customer(name: "Asha", card_number: "4242")
    debug(c.name)
    debug(c.card_number)      // error: `card_number` is secret
}
