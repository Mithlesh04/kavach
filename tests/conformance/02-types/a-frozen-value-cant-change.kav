// Rule: Every change to a frozen value is a compile error that names `unfreeze()`: assigning a field or an item, a changing method, `op=`, and passing it to `inout`.
// Spec: 2.20
// expect compile error

type Order {
    id: Int
    lines: [String]
}

fn bump(inout n: Int) {
    n += 1
}

fn main() {
    let order = Order(id: 7, lines: ["tea"]).freeze()
    order.id = 8                    // error: `order` is frozen
    order.lines.push("cake")        // error: `order` is frozen
    order.id += 1                   // error: `order` is frozen
    bump(order.id)                  // error: `order` is frozen
    let xs = [1, 2, 3].freeze()
    xs[0] = 5                       // error: `xs` is frozen
    xs.push(4)                      // error: `xs` is frozen
    xs += [4]                       // error: `xs` is frozen
    let ages = {"asha": 31}.freeze()
    ages["ravi"] = 27               // error: `ages` is frozen
    print(order.id + xs[0] + (ages["asha"] ?? 0))
}
