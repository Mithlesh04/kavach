// Rule: A method's `where` bound is `Number` or `Floating`; an interface there is an error.
// Spec: 2.9
// expect compile error

interface Describe {
    fn describe(self) -> String
}

type Pair<T> {
    a: T
    b: T

    fn show(self) -> String where T: Describe {      // error: a `where` bound is `Number` or `Floating`
        "a pair"
    }
}

fn main() {
    print(Pair(a: 1, b: 2).a)
}
