// Rule: A `secret` field is written as `"<secret>"`, as `print` shows it, so a secret never reaches JSON.
// Spec: 2.12, 2.11
// expect output: {"holder":"Asha","number":"<secret>"}
// expect output: Card(holder: "Asha", number: <secret>)

use std.json

type Card {
    holder: String
    secret number: String
}

fn main() {
    const card = Card(holder: "Asha", number: "4242")
    print(json.of(card))
    print(card)
}
