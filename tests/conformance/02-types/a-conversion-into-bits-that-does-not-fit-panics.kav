// Rule: `UInt<bits: 12>(x)` converts any number, cutting a float to its whole part, and panics when it doesn't fit.
// Spec: 2.1, 5.6
// expect output: 4095 12
// expect panic: 5000 doesn't fit in UInt<bits: 12>

fn addr(n: Int) -> UInt<bits: 12> {
    UInt<bits: 12>(n)
}

fn main() {
    let f = 12.9
    print(`{addr(4095)} {UInt<bits: 12>(f)}`)
    print(addr(5000))
}
