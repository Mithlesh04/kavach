// Rule: Outside a call to a function that only reads it, a frozen value doesn't go where a plain type is written; where the type is worked out, it stays frozen.
// Spec: 2.20
// expect compile error

fn main() {
    const xs = [1, 2].freeze()
    const plain: [Int] = xs                   // error: `xs` is a `Frozen<[Int]>`
    const kept: Frozen<[Int]> = xs
    const copy = xs
    print(`{plain} {kept} {copy}`)
}
