// Rule: A secret can't leak into JSON by accident: `json.stringify` of a list of records with a `secret` field writes each as `"<secret>"`, through generic code too.
// Spec: 2.12, 2.11
// expect output: [{"holder":"Asha","number":"<secret>"}]
// expect output: {"Down":{"card":{"holder":"Ravi","number":"<secret>"}}}

use std.json

type Card {
    holder: String
    secret number: String
}

type Failure = Down(card: Card) | Gone

fn respond<E>(e: E) -> String {
    json.stringify(e)
}

fn main() {
    const cards = [Card(holder: "Asha", number: "4242")]
    print(json.stringify(cards))
    print(respond(Failure.Down(card: Card(holder: "Ravi", number: "1"))))
}
