// Rule: A secret value must not flow into an error message: `panic(secret)` is an error.
// Spec: 2.11, 8.7
// expect compile error

type Customer {
    name: String
    secret card_number: String
}

fn main() {
    const c = Customer(name: "Asha", card_number: "4242")
    if c.name == "" {
        panic(c.name)
    }
    panic(c.card_number)      // error: `card_number` is secret
}
