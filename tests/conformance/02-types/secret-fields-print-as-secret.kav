// Rule: Printing a record shows a secret field as `<secret>`, never its value.
// Spec: 2.11, 1.11
// expect output: Customer(name: "Asha", card_number: <secret>)
// expect output: [Customer(name: "Ravi", card_number: <secret>)]

type Customer {
    name: String
    secret card_number: String
}

fn main() {
    const c = Customer(name: "Asha", card_number: "4242")
    print(c)
    print([Customer(name: "Ravi", card_number: "1111")])
}
