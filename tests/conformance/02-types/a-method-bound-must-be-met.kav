// Rule: Calling a method whose `where` bound the type's parameter doesn't meet is a compile error.
// Spec: 2.9
// expect compile error

type Pair<T: Number> {
    a: T
    b: T

    fn mean(self) -> T where T: Floating { (self.a + self.b) / 2.0 }
}

fn main() {
    const counts: Pair<Int> = Pair(a: 1, b: 2)
    print(counts.mean())     // error: `mean` needs `T: Floating`, and `T` is `Int` here
}
