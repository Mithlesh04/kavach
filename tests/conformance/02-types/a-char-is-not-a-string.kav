// Rule: A `Char` is one character, not text: it can't be compared with a `String` or joined to one with `+`.
// Spec: 2.1, 1.8
// expect compile error

fn main() {
    const c = 'a'
    print(String(c) == "a")        // fine: converted
    print(c == "a")                // error: a Char is not a String
}
