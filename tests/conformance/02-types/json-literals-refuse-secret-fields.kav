// Rule: A value inside a `Json` literal is encoded, so a record with a `secret` field there is a compile error.
// Spec: 2.12, 2.11
// expect compile error

type Card {
    holder: String
    secret number: String
}

fn main() {
    const card = Card(holder: "Asha", number: "4242")
    const doc: Json = ["paid": true, "card": card]       // error: a secret field must not leave as JSON
    print(doc)
}
