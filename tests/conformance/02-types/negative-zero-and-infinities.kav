// Rule: floats follow IEEE 754: zero has a sign that prints, dividing by a signed zero gives an infinity of that sign, and `Float32` overflows to infinity without a panic.
// Spec: 2.1, 1.11
// expect output: -0.0 0.0
// expect output: true true
// expect output: true true

fn main() {
    let zero = 0.0
    const minus = zero * -1.0
    print("{minus} {minus * -1.0}")
    print("{1.0 / minus < -1.7976931348623157e308} {1.0 / zero > 1.7976931348623157e308}")
    let big: Float32 = 3.0e38
    const over = big * 10.0
    print("{over > big} {-over < -big}")
}
