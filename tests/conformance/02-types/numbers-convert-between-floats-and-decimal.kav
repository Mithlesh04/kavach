// Rule: Any number converts to any other with `T(value)`: whole numbers to floats and `Decimal`, a `Decimal` to a float, a float to a `Decimal`.
// Spec: 2.1
// expect output: 7.0 7.0 7
// expect output: 499.0 2.5
// expect output: 0.5 0.75
// expect output: true

fn main() {
    const n: Int = 7
    print(`{Float(n)} {Float32(n)} {Decimal(n)}`)
    const price: Decimal = 499.00
    let half = 2.5
    print(`{Float(price)} {Decimal(half)}`)
    const q: Float32 = 0.5
    const r: Decimal = 0.75
    print(`{Float(q)} {Float32(r)}`)
    print(Decimal(Float(price)) == price)
}
