// Rule: A secret value must not flow into print, whichever of its values it is.
// Spec: 2.11, 8.7
// expect compile error

type Customer {
    name: String
    secret card_number: String
}

fn main() {
    const c = Customer(name: "Asha", card_number: "4242")
    print("card:", c.card_number)    // error: `card_number` is secret
}
