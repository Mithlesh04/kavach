// Rule: A function's number parameter has one value at a call: arguments that give it two are a compile error.
// Spec: 2.9
// expect compile error

fn dot<n: Int>(a: [Float]<len: n>, b: [Float]<len: n>) -> Float {
    a[0] * b[0]
}

fn main() {
    const u: [Float]<len: 3> = [1.0, 2.0, 3.0]
    print(dot(u, [4.0, 5.0]))     // error: `n` is 3 for `a` and 2 for `b`
}
