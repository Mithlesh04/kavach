// Rule: for whole numbers, `a.product(b, fast: true)` gives the same result as `a @ b`.
// Spec: 2.17
// expect output: [[58, 64], [139, 154]]
// expect output: true

use std.matrix

fn main() {
    const a = matrix.of([[1, 2, 3], [4, 5, 6]])
    const b = matrix.of([[7, 8], [9, 10], [11, 12]])
    const fast = a.product(b, fast: true)
    print(fast.to_rows())
    print(fast.items == (a @ b).items)
}
