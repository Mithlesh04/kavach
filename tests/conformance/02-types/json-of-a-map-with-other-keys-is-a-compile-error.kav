// Rule: Only maps with `String` keys can be encoded as JSON: a map with other keys is a compile error, also inside a record.
// Spec: 2.12
// expect compile error

use std.json

type Scores {
    by_id: {Int: Float}
}

fn main() {
    const s = Scores(by_id: {1: 2.5})
    print(json.stringify(s))       // error: a map with `Int` keys has no JSON form
}
