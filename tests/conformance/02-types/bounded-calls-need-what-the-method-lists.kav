// Rule: Calling a method through a generic bound `T: I` needs what the interface's method lists.
// Spec: 2.8
// expect compile error

interface Report {
    fn write(self) -> Bool uses Fs
}

pub fn save<T: Report>(r: T) -> Bool {
    r.write()                   // error: `write` uses Fs, which `save` doesn't list
}
