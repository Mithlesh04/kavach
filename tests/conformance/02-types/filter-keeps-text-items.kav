// Rule: `filter` over a list of text keeps the items its test holds for, as they are, short or long, ASCII or not, and leaves the list as it was.
// Spec: 2.2
// expect output: ["$var", "wire", "1", "a much longer word than fifteen", "wörld"]
// expect output: 8 5
// expect output: ["", "a much longer word than fifteen"]

fn main() {
    const line = "$var  wire 1  a much longer word than fifteen wörld "
    const parts = line.replace("a much longer word than fifteen", "LONG").split(" ")
    let ws: [String] = []
    for p in parts {
        ws.push(if p == "LONG" { "a much longer word than fifteen" } else { p })
    }
    const kept = ws.filter(w => not w.is_empty())
    print(kept)
    print(`{ws.len()} {kept.len()}`)
    print(ws.filter(w => w.is_empty() or w.len() > 15)[1:3])
}
