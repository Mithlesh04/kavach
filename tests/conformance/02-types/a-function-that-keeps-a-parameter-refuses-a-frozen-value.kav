// Rule: A frozen value given to a function that does more than read that parameter, such as giving it back, is a compile error that says why.
// Spec: 2.20
// expect compile error

type Order {
    id: Int
    lines: [String]
}

fn keep(o: Order) -> Order {
    o
}

fn main() {
    const order = Order(id: 7, lines: ["tea"]).freeze()
    print(keep(order))                      // error: `keep` gives `o` back
    print(keep(order.unfreeze()))
}
