// Rule: By default, parsing text longer than `max_bytes: 64_000_000` is an error, `TooLarge`, not a memory blow-up.
// Spec: 2.12
// expect output: too large: 64000000

use std.json

fn main() {
    const text = " ".repeat(64_000_000) + "1"
    match json.parse(text) {
        ok(doc) => print(`read {doc}`),
        err(e) => match e {
            JsonError.TooLarge(limit) => print(`too large: {limit}`),
            _ => print(`other: {e}`),
        }
    }
}
