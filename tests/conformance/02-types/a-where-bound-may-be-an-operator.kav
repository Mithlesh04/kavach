// Rule: A method's `where` may name an operator's interface: the body uses that operator on a `T`, and a call needs a `T` that meets it.
// Spec: 2.9, 2.16
// expect compile error

type Pair<T> {
    a: T
    b: T

    fn both(self) -> T where T: BitAnd { self.a & self.b }
}

fn main() {
    print(Pair(a: 12, b: 10).both())
    print(Pair(a: true, b: false).both())
    print(Pair(a: 1.5, b: 2.5).both())    // error: `both` needs `T: BitAnd`, and `T` is `Float` here
}
