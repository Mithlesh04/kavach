// Rule: `json.of(e)` of a type parameter is checked where the parameter gets a real type: a generic call that would write a record with a `secret` field is a compile error, through other generic functions and methods too.
// Spec: 2.12
// expect compile error

use std.json

type Cause {
    user: String
    secret password: String
}

type AppError = Down(cause: Cause) | Missing(what: String)

type Plain = Gone(what: String)

fn encode<E>(e: E) -> Json {
    json.of(e)
}

fn respond<E>(e: E) -> String {
    json.stringify(encode(e))
}

fn main() {
    print(respond(Plain.Gone(what: "x")))
    print(respond(AppError.Missing(what: "y")))     // error: `respond` writes its `E` as JSON
}
