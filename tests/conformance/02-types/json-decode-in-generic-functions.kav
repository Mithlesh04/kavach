// Rule: Inside a generic function, `json.decode<T>` decodes into the type its call gave `T`, written or inferred.
// Spec: 2.12
// expect output: 2
// expect output: [3, 4]
// expect output: Mismatch(path: "y", expected: "a whole number that fits `Int`")

use std.json

type Point {
    x: Int
    y: Int
}

fn read<T>(text: String) -> T ! JsonError {
    try json.decode<T>(text)
}

fn main() {
    const p = read<Point>("\{\"x\": 1, \"y\": 2}") catch _ => Point(x: 0, y: 0)
    print(p.y)
    const xs: [Int] = read("[3, 4]") catch _ => []
    print(xs)
    const _bad = read<Point>("\{\"x\": 1, \"y\": true}") catch e => {
        print(e)
        return
    }
}
