// Rule: A capacity below 0 counts as 0, for maps and sets too: they are full at once, and adding to one panics.
// Spec: 2.2
// expect output: true
// expect output: true
// expect output: 0
// expect panic

fn main() {
    let m: [String: Int] = Map.capacity(-7)
    let s: Set<Int> = Set.capacity(-1)
    print(m.is_full())
    print(s.is_full())
    print(m.len() + s.len())
    s.add(1)
}
