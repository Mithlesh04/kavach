// Rule: Adding a new key to a full map made by `Map.capacity(n)` panics; changing a key it holds does not.
// Spec: 2.2
// expect output: ["a": 3]
// expect panic: the map is full (capacity 1)

fn main() {
    let m: [String: Int] = Map.capacity(1, ["a": 1])
    m["a"] = 3
    print(m)
    m["b"] = 2
}
