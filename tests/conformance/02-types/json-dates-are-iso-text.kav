// Rule: `std.time`'s `Date`, `Time` and `DateTime` are ISO 8601 text in JSON, a `DateTime` in UTC with `Z`; decoding takes an offset and turns it to UTC, drops digits past milliseconds, and anything else is a problem.
// Spec: 2.12
// expect output: {"day":"2024-01-02","at":"03:04:05.120","made":"2024-01-02T03:04:05Z","off":["2024-02-29"]}
// expect output: "2024-01-02"
// expect output: true
// expect output: 2023-12-31T20:30:00.123
// expect output: [day] a date such as `2024-01-02`
// expect output: [at] a time of day such as `03:04:05`
// expect output: [made] a date and time such as `2024-01-02T03:04:05Z`
// expect output: "string" "date"
// expect output: "date-time"

use std.json
use std.time.{Date, Time, DateTime}

type Row {
    day: Date
    at: Time
    made: DateTime
    off: [Date]
}

const day = Date(year: 2024, month: 1, day: 2)
const row = Row(
    day: day,
    at: Time(hour: 3, minute: 4, second: 5, ms: 120),
    made: DateTime(date: day, time: Time(hour: 3, minute: 4, second: 5, ms: 0)),
    off: [Date(year: 2024, month: 2, day: 29)],
)
const text = json.stringify(row)
print(text)
print(json.of(day))
const back = json.decode<Row>(text) catch e => {
    print(e)
    row
}
print(back == row)
const moved = json.decode<DateTime>("\"2024-01-01T02:00:00.123456+05:30\"") catch _ => row.made
print(moved.iso())
const bad = "\{\"day\": \"infinity\", \"at\": 5, \"made\": \"2024-02-30T00:00:00Z\", \"off\": []}"
const _ = json.decode<Row>(bad) catch e => {
    match e {
        JsonError.Invalid(problems) => {
            for p in problems {
                print("[{p.path}] {p.expected}")
            }
        }
        _ => {}
    }
    row
}
const date = json.schema<Date>()
print("{date["type"]} {date["format"]}")
print(json.schema<DateTime>()["format"])
