// Rule: A range reads as the list of its numbers: `a..b` with `b` at or below `a` is empty, `a..=a` holds `a` alone, and `first`, `last` and `get` read it as that list.
// Spec: 2.2
// expect output: [] 0 0
// expect output: [3] 1
// expect output: [-3, -2, -1]
// expect output: 1 3 none
// expect output: none

fn main() {
    let lo = 5
    print("{(lo..2).to_list()} {(lo..lo).len()} {(lo..lo).sum(i => i)}")
    print("{(3..=3).to_list()} {(3..=3).len()}")
    print((-3..0).to_list())
    print("{(1..=3).first() ?? 0} {(1..=3).last() ?? 0} {(1..4).get(5)}")
    print((lo..2).first())
}
