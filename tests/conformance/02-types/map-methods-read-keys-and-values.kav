// Rule: A map has `len`, `is_empty`, `get`, `contains_key`, `keys`, `values` and `remove`; a missing key gives `none`, keys and values come in insertion order, and removing a missing key changes nothing.
// Spec: 2.2
// expect output: 2 false true
// expect output: 27 none
// expect output: true false
// expect output: ["ravi", "asha"]
// expect output: [27, 31]
// expect output: {"ravi": 27, "asha": 31}
// expect output: {:} 0
// expect output: true

fn main() {
    let ages = {"ravi": 27, "asha": 31}
    const empty: {String: Int} = {:}
    print("{ages.len()} {ages.is_empty()} {empty.is_empty()}")
    print("{ages.get("ravi") ?? 0} {ages.get("meera")}")
    print("{ages.contains_key("asha")} {ages.contains_key("Asha")}")
    print(ages.keys())
    print(ages.values())
    ages.remove("meera")
    print(ages)
    ages.remove("ravi")
    ages.remove("asha")
    print("{ages} {ages.len()}")
    print(ages == empty)
}
