// Rule: `x[#k]` on a program's own type needs a method `fn len(self) -> Int`.
// Spec: 2.16
// expect compile error

type Pair: Index<Int, Int> {
    a: Int
    b: Int

    fn index(self, key: Int) -> Int { if key == 0 { self.a } else { self.b } }
}

fn main() {
    const p = Pair(a: 1, b: 2)
    print(p[#1])            // error: `Pair` needs a method `fn len(self) -> Int`
}
