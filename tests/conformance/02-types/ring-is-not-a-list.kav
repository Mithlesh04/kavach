// Rule: `Ring<T>` is a type of its own: a function that takes a list is not given a ring.
// Spec: 2.2
// expect compile error

fn total(xs: [Int]) -> Int {
    xs.sum(x => x)
}

fn main() {
    const r = Ring<Int, max: 2>([1, 2])
    print(total(r))     // error: expected `[Int]`, found `Ring<Int>`
}
