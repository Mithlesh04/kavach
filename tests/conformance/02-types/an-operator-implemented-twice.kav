// Rule: A type may implement an operator's interface once for each type on the right; the right operand's type chooses the method.
// Spec: 2.16
// expect output: Vec2(x: 1.0, y: 4.0)
// expect output: Vec2(x: 3.0, y: 6.0)

type Vec2: Mul<Vec2>, Mul<Float> {
    x: Float
    y: Float

    fn mul(self, other: Vec2) -> Vec2 { Vec2(x: self.x * other.x, y: self.y * other.y) }
    fn mul(self, other: Float) -> Vec2 { Vec2(x: self.x * other, y: self.y * other) }
}

fn main() {
    const v = Vec2(x: 1.0, y: 2.0)
    print(v * v)
    print(v * 3.0)
}
