// Rule: A shift of a `bits` number takes 0 to `n - 1`.
// Spec: 2.1, 1.8, 5.6
// expect output: 2048
// expect panic: integer overflow: 1 << 13 doesn't fit in UInt<bits: 13>

fn shifted(x: UInt<bits: 13>, n: UInt<bits: 13>) -> UInt<bits: 13> {
    x << n
}

fn main() {
    print(shifted(1, 11))
    print(shifted(1, 13))
}
