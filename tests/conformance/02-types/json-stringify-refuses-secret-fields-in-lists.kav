// Rule: A secret can't leak into JSON by accident: `json.stringify` of a list of records with a `secret` field is a compile error.
// Spec: 2.12, 2.11
// expect compile error

use std.json

type Card {
    holder: String
    secret number: String
}

fn main() {
    const cards = [Card(holder: "Asha", number: "4242")]
    print(json.stringify(cards))       // error: a secret field must not leave as JSON
}
