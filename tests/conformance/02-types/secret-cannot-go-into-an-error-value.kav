// Rule: A secret value must not flow into an error's field unless that field is itself `secret`.
// Spec: 2.11, 8.7
// expect compile error

type Customer {
    name: String
    secret card_number: String
}

type PayError = Declined(why: String)

fn pay(c: Customer) ! PayError {
    if c.name == "" {
        fail PayError.Declined(why: c.name)
    }
    fail PayError.Declined(why: c.card_number)      // error: `why` isn't secret
}

fn main() {
    pay(Customer(name: "Asha", card_number: "4242")) catch e => print(e)
}
