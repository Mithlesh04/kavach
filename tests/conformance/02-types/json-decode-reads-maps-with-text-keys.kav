// Rule: A map with `String` keys decodes from an object, keeping its keys in order, bare or as a field.
// Spec: 2.12
// expect output: {"b": 1.5, "a": 2.0}
// expect output: EUR 0.9, keys ["USD", "EUR"]

use std.json

type Rates {
    base: String
    rates: {String: Float}
}

fn main() ! JsonError {
    print(try json.decode<{String: Float}>("\{\"b\": 1.5, \"a\": 2}"))
    const r = try json.decode<Rates>("\{\"base\": \"USD\", \"rates\": \{\"USD\": 1, \"EUR\": 0.9}}")
    print("EUR {r.rates["EUR"] ?? 0.0}, keys {r.rates.keys()}")
}
