// Rule: A field of a `T?` is read with `?.` or after unwrapping it: `.` on an optional is an error.
// Spec: 2.7
// expect compile error

type User {
    name: String
}

fn find(id: Int) -> User? {
    if id == 1 { User(name: "Asha") } else { none }
}

fn main() {
    print(find(1)?.name ?? "guest")
    print(find(1).name)      // error: `User?` may be `none`; write `?.name`
}
