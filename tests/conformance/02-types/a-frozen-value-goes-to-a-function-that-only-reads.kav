// Rule: A frozen value goes where a plain type is written to a function, or a method's `self`, that only reads it, also through other functions that only read.
// Spec: 2.20
// expect output: 20
// expect output: tea, cake
// expect output: 2 lines
// expect output: 3

type Order {
    id: Int
    lines: [String]

    fn count(self) -> Int {
        self.lines.len()
    }

    fn describe(self) -> String {
        `{self.count()} lines`
    }
}

fn total(o: Order) -> Int {
    o.lines.len() * 10
}

fn names(o: Order) -> String {
    join(o.lines)
}

fn join(lines: [String]) -> String {
    let out = ""
    for line in lines {
        if out != "" {
            out += ", "
        }
        out += line
    }
    out
}

fn longest(xs: [Int]) -> Int {
    xs.max() ?? 0
}

fn main() {
    const order = Order(id: 7, lines: ["tea", "cake"]).freeze()
    print(total(order))
    print(names(order))
    print(order.describe())
    print(longest([1, 3, 2].freeze()))
}
