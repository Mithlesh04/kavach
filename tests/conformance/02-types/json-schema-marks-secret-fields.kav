// Rule: `json.schema<T>()` marks a `secret` field `"writeOnly": true`, so a library sees that it can't be written out.
// Spec: 2.12
// expect output: {"user":{"type":"string"},"password":{"type":"string","writeOnly":true}}

use std.json

type Login {
    user: String
    secret password: String
}

fn main() {
    print(json.schema<Login>().get("properties"))
}
