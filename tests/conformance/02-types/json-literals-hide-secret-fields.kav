// Rule: A value inside a `Json` literal is written as `json.of` writes it, so a record's `secret` field there is `"<secret>"`.
// Spec: 2.12, 2.11
// expect output: {"paid":true,"card":{"holder":"Asha","number":"<secret>"}}

type Card {
    holder: String
    secret number: String
}

fn main() {
    const card = Card(holder: "Asha", number: "4242")
    const doc: Json = {"paid": true, "card": card}
    print(doc)
}
