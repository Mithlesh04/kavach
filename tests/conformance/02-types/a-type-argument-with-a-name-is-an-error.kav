// Rule: A type argument has no name: one written with a name is a compile error.
// Spec: 2.9
// expect compile error

type Grid<T, width: Int, height: Int> {
    rows: [[T]<len: width>]<len: height>

    fn at(self, x: Int, y: Int) -> T { self.rows[y][x] }
    fn cells(self) -> Int { width * height }
}

fn main() {
    const g: Grid<T: Float, width: 1, height: 1> = Grid(rows: [[0.5]])     // error: a type argument has no name
    print(g.cells())
}
