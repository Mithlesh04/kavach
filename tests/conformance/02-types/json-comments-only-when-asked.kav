// Rule: `json.parse(text, comments: true)` also takes `//` and `/* */` comments and trailing commas (JSONC); plain `json.parse` refuses them.
// Spec: 2.12
// expect output: {"port":8080,"hosts":["a","b"]}
// expect output: refused: expected a value

use std.json

fn main() ! Error {
    const text = "// the server\n\{\n  \"port\": 8080, /* default */\n  \"hosts\": [\"a\", \"b\",],\n}"
    const settings = try json.parse(text, comments: true)
    print(json.stringify(settings))
    const _ = json.parse(text) catch e => {
        match e {
            JsonError.Syntax(_, _, message) => print("refused: {message}"),
            _ => print("other"),
        }
        Json.Null
    }
}
