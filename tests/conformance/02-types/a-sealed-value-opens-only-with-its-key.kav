// Rule: `unfreeze()` without a key on a sealed value, a key of the wrong type, and a key for a value with none are compile errors.
// Spec: 2.20
// expect compile error

type Key {
    n: Int
}

fn main() {
    const s = [1, 2].freeze(key: Key(n: 1))
    const a = s.unfreeze()                  // error: sealed with a key
    const b = s.unfreeze(key: 1)            // error: expected `Key`
    const c = [3].freeze().unfreeze(key: Key(n: 1))   // error: isn't sealed with a key
    print(`{a} {b} {c}`)
}
