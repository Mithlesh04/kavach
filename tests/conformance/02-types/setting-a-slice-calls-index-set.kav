// Rule: `x[a:b] = v` calls `index_set` with the slice's key, a `Part`; a type may implement `IndexSet` for one key with several values, and the value's type chooses.
// Spec: 2.16
// expect output: [1.0, 7.0, 8.0, 4.0]
// expect output: [1.0, 0.0, 0.0, 4.0]
// expect output: [9.0, 0.0, 0.0, 4.0]

type Row: IndexSet<Int, Float>, IndexSet<Part, Row>, IndexSet<Part, Float> {
    cells: [Float]

    fn index_set(self, key: Int, value: Float) -> Row {
        let cells = self.cells
        cells[key] = value
        Row(cells: cells)
    }

    fn index_set(self, key: Part, value: Row) -> Row {
        let cells = self.cells
        const (start, end, _) = key.bounds(cells.len())
        for i in start..end {
            cells[i] = value.cells[i - start]
        }
        Row(cells: cells)
    }

    fn index_set(self, key: Part, value: Float) -> Row {
        let cells = self.cells
        const (start, end, _) = key.bounds(cells.len())
        for i in start..end {
            cells[i] = value
        }
        Row(cells: cells)
    }
}

fn main() {
    let r = Row(cells: [1.0, 2.0, 3.0, 4.0])
    r[1:3] = Row(cells: [7.0, 8.0])
    print(r.cells)
    r[1:3] = 0.0
    print(r.cells)
    r[0] = 9.0
    print(r.cells)
}
