// Rule: `len()` gives the items of an `Array` or the fields of an `Object`, and 0 for every other kind, text included.
// Spec: 2.12
// expect output: 3 2 0 0 0 0 0

use std.json

fn main() ! JsonError {
    const doc = try json.parse("[[1, 2, 3], \{\"a\": 1, \"b\": [9]}, \"abc\", 42, true, null]")
    print("{doc[0].len()} {doc[1].len()} {doc[2].len()} {doc[3].len()} {doc[4].len()} {doc[5].len()} {doc[9].len()}")
}
