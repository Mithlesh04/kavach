// Rule: The same type with other numbers is another type: one given for the other is a compile error.
// Spec: 2.9
// expect compile error

fn main() {
    const a: [Float]<len: 3> = [1.0, 2.0, 3.0]
    const b: [Float]<len: 2> = a     // error: `[Float]<len: 3>` is not `[Float]<len: 2>`
    print(b)
}
