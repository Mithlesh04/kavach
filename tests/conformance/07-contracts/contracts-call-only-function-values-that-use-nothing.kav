// Rule: A contract may call a function value only when its type says it uses nothing (`uses ()`).
// Spec: 7.5
// expect compile error

fn check(f: fn(Int) -> Int, x: Int) -> Int
    require f(x) > 0            // error: `f` may use capabilities; give it the type `fn(Int) -> Int uses ()`
{
    x
}

fn main() {
    const loud = (n: Int) => {
        print("printed by a contract")
        n
    }
    print(check(loud, 3))
}
