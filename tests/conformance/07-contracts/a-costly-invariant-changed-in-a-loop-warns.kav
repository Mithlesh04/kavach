// Rule: A change inside a loop to a value whose invariant walks a collection is a warning; outside a loop, or with an invariant that walks nothing, none.
// Spec: 7.3
// expect warning
// expect output: 3 3 2

type Track {
    times: [Int]

    invariant times.all(t => t >= 0)
}

type Count {
    n: Int

    invariant n >= 0
}

fn main() {
    let track = Track(times: [])
    for i in 0..3 {
        track.times.push(i)              // warning: walks `times` each round
    }
    track.times[0] = 5
    let c = Count(n: 0)
    for _ in 0..2 {
        c.n += 1
    }
    let fixed = Track(times: [0, 0, 0])
    for i in 0..3 {
        fixed.times[i] = i               // warning: walks `times` each round
    }
    print(`{track.times.len()} {fixed.times.len()} {c.n}`)
}
