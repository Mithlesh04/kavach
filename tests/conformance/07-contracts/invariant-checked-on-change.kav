// Rule: An invariant is checked when a value is changed.
// Spec: 7.3, 7.4
// expect output: 10
// expect panic: contract failed: invariant balance >= 0

type Account {
    owner: String
    balance: Int

    invariant balance >= 0
}

fn main() {
    let account = Account(owner: "Asha", balance: 10)
    print(account.balance)
    account.balance = -5
}
