// Rule: grouping keys are compared as a dict compares its keys: `0.0` and `-0.0` are one key, and a tuple groups by several keys at once.
// Spec: 14.2
// expect output: 1
// expect output: {(1, "a"): 2, (2, "a"): 1}

fn main() {
    print([0.0, -0.0].count_by(x => x).len())
    print([(1, "a"), (2, "a"), (1, "a")].count_by(p => p))
}
