// Rule: `tensor.linspace(start, end, count)` spaces `count` numbers evenly, the last exactly `end`; a count of 1 gives `[start]` and 0 none.
// Spec: 14.33
// expect output: [0.0, 0.25, 0.5, 0.75, 1.0]
// expect output: 0.3
// expect output: [2.0]
// expect output: []

use std.tensor

fn main() {
    print(tensor.linspace(0.0, 1.0, 5).items)
    print(tensor.linspace(0.0, 0.3, 4).items[#1])
    print(tensor.linspace(2.0, 9.0, 1).items)
    print(tensor.linspace(2.0, 9.0, 0).items)
}
