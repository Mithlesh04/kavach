// Rule: `sort()` is for lists of values with an order; a list of records has none, so sorting it is a compile error.
// Spec: 14.2
// expect compile error

type Point {
    x: Int
}

fn main() {
    const points = [Point(x: 2), Point(x: 1)]
    print(points.sort())        // error: `Point` has no order
}
