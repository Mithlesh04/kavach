// Rule: std.math has sqrt, pow, floor, ceil, round, pi and e.
// Spec: 14.5
// expect output: 4.0 8.0
// expect output: 2.0 3.0 3.0 -3.0
// expect output: true

use std.math

fn main() {
    print("{math.sqrt(16.0)} {math.pow(2.0, 3.0)}")
    print("{math.floor(2.5)} {math.ceil(2.5)} {math.round(2.5)} {math.round(-2.5)}")
    print(math.pi > 3.14 and math.e < 2.72)
}
