// Rule: `crypto.check_password(password, hash)` is false for a `hash` that isn't one, for a wrong password, and for a hash that was changed.
// Spec: 14.19
// expect output: false false false
// expect output: false false

use std.crypto

const stored = crypto.hash_password("correct horse")
print(`{crypto.check_password("correct horse", "")} {crypto.check_password("correct horse", "correct horse")} {crypto.check_password("", "$argon2id$")}`)
// One character of the hash itself changed, and a near password.
const at = stored.len() - 10
const old = stored[at:at + 1]
const changed = stored[:at] + (if old == "A" { "B" } else { "A" }) + stored[at + 1:]
print(`{crypto.check_password("correct horse", changed)} {crypto.check_password("correct horse ", stored)}`)
