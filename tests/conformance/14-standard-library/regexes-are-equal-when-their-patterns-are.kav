// Rule: Two `Regex` values are equal when their patterns are, even when the patterns match the same text.
// Spec: 14.8
// expect output: true
// expect output: false

use std.regex

fn main() ! Error {
    print(try regex.new("\d+") == try regex.new("\d+"))
    print(try regex.new("\d+") == try regex.new("[0-9]+"))
}
