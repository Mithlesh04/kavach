// Rule: `slice` clamps positions past the end of the text, and `truncate` gives at most `max` characters: the whole text when it is shorter.
// Spec: 14.2
// expect output: [bc] [] [ते]
// expect output: [Kavach] [नम] []

fn main() {
    print("[{"abc".slice(1, 99)}] [{"abc".slice(5, 9)}] [{"नमस्ते".slice(4, 100)}]")
    print("[{"Kavach".truncate(99)}] [{"नमस्ते".truncate(2)}] [{"".truncate(0)}]")
}
