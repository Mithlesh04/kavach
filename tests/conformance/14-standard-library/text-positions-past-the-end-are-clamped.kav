// Rule: A slice clamps positions past the end of the text: `s[:max]` gives at most `max` characters, the whole text when it is shorter.
// Spec: 14.2
// expect output: [bc] [] [ते]
// expect output: [Kavach] [नम] []

fn main() {
    print(`[{"abc"[1:99]}] [{"abc"[5:9]}] [{"नमस्ते"[4:100]}]`)
    print(`[{"Kavach"[:99]}] [{"नमस्ते"[:2]}] [{""[:0]}]`)
}
