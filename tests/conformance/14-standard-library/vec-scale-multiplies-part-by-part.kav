// Rule: std.vec's `a.scale(b)` multiplies each part of `a` by the same part of `b`, for every vector size and number type.
// Spec: 14.28
// expect output: Vec2(x: -3, y: 8)
// expect output: Vec3(x: 2.0, y: 1.0, z: -3.0)
// expect output: Vec4(x: 4.0, y: 6.0, z: 6.0, w: 4.0)

use std.vec

fn main() {
    print(Vec2(x: 3, y: 4).scale(Vec2(x: -1, y: 2)))
    print(Vec3(x: 1.0, y: 2.0, z: 3.0).scale(Vec3(x: 2.0, y: 0.5, z: -1.0)))
    print(Vec4(x: 1.0, y: 2.0, z: 3.0, w: 4.0).scale(Vec4(x: 4.0, y: 3.0, z: 2.0, w: 1.0)))
}
