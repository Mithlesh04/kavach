// Rule: A secret can't go into a log: putting one in an event field that isn't `secret` is a compile error.
// Spec: 14.12, 8.7
// expect compile error

use std.log

type Customer {
    name: String
    secret card: String
}

type Charged: LogEvent {
    card: String
}

fn main() {
    const c = Customer(name: "Asha", card: "4242 4242 4242 4242")
    log.info(Charged(card: c.card))          // error: `card` is secret
}
