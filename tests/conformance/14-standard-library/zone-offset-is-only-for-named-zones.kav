// Rule: `time.zone_offset(name, ms)` gives a named zone's offset in seconds, and `none` for any other name, a fixed offset too.
// Spec: 14.4
// expect output: 19800
// expect output: -14400 -18000
// expect output: none none

use std.time

fn main() {
    print(time.zone_offset("Asia/Kolkata", 0) ?? 1)
    print(`{time.zone_offset("America/New_York", 1_782_907_200_000) ?? 1} {time.zone_offset("America/New_York", 1_767_268_800_000) ?? 1}`)
    print(`{time.zone_offset("+05:30", 0)} {time.zone_offset("Mars/Olympus", 0)}`)
}
