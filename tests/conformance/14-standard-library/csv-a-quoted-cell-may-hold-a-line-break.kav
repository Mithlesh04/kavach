// Rule: a quoted CSV cell may hold line breaks; lines may end with `\n` or `\r\n`, and a byte order mark at the start is skipped.
// Spec: 14.34
// expect output: 2
// expect output: first line
// expect output: second line
// expect output: 7

use std.table

type Note {
    id: Int
    text: String
}

fn main() ! CsvError {
    const notes = try table.parse_csv<Note>(`\u{FEFF}id,text\r\n1,"first line\nsecond line"\r\n7,plain\r\n`)
    print(notes.len())
    print(notes[0].text)
    print(notes[1].id)
}
