// Rule: std.vec's `a.cross(b)` is at right angles to both `a` and `b` (its dot with each is 0), and swapping them turns it negative.
// Spec: 14.28
// expect output: Vec3(x: -3, y: 6, z: -3)
// expect output: 0 0
// expect output: true
// expect output: Vec3(x: 0.0, y: 0.0, z: 1.0)

use std.vec

fn main() {
    const a = Vec3(x: 1, y: 2, z: 3)
    const b = Vec3(x: 4, y: 5, z: 6)
    const c = a.cross(b)
    print(c)
    print("{c.dot(a)} {c.dot(b)}")
    print(b.cross(a) == -c)
    print(Vec3(x: 1.0, y: 0.0, z: 0.0).cross(Vec3(x: 0.0, y: 1.0, z: 0.0)))
}
