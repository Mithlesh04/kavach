// Rule: std.vec's `a.dot(b)` multiplies the parts in pairs and adds them; vectors at right angles give 0.
// Spec: 14.28
// expect output: 12.0
// expect output: 10
// expect output: 0.0
// expect output: 49.0
// expect output: 49.0

use std.vec

fn main() {
    print(Vec3(x: 1.0, y: 2.0, z: 3.0).dot(Vec3(x: 4.0, y: -5.0, z: 6.0)))
    print(Vec4(x: 1, y: 2, z: 3, w: 4).dot(Vec4(x: 1, y: 1, z: 1, w: 1)))
    print(Vec3(x: 1.0, y: 0.0, z: 0.0).dot(Vec3(x: 0.0, y: 1.0, z: 0.0)))
    const p = Vec3(x: 2.0, y: 3.0, z: 6.0)
    print(p.dot(p))
    print(p.length_squared())
}
