// Rule: `crypto.hash_password` gives Argon2id text (`$argon2id$v=19$…`) with a new salt each time, so one password hashed twice gives two texts, and both check.
// Spec: 14.19
// expect output: true true
// expect output: false
// expect output: true true

use std.crypto

const a = crypto.hash_password("correct horse")
const b = crypto.hash_password("correct horse")
print("{a.starts_with("$argon2id$v=19$")} {b.starts_with("$argon2id$v=19$")}")
print(a == b)
print("{crypto.check_password("correct horse", a)} {crypto.check_password("correct horse", b)}")
