// Rule: `bits` gives the IEEE 754 form of infinities too, and `Float.from_bits` gives `NaN` back from a `NaN`'s bits.
// Spec: 14.2
// expect output: 9218868437227405312 18442240474082181120
// expect output: inf -inf
// expect output: NaN false

fn main() {
    const inf = 1.0 / 0.0
    print(`{inf.bits()} {(-inf).bits()}`)
    print(`{Float.from_bits(9218868437227405312)} {Float.from_bits(18442240474082181120)}`)
    const nan = 0.0 / 0.0
    const back = Float.from_bits(nan.bits())
    print(`{back} {back == back}`)
}
