// Rule: A product of whole-number tensors panics on a sum that doesn't fit, as overflow does anywhere.
// Spec: 14.33, 5.6
// expect output: [[50]]
// expect panic

use std.tensor

fn main() {
    const five: Int8 = 5
    const a = tensor.full([1, 2], five)
    print((a @ a.transpose()).to_rows())
    const big: Int8 = 100
    const b = tensor.full([1, 2], big)
    print((b @ b.transpose()).to_rows())
}
