// Rule: A quaternion's `normalized()` scales it to length 1, keeping its direction.
// Spec: 14.28
// expect output: Quat(x: 0.0, y: 0.0, z: 0.0, w: 1.0)
// expect output: Quat(x: 0.5, y: 0.5, z: 0.5, w: 0.5)
// expect output: Quat(x: 0.0, y: -0.6, z: 0.0, w: 0.8)

use std.vec

fn main() {
    print(Quat(x: 0.0, y: 0.0, z: 0.0, w: 2.0).normalized())
    print(Quat(x: 1.0, y: 1.0, z: 1.0, w: 1.0).normalized())
    print(Quat(x: 0.0, y: -3.0, z: 0.0, w: 4.0).normalized())
}
