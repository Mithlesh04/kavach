// Rule: `folder` is the folder the program runs in, so its relative paths start there; `""` is this program's own folder.
// Spec: 14.23
// expect output: 0 ce013625030ba8dba906f756967f9e9ca394464a
// expect output: 128

use std.fs
use std.process

fn main() ! Error uses Fs, Process, Console {
    const dir = "kavach-t-proc-folder"
    try fs.create_dir(dir)
    try fs.write_text("{dir}/a.txt", "hello\n")
    const inside = try process.run("git", ["hash-object", "a.txt"], folder: dir)
    print("{inside.code} {inside.out.trim()}")
    // From this program's own folder there is no `a.txt`.
    const here = try process.run("git", ["hash-object", "a.txt"], folder: "")
    print(here.code)
    try fs.remove_all(dir)
}
