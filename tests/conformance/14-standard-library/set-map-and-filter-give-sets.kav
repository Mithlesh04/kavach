// Rule: A set's `map` and `filter` give a new set, in insertion order, with equal results kept once; they work on sets of any values, and on sets inside lists and records.
// Spec: 14.2, 2.2
// expect output: Set.of(1, 0)
// expect output: Set.of(3, 4, 5)
// expect output: Set.of(4, 3, 5) Set.of("pear", "apple")
// expect output: Set.of(1, 2) Set.of([1, 2])
// expect output: Set.of()
// expect output: [3, 9] true
// expect output: [1, 2] [1]
// expect output: Set.of(9.5, 20.0)

type Order {
    id: Int
    total: Float
    tags: Set<String>
}

fn main() {
    const nums = Set.of(3, 1, 4, 1, 5)
    print(nums.map(n => n % 2))
    print(nums.filter(n => n > 2))
    const words = Set.of("pear", "fig", "apple")
    print(`{words.map(w => w.len())} {words.filter(w => w.contains("p"))}`)
    const pairs = Set.of((1, "a"), (2, "b"))
    const rows = Set.of([1, 2], [3])
    print(`{pairs.map(p => p.0)} {rows.filter(r => r.len() > 1)}`)
    print(Set.of(0, 1).filter(n => n > 5))
    const groups = [Set.of(1, 2), Set.of(2, 3, 4)]
    print(`{groups.map(g => g.sum(n => n))} {groups.any(g => g.contains(4))}`)
    const orders = [
        Order(id: 1, total: 9.5, tags: Set.of("new")),
        Order(id: 2, total: 20.0, tags: Set.of("gift", "new")),
    ]
    const people = [{"name": "Asha", "city": "Pune"}, {"name": "Ravi", "city": "Goa"}]
    print(`{orders.map(o => o.tags.count(t => t != "x"))} {orders.filter(o => o.tags.contains("gift")).map(o => o.id - 1).filter(i => i > 0)}`)
    print(Set.of(1, 2).map(i => orders.find(o => o.id == i)?.total ?? 0.0))
    if people.count(p => p["city"] == "Goa") != 1 {
        print("wrong")
    }
}
