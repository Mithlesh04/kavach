// Rule: Each device's `kind` is one of the kinds the spec lists, and each display's `connection` one of the ports it names or `""`.
// Spec: 14.25
// expect output: devices: true
// expect output: displays: true

use std.system

fn main() uses System {
    const kinds = ["bluetooth", "network", "audio", "display", "gpu", "keyboard", "mouse",
        "storage", "usb", "camera", "printer", "processor", "other"]
    print(`devices: {system.devices().all(d => kinds.contains(d.kind))}`)
    const ports = ["HDMI", "DisplayPort", "internal", "VGA", "DVI", ""]
    print(`displays: {system.displays().all(d => ports.contains(d.connection) and d.hz >= 0)}`)
}
