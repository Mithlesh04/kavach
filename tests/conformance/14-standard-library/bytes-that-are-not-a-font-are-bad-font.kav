// Rule: font.load reads an OpenType or TrueType file's bytes, and bytes that aren't a font are BadFont.
// Spec: 14.31
// expect output: BadFont(reason: "this is not an OpenType or TrueType font, or it is damaged")

use std.font

fn main() {
    const f = font.load(Bytes([1, 2, 3])) catch e => {
        print(e)
        return
    }
    print(f.ascent)
}
