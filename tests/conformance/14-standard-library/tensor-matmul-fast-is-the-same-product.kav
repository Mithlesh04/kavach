// Rule: `a.matmul(b, fast: true)` is the product `a @ b`, as fast as the machine allows: floats may differ in their last bits, whole numbers are the same.
// Spec: 14.33
// expect output: true
// expect output: true

use std.tensor

fn main() {
    const a = tensor.linspace(0.1, 3.0, 12).reshape([3, 4])
    const b = tensor.linspace(-1.0, 2.0, 8).reshape([4, 2])
    print(((a @ b - a.matmul(b, fast: true)).map(x => x.abs()).max() ?? 1.0) < 1e-12)
    const i = tensor.arange(0, 12).reshape([3, 4])
    const j = tensor.arange(0, 8).reshape([4, 2])
    print(i @ j == i.matmul(j, fast: true))
}
