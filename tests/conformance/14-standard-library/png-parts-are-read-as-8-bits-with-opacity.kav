// Rule: Every image is read as 8 bits a part with opacity: a grey image's parts are the same, one without opacity is fully opaque, and 16-bit parts keep their high 8 bits.
// Spec: 14.29
// expect output: (100, 100, 100, 255)
// expect output: (100, 100, 100, 128)
// expect output: (10, 20, 30, 255)
// expect output: (18, 86, 154, 255)

use std.image

fn show(bytes: [UInt8]) {
    const img = image.decode(Bytes(bytes)) catch e => {
        print(e)
        return
    }
    print(img.pixel(0, 0))
}

fn main() {
    // 1×1 PNG files: grey 100; grey 100 with opacity 128; RGB (10, 20, 30); 16-bit RGB (0x1234, 0x5678, 0x9abc).
    show([137, 80, 78, 71, 13, 10, 26, 10, 0, 0, 0, 13, 73, 72, 68, 82, 0, 0, 0, 1, 0, 0, 0, 1,
        8, 0, 0, 0, 0, 58, 126, 155, 85, 0, 0, 0, 10, 73, 68, 65, 84, 120, 218, 99, 72, 1, 0, 0,
        102, 0, 101, 215, 40, 188, 31, 0, 0, 0, 0, 73, 69, 78, 68, 174, 66, 96, 130])
    show([137, 80, 78, 71, 13, 10, 26, 10, 0, 0, 0, 13, 73, 72, 68, 82, 0, 0, 0, 1, 0, 0, 0, 1,
        8, 4, 0, 0, 0, 181, 28, 12, 2, 0, 0, 0, 11, 73, 68, 65, 84, 120, 218, 99, 72, 105, 0, 0,
        1, 75, 0, 229, 245, 80, 236, 200, 0, 0, 0, 0, 73, 69, 78, 68, 174, 66, 96, 130])
    show([137, 80, 78, 71, 13, 10, 26, 10, 0, 0, 0, 13, 73, 72, 68, 82, 0, 0, 0, 1, 0, 0, 0, 1,
        8, 2, 0, 0, 0, 144, 119, 83, 222, 0, 0, 0, 12, 73, 68, 65, 84, 120, 218, 99, 224, 18, 145, 3,
        0, 0, 104, 0, 61, 106, 245, 112, 91, 0, 0, 0, 0, 73, 69, 78, 68, 174, 66, 96, 130])
    show([137, 80, 78, 71, 13, 10, 26, 10, 0, 0, 0, 13, 73, 72, 68, 82, 0, 0, 0, 1, 0, 0, 0, 1,
        16, 2, 0, 0, 0, 192, 231, 143, 157, 0, 0, 0, 15, 73, 68, 65, 84, 120, 218, 99, 16, 50, 9, 171,
        152, 181, 7, 0, 6, 39, 2, 107, 183, 165, 105, 61, 0, 0, 0, 0, 73, 69, 78, 68, 174, 66, 96, 130])
}
