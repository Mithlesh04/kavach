// Rule: `d.round_even(places)` with `places` below 0 panics, as `round` does.
// Spec: 14.2
// expect output: 2.34
// expect panic

fn cut(d: Decimal, places: Int) -> Decimal {
    d.round_even(places)
}

fn main() {
    const price: Decimal = 2.345
    print(cut(price, 2))
    print(cut(price, -1))
}
