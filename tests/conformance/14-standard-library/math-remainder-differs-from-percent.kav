// Rule: `math.remainder(x, y)` is `x - n * y` with `n` the whole number nearest `x / y`, an even one at a tie; `%` keeps `x`'s sign.
// Spec: 14.5
// expect output: 1.0 -2.0
// expect output: -1.0 2.0
// expect output: -2.0 2.0

use std.math

fn main() {
    let x = -5.0
    print(`{math.remainder(x, 3.0)} {x % 3.0}`)
    let y = 5.0
    print(`{math.remainder(y, -3.0)} {y % -3.0}`)
    // 6 / 4 = 1.5 rounds to 2 and 2 / 4 = 0.5 rounds to 0: the even ones.
    print(`{math.remainder(6.0, 4.0)} {math.remainder(2.0, 4.0)}`)
}
