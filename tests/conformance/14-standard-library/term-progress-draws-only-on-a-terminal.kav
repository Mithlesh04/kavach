// Rule: A progress bar is drawn only when output is a terminal: into a file or a pipe, `term.progress`, `term.step` and `term.done` print nothing.
// Spec: 14.13
// expect output: copied 3 files

use std.term

fn main() {
    let bar = term.progress(3)
    for _ in 0..3 {
        bar = term.step(bar, 1)
    }
    term.done(bar)
    print("copied 3 files")
}
