// Rule: `min`, `max` and `clamp` work on floats and sized whole numbers as on `Int`.
// Spec: 14.2
// expect output: -1.0 0.25
// expect output: 5.0 0.0 2.5
// expect output: -128 100

fn main() {
    print("{2.5.min(-1.0)} {(-0.5).max(0.25)}")
    print("{7.5.clamp(0.0, 5.0)} {(-3.0).clamp(0.0, 5.0)} {2.5.clamp(0.0, 5.0)}")
    const lo: Int8 = -128
    const hi: Int8 = 100
    print("{lo.min(hi)} {lo.max(hi)}")
}
