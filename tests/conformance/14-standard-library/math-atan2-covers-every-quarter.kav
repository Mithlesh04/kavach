// Rule: `math.atan2(y, x)` is the angle of the point `(x, y)`, from -π to π, in each of the four quarters.
// Spec: 14.5
// expect output: true true
// expect output: true true
// expect output: true

use std.math

fn main() {
    const pi = math.pi
    print(`{math.atan2(1.0, 1.0).near(pi / 4.0)} {math.atan2(1.0, -1.0).near(3.0 * pi / 4.0)}`)
    print(`{math.atan2(-1.0, -1.0).near(-3.0 * pi / 4.0)} {math.atan2(-1.0, 1.0).near(-pi / 4.0)}`)
    print(math.atan2(0.0, -1.0).near(pi))
}
