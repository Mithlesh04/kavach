// Rule: `t[i, j]` gives the number at one index per dimension; `#k` counts from the end of its own dimension.
// Spec: 14.33
// expect output: 5
// expect output: 3
// expect output: 0
// expect output: 4

use std.tensor

fn main() {
    const t = tensor.arange(0, 6).reshape([2, 3])
    print(t[1, #1])
    print(t[1, 0])
    print(t[#2, 0])
    print(tensor.of([2, 4])[1])
}
