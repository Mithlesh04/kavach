// Rule: std.vec's `a.distance(b)` is how far `b` is from `a`, the same both ways, and 0 from a point to itself.
// Spec: 14.28
// expect output: 5.0
// expect output: 5.0
// expect output: 7.0
// expect output: 2.0
// expect output: 0.0
// expect output: 5.0

use std.vec

fn main() {
    const a = Vec2(x: 1.0, y: 1.0)
    const b = Vec2(x: 4.0, y: 5.0)
    print(a.distance(b))
    print(b.distance(a))
    print(Vec3(x: 0.0, y: 0.0, z: 0.0).distance(Vec3(x: 2.0, y: 3.0, z: 6.0)))
    print(Vec4(x: 1.0, y: 1.0, z: 1.0, w: 1.0).distance(Vec4(x: 2.0, y: 2.0, z: 2.0, w: 2.0)))
    print(a.distance(a))
    print(Vec2(x: Float32(0.0), y: Float32(0.0)).distance(Vec2(x: Float32(3.0), y: Float32(-4.0))))
}
