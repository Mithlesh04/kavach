// Rule: A 12-hour clock (`h`, `hh`) in a pattern needs `A`, AM or PM, or the hour can't be told apart: a pattern without it breaks `format`'s `require`, a panic.
// Spec: 14.4
// expect panic: contract failed: require format.fits(pattern, "time", false)

use std.time

fn main() {
    print(time.Time(hour: 21, minute: 5, second: 0, ms: 0).format("hh:mm"))
}
