// Rule: Dates follow the Gregorian calendar with months 1 to 12; adding a month keeps the day, or gives the month's last; a moment becomes a `DateTime` in UTC.
// Spec: 14.4
// expect output: 2024-02-29
// expect output: Wednesday
// expect output: false
// expect output: 366
// expect output: 1969-12-31T23:59:59.999
// expect output: Date(year: 2026, month: 11, day: 4)
// expect output: invalid 2026-02-30

use std.time

fn main() {
    const due = time.Date(year: 2024, month: 1, day: 31)
    print(due.add_months(1).iso())
    print(due.weekday())
    print(time.is_leap_year(1900))
    print(due.days_until(time.Date(year: 2025, month: 1, day: 31)))
    print(time.utc(-1).iso())
    print(time.parse_date("2026-11-04") catch _ => due)
    match time.parse_date("2026-02-30") {
        ok(d) => print(d.iso()),
        err(DateError.Invalid(text)) => print("invalid {text}"),
    }
}
