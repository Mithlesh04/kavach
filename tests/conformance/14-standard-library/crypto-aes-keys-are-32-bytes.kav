// Rule: An AES key that isn't 32 bytes fails with `CryptoError.BadKey`, for `decrypt` as for `encrypt`.
// Spec: 14.19
// expect output: bad key bad key
// expect output: bad key bad key

use std.crypto

fn open(key: Bytes, sealed: Bytes) -> String {
    const data = crypto.decrypt(key, sealed) catch e => match e {
        CryptoError.Tampered => return "tampered",
        CryptoError.BadKey(_) => return "bad key",
    }
    data.text() ?? "?"
}

fn seal(key: Bytes) -> String {
    const sealed = crypto.encrypt(key, "x".bytes()) catch e => match e {
        CryptoError.Tampered => return "tampered",
        CryptoError.BadKey(_) => return "bad key",
    }
    `sealed {sealed.len()} bytes`
}

fn main() ! CryptoError {
    const sealed = try crypto.encrypt(crypto.aes_key(), "card 4242".bytes())
    // An AES-128 key, and one byte too many.
    print(`{open(crypto.random_bytes(16), sealed)} {open(crypto.random_bytes(33), sealed)}`)
    print(`{seal("".bytes())} {seal(crypto.random_bytes(24))}`)
}
