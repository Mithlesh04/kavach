// Rule: `fs.write_text` and `fs.write_bytes` replace the whole file: a shorter text leaves nothing of the longer one, and no temporary file stays behind.
// Spec: 14.3
// expect output: short
// expect output: Bytes(07)
// expect output: ["a.txt", "b.bin"]

use std.fs

fn main() ! FsError uses Fs, Console {
    const dir = "kavach-t-fs-replace"
    try fs.create_dir(dir)
    try fs.write_text(`{dir}/a.txt`, "a much longer first text")
    try fs.write_text(`{dir}/a.txt`, "short")
    print(try fs.read_text(`{dir}/a.txt`))
    try fs.write_bytes(`{dir}/b.bin`, Bytes([1, 2, 3, 4]))
    try fs.write_bytes(`{dir}/b.bin`, Bytes([7]))
    print(try fs.read_bytes(`{dir}/b.bin`))
    print(try fs.list(dir))
    try fs.remove_all(dir)
}
