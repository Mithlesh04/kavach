// Rule: `time.freeze` is only directly in a `test` block: in a function a test calls, it is a compile error.
// Spec: 14.4
// expect compile error

use std.time

fn start_of_2026() {
    time.freeze(1_767_225_600_000)  // error: `time.freeze` is only for tests
}

test "the year starts" {
    start_of_2026()
    assert time.now_ms() == 1_767_225_600_000
}
