// Rule: a value holding a `secret` field can't become a gRPC message: `grpc.encode<T>` writes its `T` as JSON, so the call with such a `T` is a compile error (spec 2.12).
// Spec: 14.14, 2.11
// expect compile error

use std.grpc

pub type Order {
    id: Int
    secret card: String
}

fn main() {
    const data = grpc.encode<Order>(Order(id: 1, card: "4111"))     // error: `encode` writes its `T` as JSON
    print(data.len())
}
