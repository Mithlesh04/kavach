// Rule: a value holding a `secret` field can't become a gRPC message: encoding refuses at run time, since a generic `encode<T>` can't be checked at the call site.
// Spec: 14.14, 2.11
// expect output: before
// expect panic

use std.grpc

pub type Order {
    id: Int
    secret card: String
}

fn main() {
    print("before")
    const data = grpc.encode<Order>(Order(id: 1, card: "4111"))
    print(data.len())
}
