// Rule: `fs.remove` deletes a file or an empty folder; a folder with files in it is an `FsError` and stays, and a missing path is `NotFound`.
// Spec: 14.3
// Checks: misuse
// expect output: refused
// expect output: true
// expect output: NotFound(path: "kavach-t-fs-remove/gone.txt")
// expect output: false

use std.fs

fn main() ! FsError uses Fs, Console {
    const dir = "kavach-t-fs-remove"
    try fs.create_dir("{dir}/full")
    try fs.write_text("{dir}/full/a.txt", "a")
    fs.remove("{dir}/full") catch _ => print("refused")
    print(fs.exists("{dir}/full/a.txt"))
    fs.remove("{dir}/gone.txt") catch e => print(e)
    try fs.remove("{dir}/full/a.txt")
    try fs.remove("{dir}/full")
    try fs.remove(dir)
    print(fs.exists(dir))
}
