// Rule: `term.prompt_secret` gives a `Secret` whose `text` is a `secret` field, so printing it is refused.
// Spec: 14.13, 8.7
// expect compile error

use std.term

fn main() {
    const s = term.prompt_secret("Password?") ?? return
    print(s.text)                  // error: a secret can't be printed
}
