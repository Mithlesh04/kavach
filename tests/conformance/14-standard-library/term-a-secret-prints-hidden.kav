// Rule: a `Secret` prints with its `text` as `<secret>`; `reveal(s.text)` gives the plain text where it is really needed.
// Spec: 14.13, 2.11
// expect output: Secret(text: <secret>)
// expect output: 7

use std.term

fn main() {
    const s = Secret(text: "hunter2")
    print(s)
    print(reveal(s.text).len())
}
