// Rule: `pad.rumble` takes motor strengths from 0 to 1 and 0 to 60,000 milliseconds; a value outside breaks its contract and panics.
// Spec: 14.26
// expect output: in range
// expect panic: contract failed

use std.input

fn main() uses Input {
    const gone = Pad(id: 424_243, name: "Gone", buttons: [], left: (x: 0.0, y: 0.0), right: (x: 0.0, y: 0.0), left_trigger: 0.0, right_trigger: 0.0)
    gone.rumble(0.0, 0.0, 60_000)
    print("in range")
    const strong = [1.5][0]
    gone.rumble(strong, 0.0, 100)
    print("rumbled")
}
