// Rule: `remove_prefix` and `remove_suffix` take `p` off once; text that doesn't start or end with `p`, or an empty `p`, gives `s` itself.
// Spec: 14.2
// expect output: aa aa
// expect output: x|[]|abc|abc
// expect output: स्ते

fn main() {
    print(`{"aaa".remove_prefix("a")} {"aaa".remove_suffix("a")}`)
    print(`{"x".remove_prefix("xy")}|[{"abc".remove_suffix("abc")}]|{"abc".remove_prefix("")}|{"abc".remove_suffix("")}`)
    print("नमस्ते".remove_prefix("नम"))
}
