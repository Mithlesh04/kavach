// Rule: a request that breaks a limit is answered with its status and the connection closed: a request sent after it on the same connection gets no answer, and the handler sees neither.
// Spec: 14.11
// expect output: HTTP/1.1 413 Content Too Large
// expect output: answers: 1
// expect output: handler calls: 0
// expect output: after a good request: 1

use std.http
use std.net

/// Sends `text` and gives everything that comes back until the server closes.
fn exchange(address: String, text: String) -> String ! NetError uses Net {
    const conn = try net.connect(address)
    try conn.write(text.bytes())
    let all = Bytes([])
    while true {
        const piece = conn.read().timeout(5.seconds) catch _ => break
        all = all + (piece ?? break)
    }
    conn.close()
    all.text() ?? ""
}

fn main() ! Error {
    const crlf = "\u{D}\n"
    const calls = Shared(0)
    const listener = try net.listen("127.0.0.1:0")
    const _server = spawn http.serve(listener, r => {
        calls.update(c => c + 1)
        http.text(200, "answered {r.path}")
    }, limits: ServeLimits(max_body_bytes: 10))
    const big = "POST /big HTTP/1.1{crlf}content-length: 50{crlf}{crlf}"
    const next = "GET /next HTTP/1.1{crlf}connection: close{crlf}{crlf}"
    const got = try exchange(listener.address(), big + next)
    print(got.split(crlf)[0])
    print("answers: {got.split(crlf).filter(l => l.starts_with("HTTP/1.1 ")).len()}")
    print("handler calls: {calls.get()}")
    const _small = try http.get("http://{listener.address()}/small")
    print("after a good request: {calls.get()}")
}
