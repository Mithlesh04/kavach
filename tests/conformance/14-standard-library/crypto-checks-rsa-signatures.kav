// Rule: `crypto.rsa_verify(n, e, data, signature, pss: false)` checks an RSA signature with SHA-256 (RS256, or PS256 with `pss: true`) from a public key's modulus and exponent.
// Spec: 14.19
// expect output: true true
// expect output: false false

use std.base64
use std.crypto

fn main() ! Base64Error {
    // A 2048-bit key made with OpenSSL, and two signatures of "order 7".
    const modulus = ""
    const pkcs1 = ""
    const pss_sig = ""
    const n = try base64.decode(modulus)
    const e = Bytes([1, 0, 1])
    const data = "order 7".bytes()
    const rs256 = crypto.rsa_verify(n, e, data, try base64.decode(pkcs1))
    const ps256 = crypto.rsa_verify(n, e, data, try base64.decode(pss_sig), pss: true)
    print("{rs256} {ps256}")
    const changed = crypto.rsa_verify(n, e, "order 8".bytes(), try base64.decode(pkcs1))
    const wrong_kind = crypto.rsa_verify(n, e, data, try base64.decode(pkcs1), pss: true)
    print("{changed} {wrong_kind}")
}
