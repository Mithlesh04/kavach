// Rule: `min_by`'s key must have an order, as `sort_by`'s must: a record key is a compile error.
// Spec: 14.2
// expect compile error

type Point {
    x: Int
}

fn main() {
    const points = [Point(x: 2), Point(x: 1)]
    print(points.min_by(p => p) ?? Point(x: 0))       // error: `min_by`'s key needs values with an order
}
