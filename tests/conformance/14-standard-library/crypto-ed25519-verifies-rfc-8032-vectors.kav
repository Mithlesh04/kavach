// Rule: `crypto.ed25519_verify(public, data, signature)` accepts the signatures of RFC 8032's test vectors, and refuses them when one byte of the data or the signature changes, or with another key.
// Spec: 14.19
// expect output: true true
// expect output: false false
// expect output: false false

use std.crypto

fn unhex(h: String) -> Bytes {
    const digits = "0123456789abcdef"
    let out: [UInt8] = []
    let i = 0
    while i + 2 <= h.len() {
        const high = digits.index_of(h.slice(i, i + 1)) ?? 0
        const low = digits.index_of(h.slice(i + 1, i + 2)) ?? 0
        out.push(UInt8(high * 16 + low))
        i += 2
    }
    Bytes(out)
}

// RFC 8032 section 7.1, tests 1 (empty message) and 2 (one byte, 0x72).
const public1 = unhex("d75a980182b10ab7d54bfed3c964073a0ee172f3daa62325af021a68f707511a")
const sig1 = unhex("e5564300c360ac729086e2cc806e828a84877f1eb8e5d974d873e065224901555fb8821590a33bacc61e39701cf9b46bd25bf5f0595bbe24655141438e7a100b")
const public2 = unhex("3d4017c3e843895a92b70aa74d1b7ebc9c982ccf2ec4968cc0cd55f12af4660c")
const sig2 = unhex("92a009a9f0d4cab8720e820b5f642540a2b27b5416503f8fb3762223ebdb69da085ac1e43e15996e458f3613d0f11d8c387b2eaeb4302aeeb00d291612bb0c00")
const data2 = Bytes([114])
print(`{crypto.ed25519_verify(public1, "".bytes(), sig1)} {crypto.ed25519_verify(public2, data2, sig2)}`)
const changed_sig = sig2.slice(0, 10) + Bytes([sig2[10] ^ 1]) + sig2.slice(11, 64)
print(`{crypto.ed25519_verify(public2, Bytes([115]), sig2)} {crypto.ed25519_verify(public2, data2, changed_sig)}`)
print(`{crypto.ed25519_verify(public1, data2, sig2)} {crypto.ed25519_verify(public2, data2, sig2.slice(0, 63))}`)
