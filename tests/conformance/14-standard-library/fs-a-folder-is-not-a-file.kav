// Rule: a folder where a file is expected is an `FsError`: reading it, writing over it, or listing a file as a folder fails, and nothing changes.
// Spec: 14.3
// Checks: misuse
// expect output: read refused
// expect output: write refused
// expect output: bytes refused
// expect output: list refused
// expect output: Folder

use std.fs

fn main() ! FsError uses Fs, Console {
    const dir = "kavach-t-fs-folder"
    try fs.create_dir("{dir}/sub")
    try fs.write_text("{dir}/file.txt", "x")
    const text = fs.read_text("{dir}/sub") catch _ => "read refused"
    print(text)
    fs.write_text("{dir}/sub", "over") catch _ => print("write refused")
    const _data = fs.read_bytes("{dir}/sub") catch _ => {
        print("bytes refused")
        Bytes([])
    }
    const _names = fs.list("{dir}/file.txt") catch _ => {
        print("list refused")
        []
    }
    print((try fs.info("{dir}/sub")).kind)
    try fs.remove_all(dir)
}
