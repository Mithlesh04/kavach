// Rule: gRPC calls need the `Net` capability, so calling one from a function whose `uses` clause doesn't list it is a compile error.
// Spec: 14.14, 8.1
// expect compile error

use std.grpc

pub type Ping {
    n: Int
}

fn ping(target: String) -> Ping ! GrpcError uses Console {
    try grpc.call<Ping, Ping>(target, "/test.Ping/Ping", Ping(n: 1))    // error: `ping` uses Net, which its `uses` clause doesn't list
}

fn main() {
}
