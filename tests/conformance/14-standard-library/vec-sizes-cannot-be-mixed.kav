// Rule: Vectors of different sizes cannot be added: `Vec2 + Vec3` is a compile error.
// Spec: 14.28
// expect compile error

use std.vec

fn main() {
    const a = Vec2(x: 1.0, y: 2.0)
    const b = Vec3(x: 1.0, y: 2.0, z: 3.0)
    print(a + b)                        // error: `+` on a Vec2 takes a Vec2
}
