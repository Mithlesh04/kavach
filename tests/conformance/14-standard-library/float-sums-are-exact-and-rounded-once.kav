// Rule: `sum(f)` of floats is the exact sum, rounded once, so it gives the same bits in any order.
// Spec: 14.2
// expect output: 1.0 0.0
// expect output: 0.6 0.6000000000000001
// expect output: true
// expect output: 1.0
// expect output: 220.0

type Sale {
    region: String
    amount: Float
}

fn main() {
    const xs = [1e20, 1.0, -1e20]
    let in_order = 0.0
    for x in xs {
        in_order += x
    }
    print(`{xs.sum(x => x)} {in_order}`)
    const ys = [0.1, 0.2, 0.3]
    print(`{ys.sum(x => x)} {ys[0] + ys[1] + ys[2]}`)
    const many = (1..=1000).map(i => 1.0 / Float(i))
    print(many.sum(x => x).bits() == many[::-1].sum(x => x).bits())
    print(Set.of(1e20, 1.0, -1e20).sum(x => x))
    const sales = [Sale(region: "north", amount: 120.0), Sale(region: "north", amount: 100.0)]
    print(sales.sum(.amount))
}
