// Rule: Text methods on empty input follow Python's and Rust's rules: `"".lines()` is `[]`, and an empty part is found at once (`contains("")` is true, `index_of("")` is 0).
// Spec: 14.2
// expect output: []
// expect output: ["a", "b"]
// expect output: true
// expect output: 0
// expect output: true

fn main() {
    print("".lines())
    print(`a\nb`.lines())
    print("abc".contains(""))
    print("abc".index_of("") ?? -1)
    print("".contains(""))
}
