// Rule: `crypto.sha256`, `crypto.sha384` and `crypto.sha512` give the digests FIPS 180-4 lists for "abc".
// Spec: 14.19
// expect output: ba7816bf8f01cfea414140de5dae2223b00361a396177a9cb410ff61f20015ad
// expect output: cb00753f45a35e8bb5a03d699ac65007272c32ab0eded1631a8b605a43ff5bed8086072ba1e7cc2358baeca134c825a7
// expect output: ddaf35a193617abacc417349ae20413112e6fa4e89a97ea20a9eeee64b55d39a2192992a274fc1a836ba3c23a3feebbd454d4423643ce80e2a9ac94fa54ca49f

use std.crypto

fn hex(b: Bytes) -> String {
    const digits = "0123456789abcdef"
    let out = ""
    for i in 0..b.len() {
        const n = Int(b[i])
        out = out + digits.slice(n / 16, n / 16 + 1) + digits.slice(n % 16, n % 16 + 1)
    }
    out
}

const data = "abc".bytes()
print(hex(crypto.sha256(data)))
print(hex(crypto.sha384(data)))
print(hex(crypto.sha512(data)))
