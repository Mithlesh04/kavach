// Rule: A secret key kept as a secret (8.7), in a `secret` field, can't be printed or put in text.
// Spec: 14.19, 8.7
// expect compile error

use std.crypto

type Signer {
    secret key: Bytes
}

fn main() {
    const signer = Signer(key: crypto.ed25519_secret())
    print("signing with {signer.key}")       // error: the key is secret
}
