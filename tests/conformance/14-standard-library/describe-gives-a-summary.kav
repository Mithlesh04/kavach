// Rule: `describe(f)` gives the count, mean, standard deviation, smallest value, quartiles and largest value, quartiles at 0.25, 0.5 and 0.75 of the way through the sorted values.
// Spec: 14.2
// expect output: (count: 4, max: 5.0, mean: 3.75, median: 4.0, min: 2.0, q1: 3.5, q3: 4.25, std: 1.2583057392117916)
// expect output: none none

fn main() {
    print([2.0, 4.0, 4.0, 5.0].describe(x => x))
    const empty: [Int] = []
    print(`{empty.describe(x => x)} {[7].describe(x => x)?.std}`)
}
