// Rule: Secret keys and passwords kept as secrets (8.7) can be given to std.crypto's functions, which sign, seal and hash with them.
// Spec: 14.19, 8.7
// expect output: true
// expect output: card 4242
// expect output: true

use std.crypto

type Vault {
    secret signing: Bytes
    secret sealing: Bytes
    secret password: String
}

fn main() ! CryptoError {
    const v = Vault(signing: crypto.ed25519_secret(), sealing: crypto.aes_key(), password: "hunter2")
    const sig = try crypto.ed25519_sign(v.signing, "order 7".bytes())
    print(crypto.ed25519_verify(try crypto.ed25519_public(v.signing), "order 7".bytes(), sig))
    const sealed = try crypto.encrypt(v.sealing, "card 4242".bytes())
    print((try crypto.decrypt(v.sealing, sealed)).text() ?? "")
    print(crypto.check_password(v.password, crypto.hash_password(v.password)))
}
