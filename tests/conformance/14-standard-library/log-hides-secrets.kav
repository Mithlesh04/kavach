// Rule: A secret field of a log event is written as `<secret>`.
// Spec: 14.12, 2.11
// expect output: INFO PaymentTaken(order_id: 7, card: <secret>)

use std.log

type PaymentTaken: LogEvent {
    order_id: Int
    secret card: String
}

fn main() {
    log.info(PaymentTaken(order_id: 7, card: "4242 4242 4242 4242"))
}
