// Rule: Reading gamepads needs `Input`, as reading the keyboard does.
// Spec: 14.26
// expect compile error

use std.input

pub fn count_pads() -> Int {
    input.pads().len()     // error: `count_pads` is `pub`, so it must say what it uses: add `uses Input`
}

fn main() uses Input {
    print(count_pads())
}
