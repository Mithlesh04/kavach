// Rule: generated tests skip a function that uses `Process`, since there is no fake for it yet: `kavach test` runs no program.
// Spec: 14.23, 11.5
// expect test pass

use std.process

/// A program that doesn't exist: if a generated test ran this, it would panic.
pub fn must_not_run(flag: String) -> Int uses Process {
    const done = process.run("kavach-t-no-such-tool", [flag]) catch e => panic("a generated test ran it: {e}")
    done.code
}
