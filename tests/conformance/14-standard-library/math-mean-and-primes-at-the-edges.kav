// Rule: `math.mean` of an empty list is `none`; `math.is_prime` is false for 0, 1 and negative numbers.
// Spec: 14.5
// expect output: none 2.5
// expect output: false false false true

use std.math

fn main() {
    const empty: [Float] = []
    print(`{math.mean(empty)} {math.mean([2.5])}`)
    print(`{math.is_prime(0)} {math.is_prime(1)} {math.is_prime(-7)} {math.is_prime(2)}`)
}
