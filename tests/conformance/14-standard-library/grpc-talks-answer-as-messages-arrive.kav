// Rule: on a method in `grpc.serve_talks`'s list, the handler answers each message as soon as it arrives, and `grpc.talk_with` runs its function for each answer as it arrives, sending what it gives next, and ending its side when it gives none; so each side can answer the other's last message.
// Spec: 14.14
// expect output: server got 1
// expect output: client got 2
// expect output: server got 3
// expect output: client got 4
// expect output: server got 5
// expect output: client got 6
// expect output: done
// expect output: bad: Status(code: 3, message: "not a count")

use std.grpc
use std.net

pub type Count {
    n: Int
}

fn plus_one(call: GrpcCall) -> GrpcReply {
    const c = grpc.read<Count>(call) catch _ => Count(n: 0)
    if c.n == 0 {
        return grpc.failed(3, "not a count")
    }
    print("server got {c.n}")
    grpc.reply(Count(n: c.n + 1))
}

fn main() ! Error {
    const listener = try net.listen("127.0.0.1:0")
    const _server = spawn grpc.serve_talks(listener, plus_one, ["/game.Count/Up"])
    const target = "http://{listener.address()}"
    try grpc.talk_with<Count, Count>(target, "/game.Count/Up", [Count(n: 1)], c => {
        print("client got {c.n}")
        if c.n < 6 { [Count(n: c.n + 1)] } else { none }
    })
    print("done")
    grpc.talk_with<Count, Count>(target, "/game.Count/Up", [Count(n: 0)], c => none) catch e => print("bad: {e}")
}
