// Rule: `mean` and `median` give a `Float32` for `Float32` and a `Decimal` for `Decimal`.
// Spec: 14.2
// expect output: 1.5 2.5
// expect output: 0.5 1.5

fn main() {
    const small: [Float32] = [1.0, 2.0]
    const money: [Decimal] = [1.5, 3.5]
    const a: Float32? = small.mean(x => x)
    const b: Decimal? = money.mean(x => x)
    print(`{a ?? 0.0} {b ?? 0.0}`)
    const whole: [Decimal] = [1, 2]
    const c: Float32? = small[:1].median(x => x * 0.5)
    const d: Decimal? = whole.median(x => x)
    print(`{c ?? 0.0} {d ?? 0.0}`)
}
