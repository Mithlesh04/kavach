// Rule: An exact atlas draws each glyph for its size only: each pixel holds how much of it the glyph covers, from 0 to 255, in all four parts.
// Spec: 14.31
// expect output: exact: true
// expect output: box: 8 11 1 11
// expect output: inside: 255
// expect output: half a pixel: 127

use std.base64
use std.font

/// runtime/font/src/sample.ttf: 1,000 units to the em; glyph 1 is a
/// square for `A` (700 wide), 2 a space (300), 3 a square with a hole for `B`.
fn sample() -> Font ! Error {
    const file = "AAEAAAAHAEAAAgAwY21hcAAAAAAAAAB8AAAAPGdseWYAAAAAAAAAuAAAAFpoZWFkAAAAAA" +
        "AAARQAAAA2aGhlYQAAAAAAAAFMAAAAJGhtdHgAAAAAAAABcAAAABBsb2NhAAAAAAAAAYAA" +
        "AAAUbWF4cAAAAAAAAAGUAAAABgAAAAEAAwABAAAADAAEADAAAAAIAAgAAgAAACAAQQBC//" +
        "8AAAAgAEEAQv///+L/wP/BAAEAAAAAAAAAAAABAGQAAAJYArwAAwAAAQEBAQBkAAAB9AAA" +
        "AAACvAAA/UQAAgBkAAACWAK8AAMABwAAAQEBAQEBAQEAZAAAAfQAAP6iAMgAAP84AAACvA" +
        "AA/UQAyAAAASwAAAAAAAEAAAABAAAAAAAAXw889QAAA+gAAAAAAAAAAAAAAAAAAAAAAGQA" +
        "AAJYArwAAAAIAAIAAQAAAAAAAQAAAyD/OABkArwAZABkAlgAAQAAAAAAAAAAAAAAAAAAAA" +
        "QB9ABkArwAZAEsAGQCvABkAAAAAAAAAAAAAAAiAAAAIgAAAFoAAFAAAAQAAA=="
    try font.load(try base64.decode(file))
}

fn main() ! Error {
    // The square spans 1.5 to 9 pixels across at 15 pixels to the em.
    const a = (try sample()).atlas("A", 15.0, exact: true)
    print(`exact: {a.exact}`)
    const b = a.boxes[1] ?? GlyphBox(x: 0, y: 0, width: 0, height: 0, left: 0, top: 0)
    print(`box: {b.width} {b.height} {b.left} {b.top}`)
    print(`inside: {a.image.pixels[((b.y + 5) * a.image.width + b.x + 4) * 4]}`)
    print(`half a pixel: {a.image.pixels[((b.y + 5) * a.image.width + b.x) * 4]}`)
}
