// Rule: reading calls (`read_text`, `read_bytes`, `lines`, `chunks`, `exists`, `list`, `info`, `watch`) need only `Fs.read`.
// Spec: 14.3, 8.1
// expect output: true 2 File
// expect output: 1 1 1 [] 0

use std.fs

fn look(dir: String) -> String ! FsError uses Fs.read {
    const path = `{dir}/a.txt`
    const info = try fs.info(path)
    let lines = 0
    for _ in try fs.lines(path) {
        lines += 1
    }
    let pieces = 0
    for _ in try fs.chunks(path, 64) {
        pieces += 1
    }
    const w = try fs.watch(dir)
    const first = `{fs.exists(path)} {(try fs.read_text(path)).len()} {info.kind}`
    `{first}\n{lines} {pieces} {(try fs.list(dir)).len()} {w.poll()} {(try fs.read_bytes(path)).len() - 2}`
}

fn main() ! FsError uses Fs, Console {
    const dir = "kavach-t-fs-readonly-cap"
    try fs.create_dir(dir)
    try fs.write_text(`{dir}/a.txt`, "hi")
    print(try look(dir))
    try fs.remove_all(dir)
}
