// Rule: `a.det()` gives the determinant of a square matrix: the pivots of its LU decomposition multiplied, negated for an odd number of row swaps.
// Spec: 14.33
// expect output: 5.0
// expect output: -2.0
// expect output: true
// expect output: 1.0

use std.tensor

fn main() {
    print(tensor.of_rows([[2.0, 1.0], [1.0, 3.0]]).det())
    print(tensor.of_rows([[1.0, 2.0], [3.0, 4.0]]).det())
    const d = tensor.of_rows([[6.0, 1.0, 1.0], [4.0, -2.0, 5.0], [2.0, 8.0, 7.0]]).det()
    print((d + 306.0).abs() < 1e-12)
    print(tensor.zeros<Float>([0, 0]).det())
}
