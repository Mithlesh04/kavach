// Rule: `xs.slice(start, end)` gives items `start..end`, both clamped to the list, as `String.slice` does.
// Spec: 14.2
// expect output: [20, 30]
// expect output: [10, 20]
// expect output: [40, 50]
// expect output: []
// expect output: ["b", "c"]

fn main() {
    const xs = [10, 20, 30, 40, 50]
    print(xs.slice(1, 3))
    print(xs.slice(-2, 2))
    print(xs.slice(3, 99))
    print(xs.slice(4, 2))
    print(["a", "b", "c", "d"].slice(1, 3))
}
