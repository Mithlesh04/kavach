// Rule: `xs[start:end]` gives items `start..end`, both clamped to the list: a computed start below 0 counts as the start.
// Spec: 14.2
// expect output: [20, 30]
// expect output: [10, 20]
// expect output: [40, 50]
// expect output: []
// expect output: ["b", "c"]

fn main() {
    const xs = [10, 20, 30, 40, 50]
    print(xs[1:3])
    const below = -2
    print(xs[below:2])
    print(xs[3:99])
    print(xs[4:2])
    print(["a", "b", "c", "d"][1:3])
}
