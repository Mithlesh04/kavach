// Rule: `crypto.sha256`, `crypto.sha384` and `crypto.sha512` give the digests FIPS 180-4 lists for empty input and for inputs longer than one block.
// Spec: 14.19
// expect output: Bytes(e3b0c44298fc1c149afbf4c8996fb92427ae41e4649b934ca495991b7852b855)
// expect output: Bytes(38b060a751ac96384cd9327eb1b1e36a21fdb71114be07434c0cc7bf63f6e1da274edebfe76f65fbd51ad2f14898b95b)
// expect output: Bytes(cf83e1357eefb8bdf1542850d66d8007d620e4050b5715dc83f4a921d36ce9ce47d0d13c5d85f2b0ff8318d2877eec2f63b931bd47417a81a538327af927da3e)
// expect output: Bytes(248d6a61d20638b8e5c026930c3e6039a33ce45964ff2167f6ecedd419db06c1)
// expect output: Bytes(09330c33f71147e83d192fc782cd1b4753111b173b3b05d22fa08086e3b0f712fcc7c71a557e2db966c3e9fa91746039)
// expect output: Bytes(8e959b75dae313da8cf4f72814fc143f8f7779c6eb9f7fa17299aeadb6889018501d289e4900f7e4331b99dec4b5433ac7d329eeb6dd26545e96e55b874be909)

use std.crypto

const empty = "".bytes()
print(crypto.sha256(empty))
print(crypto.sha384(empty))
print(crypto.sha512(empty))
// Two blocks of SHA-256, and two of SHA-384 and SHA-512.
print(crypto.sha256("abcdbcdecdefdefgefghfghighijhijkijkljklmklmnlmnomnopnopq".bytes()))
const long = "abcdefghbcdefghicdefghijdefghijkefghijklfghijklmghijklmnhijklmnoijklmnopjklmnopqklmnopqrlmnopqrsmnopqrstnopqrstu".bytes()
print(crypto.sha384(long))
print(crypto.sha512(long))
