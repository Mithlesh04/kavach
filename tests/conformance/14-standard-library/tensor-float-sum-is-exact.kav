// Rule: A float sum is the exact sum, rounded once, so no order changes it.
// Spec: 14.33
// expect output: 1.0
// expect output: 1.0
// expect output: [1.0, 1.0]
// expect output: 1.0

use std.tensor

fn main() {
    print(tensor.of([1e20, 1.0, -1e20]).sum())
    print(tensor.of([-1e20, 1e20, 1.0]).sum())
    print(tensor.of_rows([[1e20, 1.0], [1.0, 1e20], [-1e20, -1e20]]).sum(axis: 0).items)
    print(tensor.of([Float32(1e8), Float32(1.0), Float32(-1e8)]).sum())
}
