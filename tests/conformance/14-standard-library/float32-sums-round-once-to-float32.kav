// Rule: a `Float32` sum is rounded once, to a `Float32`, never to a `Float` on the way.
// Spec: 14.2
// expect output: 1.0000001
// expect output: 1.0
// expect output: inf

fn main() {
    // 1 + 2^-24 + 2^-80: rounded to a `Float` first, it would be a tie,
    // and 1.0; rounded once, it is above the tie.
    const xs = [Float32(1.0), Float32(5.9604644775390625e-8), Float32(8.271806125530277e-25)]
    print(xs.sum(x => x))
    print([Float32(1e20), Float32(1.0), Float32(-1e20)].sum(x => x))
    const big = Float32(3.4028234663852886e38)
    print([big, big].sum(x => x))
}
