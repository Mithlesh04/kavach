// Rule: A sound made with `audio.sound` has 1 or 2 channels; asking for 3 breaks its contract and panics.
// Spec: 14.27
// expect output: 1 2
// expect panic: contract failed

use std.audio

fn main() {
    const mono = audio.sound([0.25, -0.25], 8000, 1)
    const stereo = audio.sound([0.25, -0.25], 8000, 2)
    print(`{mono.channels} {stereo.channels}`)
    const three = [3][0]
    print(audio.sound([0.0, 0.0, 0.0], 8000, three).channels)
}
