// Rule: `post_json` sends its body with `content-type: application/json`, and `json_response` answers with the same type and the value's JSON as its body.
// Spec: 14.11
// expect output: server saw: application/json {"id":7,"item":"pen"}
// expect output: client saw: application/json {"id":7,"item":"pen"}
// expect output: decoded: Order(id: 7, item: "pen")

use std.http
use std.json
use std.net

pub type Order {
    id: Int
    item: String
}

/// Answers with what the request said, and its body back as JSON.
fn echo(r: Request) -> Response {
    const seen = "{r.header("content-type") ?? "none"} {r.body.text() ?? "?"}"
    const order = http.read_json<Order>(r) catch _ => Order(id: 0, item: seen)
    if order.id == 0 {
        return http.text(400, seen)
    }
    if r.path == "/echo" {
        print("server saw: {seen}")
    }
    http.json_response(200, json.of(order))
}

fn main() ! Error {
    const listener = try net.listen("127.0.0.1:0")
    const _server = spawn http.serve(listener, echo)
    const base = "http://{listener.address()}"
    const order = Order(id: 7, item: "pen")
    const back = try http.post_json<Order>("{base}/echo", json.of(order))
    const body = json.stringify(json.of(order), 0)
    const r = try http.request("POST", "{base}/again", headers: [Header(name: "content-type", value: "application/json")], body: body.bytes())
    print("client saw: {r.header("content-type") ?? "none"} {r.body.text() ?? "?"}")
    print("decoded: {back}")
}
