// Rule: `concatenate` needs the other sizes to match; another is a panic naming both shapes.
// Spec: 14.33
// expect panic: `concatenate` along axis 0 needs the other sizes to match: [1, 2] and [1, 3]

use std.tensor

fn main() {
    print(tensor.concatenate([tensor.zeros<Int>([1, 2]), tensor.zeros<Int>([1, 3])]).shape)
}
