// Rule: `unique()` gives each item once, and `unique_by(key)` the first item with each key, in the order first seen.
// Spec: 14.2
// expect output: [3, 1, 2]
// expect output: ["ab", "c"]
// expect output: [[], [1]]

fn main() {
    print([3, 1, 3, 2, 1].unique())
    print(["ab", "c", "de", "f"].unique_by(s => s.len()))
    print([[], [1], []].unique())
}
