// Rule: `t.norm()` is the square root of the sum of the squares of every number; `t.norm(axis:)` works along an axis.
// Spec: 14.33
// expect output: 5.0
// expect output: [5.0, 13.0]
// expect output: [3.0, 4.0]

use std.tensor

fn main() {
    print(tensor.of([3.0, 4.0]).norm())
    const m = tensor.of_rows([[3.0, 4.0], [5.0, 12.0]])
    print(m.norm(axis: 1).items)
    print(tensor.of_rows([[3.0, 0.0], [0.0, 4.0]]).norm(axis: 0).items)
}
