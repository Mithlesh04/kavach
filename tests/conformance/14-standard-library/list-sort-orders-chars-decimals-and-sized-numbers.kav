// Rule: `sort` orders characters by code point and numbers by value, for negatives, infinities, sized whole numbers and `Decimal` too.
// Spec: 14.2
// expect output: ['A', 'a', 'b', 'é']
// expect output: [-10, 0, 3] [-inf, 0.0, inf]
// expect output: [-128, 0, 127] [-1.5, 0.25, 2.50]

fn main() {
    print(['b', 'A', 'é', 'a'].sort())
    const inf = 1.0 / 0.0
    print(`{[3, -10, 0].sort()} {[inf, -inf, 0.0].sort()}`)
    const small: [Int8] = [127, -128, 0]
    const money: [Decimal] = [2.50, -1.5, 0.25]
    print(`{small.sort()} {money.sort()}`)
}
