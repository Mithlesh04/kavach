// Rule: `Tensor<U>(t)` converts each number to `U`, as `U(x)` converts one.
// Spec: 14.33
// expect output: [0.5, 1.0, 1.5]
// expect output: [1, 2]

use std.tensor

fn main() {
    const counts = tensor.of([1, 2, 3])
    print((Tensor<Float>(counts) / 2.0).items)
    print(Tensor<Int>(tensor.of([1.5, 2.25])).items)
}
