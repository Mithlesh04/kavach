// Rule: `fs.create_writer` gives a new, empty file: one already at the path is emptied before the writes, and `finish` counts only the new bytes.
// Spec: 14.3
// expect output: 3
// expect output: new

use std.fs

fn main() ! FsError uses Fs, Console {
    const dir = "kavach-t-fs-writer"
    try fs.create_dir(dir)
    const path = `{dir}/out.txt`
    try fs.write_text(path, "an old text that is longer")
    const w = try fs.create_writer(path)
    try w.write_text("new")
    print(try w.finish())
    print(try fs.read_text(path))
    try fs.remove_all(dir)
}
