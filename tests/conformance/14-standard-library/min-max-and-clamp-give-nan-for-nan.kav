// Rule: `min`, `max` and `clamp` give `NaN` when any value is `NaN`, on either side.
// Spec: 14.2
// expect output: NaN NaN NaN NaN
// expect output: NaN NaN
// expect output: 1.0 2.0

fn main() {
    const nan = 0.0 / 0.0
    print("{nan.min(1.0)} {1.0.min(nan)} {nan.max(1.0)} {1.0.max(nan)}")
    print("{nan.clamp(0.0, 1.0)} {0.5.clamp(nan, 1.0)}")
    print("{1.0.min(2.0)} {1.0.max(2.0)}")
}
