// Rule: `length()` needs a `Float` or `Float32` vector (`where T: Floating`): on a `Vec2<Int>` it is a compile error.
// Spec: 14.28
// expect compile error

use std.vec

fn main() {
    const cell: Vec2<Int> = Vec2(x: 3, y: 4)
    print(cell.length())               // error: `length` needs `T: Floating`, and `T` is `Int` here
}
