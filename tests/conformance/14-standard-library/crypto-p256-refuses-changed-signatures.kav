// Rule: `crypto.p256_verify` is false when one byte of the data or the signature changes, for another key's public key, and for an Ed25519 signature.
// Spec: 14.19
// expect output: true
// expect output: false false
// expect output: false false

use std.crypto

fn main() ! CryptoError {
    const key = crypto.p256_secret()
    const public = try crypto.p256_public(key)
    const data = "order 7".bytes()
    const sig = try crypto.p256_sign(key, data)
    print(crypto.p256_verify(public, data, sig))
    const changed = sig.slice(0, 5) + Bytes([sig[5] ^ 1]) + sig.slice(6, sig.len())
    print("{crypto.p256_verify(public, "order 8".bytes(), sig)} {crypto.p256_verify(public, data, changed)}")
    const other = try crypto.p256_public(crypto.p256_secret())
    const ed_sig = try crypto.ed25519_sign(crypto.ed25519_secret(), data)
    print("{crypto.p256_verify(other, data, sig)} {crypto.p256_verify(public, data, ed_sig)}")
}
