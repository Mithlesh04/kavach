// Rule: Logging needs no capability, so a function that only logs needs no `uses`.
// Spec: 14.12, 8.1
// expect output: INFO Refunded(order_id: 7)
// expect output: 7

use std.log

type Refunded: LogEvent {
    order_id: Int
}

pub fn refund(order_id: Int) -> Int {
    log.info(Refunded(order_id: order_id))
    order_id
}

fn main() {
    print(refund(7))
}
