// Rule: `http.serve` needs the `Net` capability, so serving from a function whose `uses` clause doesn't list it is a compile error.
// Spec: 14.11, 8.1
// expect compile error

use std.http
use std.net

fn hello(r: Request) -> Response {
    http.text(200, "hello")
}

fn run(listener: Listener) ! NetError uses Console {
    try http.serve(listener, hello)    // error: `run` uses Net, which its `uses` clause doesn't list
}

fn main() {
}
