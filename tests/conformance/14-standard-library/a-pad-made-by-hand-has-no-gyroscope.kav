// Rule: A `Pad` is a record; one made by hand has no gyroscope (`gyro` is `none`) unless it is given one.
// Spec: 14.26
// expect output: true
// expect output: (x: 0.5, y: 0.0, z: -0.5)
// expect output: 7 Test pad 0.25

use std.input

fn main() {
    const pad = Pad(id: 7, name: "Test pad", buttons: [], left: (x: 0.25, y: 0.0), right: (x: 0.0, y: 0.0), left_trigger: 0.0, right_trigger: 0.0)
    print(pad.gyro == none)
    const turning = Pad(id: 8, name: "Gyro pad", buttons: [], left: (x: 0.0, y: 0.0), right: (x: 0.0, y: 0.0), left_trigger: 0.0, right_trigger: 0.0, gyro: (x: 0.5, y: 0.0, z: -0.5))
    print(turning.gyro ?? (x: 0.0, y: 0.0, z: 0.0))
    print("{pad.id} {pad.name} {pad.left.x}")
}
