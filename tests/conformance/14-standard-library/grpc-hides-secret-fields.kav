// Rule: `grpc.encode<T>` builds JSON before its Protocol Buffers, so a `secret` field goes into the message as `"<secret>"`, never its value.
// Spec: 14.14, 8.7
// expect output: 1 <secret>

use std.grpc

pub type Order {
    id: Int
    secret card: String
}

pub type Seen {
    id: Int
    card: String
}

fn main() ! Error {
    const data = grpc.encode<Order>(Order(id: 1, card: "4111"))
    const back = try grpc.decode<Seen>(data)
    print(`{back.id} {back.card}`)
}
