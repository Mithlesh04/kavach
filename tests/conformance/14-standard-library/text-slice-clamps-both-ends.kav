// Rule: `s[start:end]` clamps both positions to the text, as a list's slice does: a computed start below 0 counts as the start, and an end before the start gives empty text; positions count characters.
// Spec: 14.2
// expect output: [ab] [] []
// expect output: [a👍] [e]

fn main() {
    const below = -2
    print(`[{"abc"[below:2]}] [{"abc"[2:1]}] [{""[:5]}]`)
    print(`[{"👍a👍"[1:3]}] [{`e\u{301}x`[:1]}]`)
}
