// Rule: `s.slice(start, end)` clamps both positions to the text, as a list's `slice` does: a start below 0 counts as 0, and an end before the start gives empty text; positions count characters.
// Spec: 14.2
// expect output: [ab] [] []
// expect output: [a👍] [e]

fn main() {
    print(`[{"abc".slice(-2, 2)}] [{"abc".slice(2, 1)}] [{"".slice(0, 5)}]`)
    print(`[{"👍a👍".slice(1, 3)}] [{`e\u{301}x`.slice(0, 1)}]`)
}
