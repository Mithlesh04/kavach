// Rule: `process.run` gives the program's exit code and what it printed: `out` and `err` hold its lines, each ending in a line break, apart from each other.
// Spec: 14.23
// expect output: 0 2 true true
// expect output: 128 true true

use std.fs
use std.process

fn main() ! Error uses Fs, Process, Console {
    const dir = "kavach-t-proc-run"
    try fs.create_dir(dir)
    try fs.write_text(`{dir}/a.txt`, `hello\n`)
    try fs.write_text(`{dir}/b.txt`, "")
    const ok = try process.run("git", ["hash-object", `{dir}/a.txt`, `{dir}/b.txt`])
    const lines = ok.out.split(`\n`)
    print(`{ok.code} {lines.len() - 1} {ok.out == `ce013625030ba8dba906f756967f9e9ca394464a\ne69de29bb2d1d6434b8b29ae775ad8c2e48c5391\n`} {ok.err.is_empty()}`)
    // A file that isn't there: git says so on standard error, with code 128.
    const bad = try process.run("git", ["hash-object", `{dir}/missing.txt`])
    print(`{bad.code} {bad.out.is_empty()} {bad.err.starts_with("fatal:") and bad.err.ends_with(`\n`)}`)
    try fs.remove_all(dir)
}
