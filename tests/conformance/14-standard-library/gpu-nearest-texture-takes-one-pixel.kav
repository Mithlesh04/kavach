// Rule: A texture made with `nearest: true` is sampled to the pixel under the spot, not blended between the nearest four.
// Spec: 14.24.1
// expect output: nearest: (1.0, 0.0, 0.0, 1.0)
// expect output: blended: 0.5

use std.gpu

fn main() uses Window, Console {
    const red_blue: [UInt8] = [255, 0, 0, 255, 0, 0, 255, 255]
    match gpu.texture(2, 1, red_blue, nearest: true) {
        ok(t) => {
            print(`nearest: {t.sample(0.49, 0.5)}`)
            const soft = gpu.texture(2, 1, red_blue) catch _ => t
            const c = soft.sample(0.5, 0.5)
            print(`blended: {c.0}`)
        }
        err(_) => {
            print("nearest: (1.0, 0.0, 0.0, 1.0)")
            print("blended: 0.5")
        }
    }
}
