// Rule: `min`, `max`, `argmin`, `argmax` and `mean` along an axis of size 0 are a panic naming the shape; `sum` gives 0 there.
// Spec: 14.33
// expect output: [0, 0]
// expect panic: `max` along axis 1 of [2, 0] has no numbers to work on

use std.tensor

fn main() {
    const t = tensor.zeros<Int>([2, 0])
    print(t.sum(axis: 1).items)
    print(t.max(axis: 1).items)
}
