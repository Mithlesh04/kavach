// Rule: A gpu fn may use std.vec's types of Float32, their operators and methods; a vertex fn's position and a fragment fn's color may be a Vec4.
// Spec: 15.3, 14.28
// expect output: Lit(position: Vec4(x: 0.25, y: 0.5, z: 0.0, w: 1.0), heat: 1.25)
// expect output: Vec4(x: 1.0, y: 0.0, z: 0.0, w: 1.0)
// expect output: [8.0, 5.0]

use std.vec

type Corner {
    x: Float32
    y: Float32
}

type Lit {
    position: Vec4<Float32>
    heat: Float32
}

gpu vertex fn place(c: Corner) -> Lit {
    const half = Mat4.scaling(Vec3(x: Float32(0.5), y: 0.5, z: 1.0))
    const p = Vec4(x: c.x, y: c.y, z: Float32(0.0), w: 1.0)
    Lit(position: half @ p, heat: Vec2(x: c.x, y: c.y).length_squared())
}

gpu fragment fn glow(l: Lit) -> Vec4<Float32> {
    Vec4(x: Float32(1.0), y: 0.0, z: 0.0, w: 1.0)
}

gpu fn size(v: Vec3<Float32>) -> Float32 {
    v.length() + v.dot(Vec3(x: 1.0, y: 0.0, z: 0.0))
}

fn main() {
    const l = place(Corner(x: 0.5, y: 1.0))
    print(l)
    print(glow(l))
    const vs: [Vec3<Float32>] = [Vec3(x: 3.0, y: 4.0, z: 0.0), Vec3(x: 0.0, y: 5.0, z: 0.0)]
    print(vs.map(v => size(v)))
}
