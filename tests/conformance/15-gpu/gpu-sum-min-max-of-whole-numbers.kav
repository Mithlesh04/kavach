// Rule: `sum`, `min` and `max` of `Int32` or `UInt32` give the CPU's answers wherever they run, and a sum that overflows panics as the CPU adds it.
// Spec: 15.2
// expect output: 24 -1 9
// expect output: 30 none
// expect panic: integer overflow: 2147483647 + 1 doesn't fit in Int32

gpu fn step(x: Int32) -> Int32 {
    x * 2 - 3
}

fn main() {
    let xs: [Int32] = [1, 2, 3, 4, 5, 6]
    xs = xs.map(step)
    print("{xs.sum(x => x)} {xs.min()} {xs.max()}")
    let us: [UInt32] = [10, 20]
    let empty: [UInt32] = []
    print("{us.sum(u => u)} {empty.min()}")
    let big: [Int32] = [2147483647, 1, -1]
    print(big.sum(x => x))
}
