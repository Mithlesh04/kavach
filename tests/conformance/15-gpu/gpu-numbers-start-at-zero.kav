// Rule: GPUs are numbered from 0, as `system.gpus()` lists them: a negative number written in `on gpu(n)` is a compile error.
// Spec: 15.6, 4.9
// expect compile error

gpu fn double(x: Float32) -> Float32 {
    x * 2.0
}

fn main() {
    const xs: [Float32] = [1.0, 2.0]
    print(on gpu(-1) xs.map(double))     // error: GPUs are numbered from 0
}
