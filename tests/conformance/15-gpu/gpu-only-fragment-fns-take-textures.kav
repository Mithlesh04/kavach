// Rule: Only a `gpu fragment fn` takes textures: a `gpu vertex fn` taking a `Texture` is a compile error.
// Spec: 15.3
// expect compile error

use std.gpu

type Corner {
    x: Float32
    y: Float32
}

type Lit {
    position: (Float32, Float32, Float32, Float32)
}

gpu vertex fn place(c: Corner, skin: Texture) -> Lit {     // error: a vertex fn takes no texture
    const s = skin.sample(c.x, c.y)
    Lit(position: (c.x, c.y, s.0, 1.0))
}

fn main() {
}
