// Rule: `map`s chained in one expression give the results of each `map` in turn, on the GPU as on the CPU, with each lambda's captured values.
// Spec: 15.2
// expect output: [3, 7, 11, 15]
// expect output: 4

gpu fn scale(x: Int32, k: Int32) -> Int32 {
    x * k
}

gpu fn shift(x: Int32, d: Int32) -> Int32 {
    x + d
}

fn main() {
    const xs: [Int32] = [1, 3, 5, 7]
    const k: Int32 = 2
    const d: Int32 = 1
    const ys = xs.map(x => scale(x, k)).map(y => shift(y, d))
    print(ys)
    print(ys.len())
}
