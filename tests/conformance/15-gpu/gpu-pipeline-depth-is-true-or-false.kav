// Rule: `depth:` of gpu.pipeline is written `true` or `false`: it is part of the pipeline, compiled before it draws.
// Spec: 15.3
// expect compile error

use std.gpu

type Corner {
    x: Float32
    y: Float32
}

type Lit {
    position: (Float32, Float32, Float32, Float32)
}

gpu vertex fn place(c: Corner) -> Lit {
    Lit(position: (c.x, c.y, 0.5, 1.0))
}

gpu fragment fn glow(l: Lit) -> (Float32, Float32, Float32, Float32) {
    (1.0, 0.0, 0.0, 1.0)
}

fn main() {
    const deep = 2 > 1
    const _ = gpu.pipeline(place, glow, depth: deep)     // error: depth: is true or false as written
}
