// Rule: A loop of `map`s feeding each result to the next gives, at the first read after the loop, every item as the CPU works it out.
// Spec: 15.2
// expect output: 107
// expect output: [100, 101, 102, 103, 104, 105, 106, 107]
// expect output: 828

gpu fn step(x: Int32) -> Int32 {
    x + 1
}

fn main() {
    let xs: [Int32] = [0, 1, 2, 3, 4, 5, 6, 7]
    for _ in 0..100 {
        xs = xs.map(step)
    }
    print(xs[7])
    print(xs)
    print(xs.sum(x => x))
}
