// Rule: A `gpu(n) fn` naming a GPU the machine doesn't have stops the program at its start, before any of its code runs.
// Spec: 15.6
// expect exit: 1

gpu(4096) fn double(x: Float32) -> Float32 {
    x * 2.0
}

fn main() {
    print("this never runs")
    const xs: [Float32] = [1.0]
    print(xs.map(double))
}
