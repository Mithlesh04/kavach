// Rule: A `gpu fn` and its `map` need no capability when the code chooses no GPU.
// Spec: 15.6
// expect output: [2.0, 4.0, 6.0]

gpu fn double(x: Float32) -> Float32 {
    x * 2.0
}

pub fn twice(xs: [Float32]) -> [Float32] {
    xs.map(double)
}

fn main() {
    const xs: [Float32] = [1.0, 2.0, 3.0]
    print(twice(xs))
}
