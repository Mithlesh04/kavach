// Rule: gpu.pipeline takes a gpu vertex fn and a gpu fragment fn, by name.
// Spec: 15.3
// expect compile error

use std.gpu

type Corner {
    x: Float32
    y: Float32
}

type Lit {
    position: (Float32, Float32, Float32, Float32)
    heat: Float32
}

fn place(c: Corner) -> Lit {
    Lit(position: (c.x, c.y, 0.0, 1.0), heat: 1.0)
}

gpu fragment fn glow(l: Lit) -> (Float32, Float32, Float32, Float32) {
    (l.heat, 0.0, 0.0, 1.0)
}

fn main() {
    const _ = gpu.pipeline(place, glow)     // error: place is not a gpu vertex fn
}
