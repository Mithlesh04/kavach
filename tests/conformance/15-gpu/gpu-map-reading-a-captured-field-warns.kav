// Rule: A GPU `map` whose lambda reads a field of a captured record runs on the CPU, and the compiler warns, naming the field; the results are the same.
// Spec: 15.2
// expect warning
// expect output: [3.0, 4.0]
// expect output: [3.0, 4.0]

type Peer {
    x: Float32
    seen: Int
}

gpu fn step(q: Float32, by: Float32) -> Float32 {
    q + by
}

fn main() {
    const peer = Peer(x: 2.0, seen: 1)
    const qs: [Float32] = [1.0, 2.0]
    print(qs.map(q => step(q, peer.x)))   // warning: reads `peer.x`, a field of a captured record
    const px = peer.x
    print(qs.map(q => step(q, px)))
}
