// Rule: `x.checked_div(y) ?? d` and `if let v = x.checked_div(y)` give the quotient each time it fits, and the fallback for a division by zero or `MIN / -1`.
// Spec: 5.6
// expect output: -3 -3074457345618258602
// expect output: 0 by zero
// expect output: 3 3074457345618258602
// expect output: 9 too big

fn main() {
    const min = -9_223_372_036_854_775_807 - 1
    const divisors = [3, 0, -3, -1]
    for d in divisors {
        const q = (-9).checked_div(d) ?? 0
        if let m = min.checked_div(d) {
            print(`{q} {m}`)
        } else if d == 0 {
            print(`{q} by zero`)
        } else {
            print(`{q} too big`)
        }
    }
}
