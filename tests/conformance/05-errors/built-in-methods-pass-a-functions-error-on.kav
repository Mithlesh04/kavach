// Rule: a built-in method given a function that can fail can fail with its error, and stops at the first one; a function that handles its errors inside can't fail.
// Spec: 5.2
// expect output: [10, 20, 30]
// expect output: stopped at 9
// expect output: [1]
// expect output: 0
// expect output: 60
// expect output: [1, 3]
// expect output: []
// expect output: 10 -1 10
// expect output: 1 -1 10
// expect output: [10, 20]
// expect output: [-9]

type E = Big(n: Int)

fn price(n: Int) -> Int ! E {
    if n > 5 {
        fail E.Big(n: n)
    }
    n * 10
}

fn main() {
    print([1, 2, 3].map(price) catch _ => [])
    const stopped = [1, 9, 3].map(x => try price(x)) catch e => match e {
        E.Big(n) => [-n],
    }
    print("stopped at {-stopped[0]}")
    print([1, 2].filter(x => try price(x) < 20) catch _ => [])
    print([1, 7].sum(x => try price(x)) catch _ => 0)
    print([1, 2, 3].sum(x => price(x) catch _ => 0))
    print([3, 1].sort_by(x => try price(x)) catch _ => [])
    print([1, 9, 3].sort_by(x => try price(x)) catch _ => [])
    const s = Shared(1)
    const first = s.update(x => try price(x)) catch _ => -1
    const second = s.update(x => try price(x)) catch _ => -1
    print("{first} {second} {s.get()}")
    const t = Shared(1)
    const old = t.update_with(x => (try price(x), x)) catch _ => -1
    const kept = t.update_with(x => (try price(x), x)) catch _ => -1
    print("{old} {kept} {t.get()}")
    print([1, 2].parallel_map(x => try price(x)) catch _ => [])
    print([1, 9, 7].parallel_map(x => try price(x)) catch e => match e {
        E.Big(n) => [-n],
    })
}
