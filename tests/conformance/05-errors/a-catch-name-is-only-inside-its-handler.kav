// Rule: The name a `catch` gives the error belongs to its handler: using it after the handler is an unknown name.
// Spec: 5.3, 1.4
// expect compile error

type Oops = Bad(code: Int)

fn check(x: Int) -> Int ! Oops {
    if x > 0 {
        fail Oops.Bad(code: x)
    }
    x
}

fn main() {
    const n = check(3) catch e => {
        print("failed: {e}")
        0
    }
    print("{n} {e}")                // error: e is not declared here
}
