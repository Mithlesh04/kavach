// Rule: Repeating empty text gives empty text, however many times: it asks for no memory, so it is not refused and ends at once.
// Spec: 5.6, 14.2
// expect output: 0
// expect output: true

fn main() {
    const nothing = "".repeat(1_000_000_000_000)
    print(nothing.len())
    print(nothing.is_empty())
}
