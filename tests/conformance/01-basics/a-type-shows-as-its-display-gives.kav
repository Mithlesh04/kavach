// Rule: A type implementing `Display` prints as its `display()` gives: with `print`, in interpolation, with `String(v)`, and inside collections and other records.
// Spec: 1.11
// expect output: (1, 2)
// expect output: at (1, 2)
// expect output: (3, 4)
// expect output: [(1, 2), (3, 4)]
// expect output: Segment(from: (1, 2), to: (3, 4))
// expect output: Plain(x: 5)

type Point: Display {
    x: Int
    y: Int

    fn display(self) -> String {
        "({self.x}, {self.y})"
    }
}

type Segment {
    from: Point
    to: Point
}

type Plain {
    x: Int
}

fn main() {
    const a = Point(x: 1, y: 2)
    const b = Point(x: 3, y: 4)
    print(a)
    print("at {a}")
    print(String(b))
    print([a, b])
    print(Segment(from: a, to: b))
    print(Plain(x: 5))
}
