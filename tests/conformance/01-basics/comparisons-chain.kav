// Rule: `a op1 b op2 c` means `a op1 b and b op2 c`: each operand once, left to right, stopping at the first false pair.
// Spec: 1.8
// expect output: true
// expect output: false
// expect output: true
// expect output: false
// expect output: seen 5
// expect output: true
// expect output: seen 5
// expect output: false
// expect output: true

fn seen(n: Int) -> Int {
    print("seen {n}")
    n
}

fn main() {
    const a = 3
    const b = 3
    const c = 3
    print(b == a == c)
    print(a == b == c != 4 < 4)
    print(1 < 2 < 3 <= 3)
    print(3 > 2 > 2)
    print(0 <= seen(5) < 10)              // `seen` runs once
    print(9 < seen(5) < seen(6))          // stops: `seen(6)` never runs
    print((a == b) == true)               // parentheses group as usual
}
