// Rule: Two names that differ only in their last character are two names, however long, for `const`, `let`, fields and functions.
// Spec: 1.4, 1.5
// expect output: 1 2
// expect output: 10 2
// expect output: 30 40
// expect output: 5 6

type Pair {
    same_: Int
    same_: Int
}

fn same_() -> Int {
    5
}

fn same_() -> Int {
    6
}

fn main() {
    let same_ = 1
    const same_ = 2
    print(`{same_} {same_}`)
    same_ = 10
    print(`{same_} {same_}`)
    const p = Pair(same_: 30, same_: 40)
    print(`{p.same_} {p.same_}`)
    print(`{same_()} {same_()}`)
}
