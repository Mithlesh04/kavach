// Rule: Text over lines leaves out the line break right after its opening backtick, and the one right before a closing backtick on a line of its own.
// Spec: 1.7
// expect output: [first
// expect output: second]
// expect output: [last line]

fn main() {
    const text = `
        first
        second
        `
    print(`[{text}]`)
    const tail = `
        last line`
    print(`[{tail}]`)
}
