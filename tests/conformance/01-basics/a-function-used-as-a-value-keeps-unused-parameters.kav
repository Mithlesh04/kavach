// Rule: A function used as a value anywhere in the program (passed, or stored) gets no warning for a parameter it never reads, as where it goes fixes its signature; a function only called does.
// Spec: 1.4, 3.4
// expect warning
// expect output: [1, 1]
// expect output: 1

fn one(n: Int) -> Int { 1 }

fn first(a: Int, b: Int) -> Int { a }

fn called(a: Int, b: Int) -> Int { a }   // warning: `b` is never used

fn main() {
    print([5, 6].map(one))
    const pick: fn(Int, Int) -> Int = first
    print(pick(called(1, 2), 3))
}
