// Rule: A `gpu fn` gets no warning for a parameter it never reads, as its parameters follow a fixed order.
// Spec: 1.4, 15.1
// expect warning
// expect output: [1.0, 1.0]

gpu fn one(x: Float32, gain: Float32) -> Float32 {
    1.0
}

fn main() {
    const xs: [Float32] = [2.0, 3.0]
    print(xs.map(x => one(x, 2.0)))
}
