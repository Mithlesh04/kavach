// Rule: A top-level `const` that names several values at once is a statement of `main`, not a module constant, so a function can't read its names.
// Spec: 1.13
// expect compile error

const (low, high) = (1, 9)

fn width() -> Int {
    high - low                      // error: made by the script's code, so a function can't read it
}

print(width())
