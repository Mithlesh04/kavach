// Rule: Lists, rings and `Bytes` compare item by item, the first pair that differs deciding, and the shorter is smaller when one runs out; lists of lists sort, and `min` and `max` take them.
// Spec: 1.8
// expect output: true true false true
// expect output: [[1, 9], [2, 1], [2, 1, 0]]
// expect output: [1, 9] [2, 1, 0]
// expect output: true false
// expect output: true
// expect output: ["ab", "b"]

fn main() {
    print("{[1, 5] < [2, 3]} {[1, 2] < [1, 2, 3]} {[2] <= [1, 9]} {[1.5] >= [1.5]}")
    const lists = [[2, 1], [1, 9], [2, 1, 0]]
    print(lists.sort())
    print("{lists.min() ?? []} {lists.max() ?? []}")
    print("{Bytes([1, 2]) < Bytes([1, 3])} {Bytes([2]) < Bytes([1, 9])}")
    let r: Ring<Int> = Ring.capacity(2)
    r.push(1)
    r.push(5)
    let s: Ring<Int> = Ring.capacity(2)
    s.push(2)
    print(r < s)
    print([["b"], ["ab"]].sort().map(xs => xs[0]))
}
