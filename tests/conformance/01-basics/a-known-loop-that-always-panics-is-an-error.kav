// Rule: In a `for` over known numbers that can't leave early, a statement that always runs is checked for the loop's values: an index past the end.
// Spec: 1.8
// expect compile error

fn main() {
    const sizes = [1, 2, 3]
    for i in 0..4 {
        print(sizes[i])    // error: this always panics: index 3 is out of range: the list has 3 items
    }
}
