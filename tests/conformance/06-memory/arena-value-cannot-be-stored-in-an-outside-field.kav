// Rule: Storing an arena value in a field of a record declared before the arena is a compile error.
// Spec: 6.3
// expect compile error

type Box {
    items: [Int]
}

fn main() {
    let b = Box(items: [])
    arena {
        const xs = [1, 2, 3]
        b.items = xs            // error: xs was made in the arena and can't be kept outside it
    }
    print(b.items)
}
