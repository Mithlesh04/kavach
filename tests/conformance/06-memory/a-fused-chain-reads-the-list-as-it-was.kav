// Rule: A chain of `map`, `filter` and `sum`, which native code fuses into one loop, gives its value from the list as it was, and changing the list afterwards leaves that value as it is.
// Spec: 6.1
// expect output: [4, 6]
// expect output: 10
// expect output: [100, 2, 3, 10]
// expect output: [4, 6] 10

fn main() {
    let xs = [1, 2, 3]
    const ys = xs.map(x => x * 2).filter(x => x > 2)
    const total = xs.map(x => x * 2).filter(x => x > 2).sum(x => x)
    print(ys)
    print(total)
    xs.push(10)
    xs[0] = 100
    print(xs)
    print(`{ys} {total}`)
}
