// Rule: Setting a slice changes the list in place, and leaves every copy taken before as it was.
// Spec: 6.1, 2.19
// expect output: [9, 8, 3, 4]
// expect output: [1, 2, 3, 4]
// expect output: [2, 3]

fn main() {
    let xs = [1, 2, 3, 4]
    const before = xs
    const part = xs[1:3]
    xs[0:2] = [9, 8]
    print(xs)
    print(before)
    print(part)
}
