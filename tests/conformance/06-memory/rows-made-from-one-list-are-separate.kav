// Rule: A list built from the same list three times holds three values, not one list three times: setting an item of one row changes only that row.
// Spec: 6.1
// expect output: [[5, 0], [0, 0], [0, 0]]
// expect output: [0, 0]

fn main() {
    const row = [0, 0]
    let grid = [row, row, row]
    grid[0][0] = 5
    print(grid)
    print(row)
}
