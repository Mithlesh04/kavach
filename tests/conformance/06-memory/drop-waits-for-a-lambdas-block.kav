// Rule: A lambda that holds a copy of a `Drop` value keeps it to the end of the block that holds the lambda, not only to the lambda's last call.
// Spec: 6.1, 3.3
// expect output: lambda says captured
// expect output: end of main
// expect output: freed captured

type Note: Drop {
    name: String

    fn drop(self) uses Console {
        print("freed {self.name}")
    }
}

fn later(n: Note) -> fn() -> String {
    () => n.name
}

fn main() {
    const get = later(Note(name: "captured"))
    print("lambda says {get()}")
    print("end of main")
}
