// Rule: The capabilities a type's `drop` uses are needed wherever a value of the type is made.
// Spec: 6.1
// expect compile error

use std.fs

type Note: Drop {
    text: String

    fn drop(self) uses Fs.read {
        const _ = fs.exists(self.text)
    }
}

pub fn make() -> String uses Net {
    const n = Note(text: "hi")  // error: `drop` uses Fs.read, which `make` doesn't list
    n.text
}
