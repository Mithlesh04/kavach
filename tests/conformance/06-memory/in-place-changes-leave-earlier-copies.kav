// Rule: A list changed in place through `inout` or as an item of a list leaves every copy taken before it as it was.
// Spec: 6.1, 3.9
// expect output: [1, 0, 1, 2]
// expect output: [1]
// expect output: [[1, 9], [2]]
// expect output: [[1], [2]]
// expect output: [1]

fn add(inout xs: [Int], n: Int) {
    xs.push(n)
}

fn main() {
    let a = [1]
    const before = a
    for i in 0..3 {
        add(a, i)
    }
    print(a)
    print(before)
    let rows = [[1], [2]]
    const old_rows = rows
    const first = rows[0]
    rows[0].push(9)
    print(rows)
    print(old_rows)
    print(first)
}
