// Rule: Cycles form only through `Shared`: a back-link made a `Weak` forms none, so nothing is reported as leaked when the program ends.
// Spec: 6.2
// expect output: hall
// expect output: done
// expect no stderr

type Room {
    name: String
    doors: Shared<[Door]>
}

type Door {
    to: Weak<Room>
}

fn main() {
    const no_doors: [Door] = []
    const hall = Shared(Room(name: "hall", doors: Shared(no_doors)))
    const back = hall.weak()
    hall.get().doors.update(doors => {
        let more = doors
        more.push(Door(to: back))
        more
    })
    for door in hall.get().doors.get() {
        if let room = door.to.shared() {
            print(room.get().name)
        }
    }
    print("done")
}
