// Rule: Match patterns can take tuples apart.
// Spec: 4.3
// expect output: origin
// expect output: on the y axis at 4
// expect output: elsewhere

fn place(point: (Int, Int)) -> String {
    match point {
        (0, 0) => "origin"
        (0, y) => "on the y axis at {y}"
        _ => "elsewhere"
    }
}

fn main() {
    print(place((0, 0)))
    print(place((0, 4)))
    print(place((2, 4)))
}
