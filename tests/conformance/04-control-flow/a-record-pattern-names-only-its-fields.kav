// Rule: A record pattern can name only the fields its record has.
// Spec: 4.3
// expect compile error

type Point {
    x: Int
    y: Int
}

fn main() {
    const p = Point(x: 1, y: 2)
    const text = match p {
        Point(x: 0, z: _) => "on the axis",     // error: `Point` has no field `z`
        _ => "elsewhere",
    }
    print(text)
}
