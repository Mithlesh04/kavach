// Rule: A `match` on text with many arms gives the value of the arm whose text is equal, top to bottom; `_` takes the rest.
// Spec: 4.3
// expect output: a: ["00000", "01101", "11010"]
// expect output: q: ["10000", "11101", "01010"]
// expect output: 5: ["11001", "00110", "10011"]
// expect output: ?: []
// expect output: 6

use std.math

/// A small font: three rows of five dots for each key.
fn glyph(c: String) -> [String] {
    match c {
        "a" => ["00000", "01101", "11010"]
        "b" => ["00111", "10100", "00001"]
        "c" => ["01110", "11011", "01000"]
        "d" => ["10101", "00010", "01111"]
        "e" => ["11100", "01001", "10110"]
        "f" => ["00011", "10000", "11101"]
        "g" => ["01010", "10111", "00100"]
        "h" => ["10001", "11110", "01011"]
        "i" => ["11000", "00101", "10010"]
        "j" => ["11111", "01100", "11001"]
        "k" => ["00110", "10011", "00000"]
        "l" => ["01101", "11010", "00111"]
        "m" => ["10100", "00001", "01110"]
        "n" => ["11011", "01000", "10101"]
        "o" => ["00010", "01111", "11100"]
        "p" => ["01001", "10110", "00011"]
        "q" => ["10000", "11101", "01010"]
        "r" => ["10111", "00100", "10001"]
        "s" => ["11110", "01011", "11000"]
        "t" => ["00101", "10010", "11111"]
        "u" => ["01100", "11001", "00110"]
        "v" => ["10011", "00000", "01101"]
        "w" => ["11010", "00111", "10100"]
        "x" => ["00001", "01110", "11011"]
        "y" => ["01000", "10101", "00010"]
        "z" => ["01111", "11100", "01001"]
        "0" => ["10110", "00011", "10000"]
        "1" => ["11101", "01010", "10111"]
        "2" => ["00100", "10001", "11110"]
        "3" => ["01011", "11000", "00101"]
        "4" => ["10010", "11111", "01100"]
        "5" => ["11001", "00110", "10011"]
        _ => []
    }
}

fn main() {
    for key in ["a", "q", "5", "?"] {
        print(`{key}: {glyph(key)}`)
    }
    print(math.gcd(12, 18))
}
