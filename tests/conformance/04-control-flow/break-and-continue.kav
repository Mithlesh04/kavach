// Rule: `continue` skips to the next iteration; `break` leaves the loop.
// Spec: 4.6
// expect output: 0
// expect output: 2
// expect output: 3

fn main() {
    for i in 0..10 {
        if i == 1 {
            continue
        }
        if i == 4 {
            break
        }
        print(i)
    }
}
