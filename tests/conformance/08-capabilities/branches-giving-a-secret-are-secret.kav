// Rule: An `if` or `match` whose branch gives a secret is secret.
// Spec: 8.7
// expect compile error

type Customer {
    name: String
    secret card: String
}

fn main() {
    const c = Customer(name: "asha", card: "4111")
    const pick = if c.name == "asha" { c.card } else { "" }
    print(pick)                                   // error: one branch gives a secret
}
