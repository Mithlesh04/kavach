// Rule: A program changes one part of a provider by wrapping it in a type of its own that implements `Provider` and passes the other methods on.
// Spec: 8.4
// expect output: https://ai.shop.example/v1/messages
// expect output: refunds
// expect output: SHOP_GATEWAY_KEY

/// Anthropic, through the shop's gateway, which wants its own header.
type Gateway: Provider {
    base: Anthropic

    fn request(self, call: AskCall) -> HttpCall {
        const r = self.base.request(call)
        let headers = r.headers
        headers["x-shop-team"] = "refunds"
        HttpCall(url: r.url, headers: headers, body: r.body)
    }
    fn check(self, model: Model) -> [String] { self.base.check(model) }
    fn key_variable(self) -> String { "SHOP_GATEWAY_KEY" }
    fn auth(self, model: Model) -> Auth { self.base.auth(model) }
    fn read(self, call: AskCall, reply: HttpReply) -> Reply { self.base.read(call, reply) }
}

fn gateway() -> Model {
    Model(name: "claude-haiku-5-5", provider: Gateway(base: Anthropic()), api_url: "https://ai.shop.example")
}

fn main() {
    const m = gateway()
    const p: Provider = m.provider ?? Anthropic()
    const r = p.request(AskCall(model: m, prompt: "?", schema: Json.Null, strict: false))
    print(r.url)
    print(r.headers.get("x-shop-team") ?? "")
    print(p.key_variable())
}
