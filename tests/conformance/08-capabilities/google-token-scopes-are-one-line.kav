// Rule: The `scope` of `Auth.GoogleToken` is text that is not empty and has no line breaks or other control characters; anything else fails the call with `Failed(status: 0, …)` before any variable is read, so no key file is read and nothing is sent.
// Spec: 8.4
// expect output: 0: `Auth.GoogleToken` needs a scope that is not empty and has no line breaks or other control characters, not "" (spec 8.4)

type Yes {
    ok: Bool
}

/// A provider for a Google service with no scope. Its address is never
/// reached: the call fails first.
type Google: Provider {
    fn check(self, model: Model) -> [String] { [] }
    fn key_variable(self) -> String { "UNUSED_AI_KEY" }
    fn auth(self, model: Model) -> Auth { Auth.GoogleToken(scope: "") }
    fn request(self, call: AskCall) -> HttpCall {
        HttpCall(url: "http://127.0.0.1:9/never", headers: {:}, body: call.prompt)
    }
    fn read(self, call: AskCall, reply: HttpReply) -> Reply {
        Reply.Problem(kind: Trouble.Other(status: reply.status), message: reply.body, wait: none)
    }
    fn price(self, model: String) -> Price? { none }
    fn count_request(self, call: AskCall) -> HttpCall? { none }
    fn read_count(self, call: AskCall, reply: HttpReply) -> Int? { none }
    fn estimate(self, call: AskCall) -> Estimate? { none }
}

fn google() -> Model {
    Model(name: "m1", provider: Google(), retries: 0)
}

fn main() {
    const y = ask<Yes>("Fine?", model: google()) catch e => {
        match e {
            AiError.Failed(status: s, message: m) => print(`{s}: {m}`),
            _ => print(`another error: {e}`),
        }
        return
    }
    print(y.ok)
}
