// Rule: A list a secret is stored in, with `xs[i] = …`, is secret.
// Spec: 8.7
// expect compile error

type Customer {
    name: String
    secret card: String
}

fn main() {
    const c = Customer(name: "asha", card: "4111")
    let cards = ["", ""]
    cards[0] = c.card
    print(cards)                                  // error: `cards` holds a secret
}
