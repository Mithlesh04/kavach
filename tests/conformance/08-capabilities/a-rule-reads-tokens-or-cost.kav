// Rule: A `limit Ai` rule reads `tokens` or `cost`, not both; one that reads both is a compile error that says to write two rules.
// Spec: 8.3
// expect compile error

type Verdict {
    ok: Bool
}

agent Reviewer {
    can Ai
    limit Ai {
        tokens <= 1_000 and cost <= 1.00 per day    // error: write two rules
    }
    on check(text: String) -> Verdict ! Error {
        try ask<Verdict>(text)
    }
}

fn main() {
    print("never")
}
