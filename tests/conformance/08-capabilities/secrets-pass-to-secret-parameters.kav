// Rule: A secret may go to a `secret` parameter, and `reveal(…)` lets one through on purpose.
// Spec: 8.7
// expect output: charged 5 to the card ending 42
// expect output: remembered 4242

type Order {
    amount: Int
    secret card: String
}

fn charge(secret card: String, amount: Int) -> String {
    const last = reveal(card).slice(2, 4)
    "charged {amount} to the card ending {last}"
}

fn remember(text: String) -> String {
    "remembered {text}"
}

fn main() {
    const o = Order(amount: 5, card: "4242")
    print(charge(o.card, o.amount))
    print(remember(reveal(o.card)))
}
