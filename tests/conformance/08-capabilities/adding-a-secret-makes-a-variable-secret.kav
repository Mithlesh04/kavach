// Rule: A variable given a secret with `+=` is secret.
// Spec: 8.7
// expect compile error

type Customer {
    name: String
    secret card: String
}

fn main() {
    const c = Customer(name: "asha", card: "4111")
    let t = "card: "
    t += c.card
    print(t)                                      // error: `t` was given a secret
}
