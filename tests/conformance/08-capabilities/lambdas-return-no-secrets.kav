// Rule: A lambda can't return a secret: its function type can't say so, so a named function with `-> secret T` does it.
// Spec: 8.7, 3.3
// expect compile error

type Order {
    secret card: String
}

fn main() {
    const o = Order(card: "4242")
    const read = () => o.card                // error: a lambda can't return a secret
    print(read().len())
}
