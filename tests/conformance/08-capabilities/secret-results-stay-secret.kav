// Rule: The result of a function marked `-> secret T` is a secret where it is called.
// Spec: 8.7
// expect compile error

type Order {
    secret card: String
}

fn card_of(o: Order) -> secret String {
    o.card
}

fn main() {
    const card = card_of(Order(card: "4242"))
    print("card {card}")                     // error: `card` is secret
}
