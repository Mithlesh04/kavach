// Rule: A secret made into new values still goes where secrets may go: a `secret` parameter, `reveal(…)`, and a lambda given to a method of a secret.
// Spec: 8.7
// expect output: 4111
// expect output: 4
// expect output: ["4111", "5500"]
// expect output: charged 4111

type Customer {
    name: String
    secret card: String
}

fn charge(secret card: String) -> String {
    `charged {reveal(card)}`
}

fn main() {
    const a = Customer(name: "asha", card: "4111")
    const b = Customer(name: "ravi", card: " 5500 ")
    const cards = [a.card, b.card.trim()]
    print(reveal(cards[0].upper()))
    print(reveal(a.card.len()))
    print(reveal(cards.map(c => c.trim())))
    print(charge(a.card.trim()))
}
