// Rule: A function that returns a secret says so with `-> secret T`; returning one without it is a compile error.
// Spec: 8.7
// expect compile error

type Order {
    secret card: String
}

fn card_of(o: Order) -> String {
    o.card                                   // error: the result isn't `secret`
}

fn main() {
    print(card_of(Order(card: "4242")))
}
