// Rule: The names a `for` takes from a secret are secret.
// Spec: 8.7
// expect compile error

type Customer {
    name: String
    secret card: String
}

fn main() {
    const a = Customer(name: "asha", card: "4111")
    const b = Customer(name: "ravi", card: "5500")
    for card in [a.card, b.card] {
        print(card)                               // error: an item of a secret list
    }
}
