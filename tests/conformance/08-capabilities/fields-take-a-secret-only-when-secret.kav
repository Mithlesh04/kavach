// Rule: A field that isn't `secret` can't be given a secret, later as when the record is made.
// Spec: 8.7
// expect compile error

type Customer {
    name: String
    secret card: String
}

type Note {
    text: String
}

fn main() {
    const c = Customer(name: "asha", card: "4111")
    let n = Note(text: "")
    n.text = c.card.trim()                        // error: `text` isn't secret
    print(n)
}
