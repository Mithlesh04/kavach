// Rule: while a function with `uses Fs("folder")` runs, every file operation in it, in what it calls and in the tasks it spawns, must be inside the folder, or it fails with `Denied`; `..` can't leave it.
// Spec: 8.1
// expect output: task: Denied(path: "kavach-scope-secret.txt")
// expect output: fine
// expect output: Denied(path: "./kavach-scope-reports/../kavach-scope-secret.txt")
// expect output: true

use std.fs

fn load(name: String) -> String ! FsError uses Fs.read("./kavach-scope-reports") {
    try fs.read_text("./kavach-scope-reports/{name}.txt")
}

fn save(name: String, text: String) -> String ! Error uses Fs("./kavach-scope-reports") {
    try fs.write_text("kavach-scope-reports/{name}.txt", text)
    const peek = spawn fs.read_text("kavach-scope-secret.txt")
    const seen = peek.wait() catch e => "task: {e}"
    seen
}

fn main() ! Error {
    try fs.create_dir("kavach-scope-reports")
    try fs.write_text("kavach-scope-secret.txt", "s3cret")
    print(try save("q1", "fine"))
    print(try load("q1"))
    const bad = load("../kavach-scope-secret") catch e => "{e}"
    print(bad)
    print(fs.exists("kavach-scope-secret.txt"))
    try fs.remove("kavach-scope-reports/q1.txt")
    try fs.remove("kavach-scope-reports")
    try fs.remove("kavach-scope-secret.txt")
}
