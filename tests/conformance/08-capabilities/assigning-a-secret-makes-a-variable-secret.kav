// Rule: A variable given a secret later, with `=`, is secret.
// Spec: 8.7
// expect compile error

type Customer {
    name: String
    secret card: String
}

fn main() {
    const c = Customer(name: "asha", card: "4111")
    let s = ""
    s = c.card
    print(s)                                      // error: `s` was given a secret
}
