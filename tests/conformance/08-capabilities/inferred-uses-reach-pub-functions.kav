// Rule: Inferred capabilities count when a `pub` function calls a private one.
// Spec: 8.1
// expect compile error

use std.fs

fn has(path: String) -> Bool {
    fs.exists(path)
}

pub fn ready() -> Bool {
    has("ready.txt")            // error: `has` uses Fs.read, so `ready` must say `uses Fs.read`
}
