// Rule: A method's result is secret when its receiver is: `card.upper()` can't be printed.
// Spec: 8.7, 2.11
// expect compile error

type Customer {
    name: String
    secret card: String
}

fn main() {
    const c = Customer(name: "asha", card: "4111")
    print(c.card.upper())                         // error: made from the secret `card`
}
