// Rule: The private `key` of `net.listen_tls` and `net.connect_tls` takes a secret, so a key kept secret needs no `reveal`.
// Spec: 8.7, 14.10
// expect output: refused: not a key

use std.net

type Tls {
    cert: String
    secret key: String
}

fn main() uses Net, Console {
    const tls = Tls(cert: "not a certificate", key: "not a key")
    const _l = net.listen_tls("127.0.0.1:0", tls.cert, tls.key) catch _ => {
        print("refused: not a key")
        return
    }
    print("listening")
}
