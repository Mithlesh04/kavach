// Rule: `uses Fs.read` allows reading files only: a function with it can't write one.
// Spec: 8.1
// expect compile error

use std.fs

fn peek(path: String) -> String ! FsError uses Fs.read {
    try fs.write_text(path, "x")    // error: `peek` uses Fs.write, which its `uses` clause doesn't list
    try fs.read_text(path)
}

fn main() {
}
