// Rule: A built-in method's parameters aren't `secret`: `name.contains(card)` is refused.
// Spec: 8.7
// expect compile error

type Customer {
    name: String
    secret card: String
}

fn main() {
    const c = Customer(name: "asha", card: "4111")
    const found = c.name.contains(c.card)         // error: a secret into `contains`
    print(reveal(found))
}
