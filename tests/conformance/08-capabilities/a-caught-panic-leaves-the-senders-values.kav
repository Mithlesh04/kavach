// Rule: when a handler's panic fails its send, the code that sent it goes on with all its own values as they were, however many sends fail.
// Spec: 8.8, 5.6
// expect output: 64836
// expect stderr: panic: index 5 is out of range: the list has 2 items
// expect stderr:   at a-caught-panic-leaves-the-senders-values.kav:15
// expect stderr: panic: index 6 is out of range: the list has 2 items
// expect stderr:   at a-caught-panic-leaves-the-senders-values.kav:15
// expect stderr: panic: index 7 is out of range: the list has 2 items
// expect stderr:   at a-caught-panic-leaves-the-senders-values.kav:15
// expect stderr: panic: index 8 is out of range: the list has 2 items
// expect stderr:   at a-caught-panic-leaves-the-senders-values.kav:15

agent Counter {
    on pick(items: [Int], at: Int) -> Int {
        items[at]
    }
}

// Five values live across every failed send: native code keeps them in
// registers the panic's unwinding must give back.
fn main() {
    const bot = Counter.start()
    let a = 1
    let b = 10
    let c = 100
    let d = 1000
    let e = 10000
    let total = 0
    for i in 0..4 {
        const got = bot.pick([1, 2], 5 + i) catch _ => 7
        total += a * i + b + c * i + d + e * i + got
        a += 1
        b += 2
        c += 3
        d += 4
        e += 5
    }
    print(total)
}
