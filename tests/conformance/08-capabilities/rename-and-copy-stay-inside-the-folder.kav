// Rule: inside `uses Fs("folder")`, both paths of `fs.rename`, `fs.copy` and `fs.symlink` must be in the folder, or the call fails with `Denied` for the one outside.
// Spec: 8.1, 14.3
// expect output: Denied(path: "kavach-scope-out.txt")
// expect output: Denied(path: "kavach-scope-out.txt")
// expect output: Denied(path: "kavach-scope-out.txt")
// expect output: true

use std.fs

fn move_out() -> String uses Fs("./kavach-scope-move") {
    fs.rename("kavach-scope-move/a.txt", "kavach-scope-out.txt") catch e => return "{e}"
    "moved"
}

fn copy_out() -> String uses Fs("./kavach-scope-move") {
    fs.copy("kavach-scope-move/a.txt", "kavach-scope-out.txt") catch e => return "{e}"
    "copied"
}

/// A link inside the folder to a file outside it would let reads out.
fn link_out() -> String uses Fs("./kavach-scope-move") {
    fs.symlink("kavach-scope-out.txt", "kavach-scope-move/link.txt") catch e => return "{e}"
    "linked"
}

fn main() ! FsError uses Fs, Console {
    try fs.create_dir("kavach-scope-move")
    try fs.write_text("kavach-scope-move/a.txt", "stay")
    print(move_out())
    print(copy_out())
    print(link_out())
    print(fs.exists("kavach-scope-move/a.txt"))
    try fs.remove_all("kavach-scope-move")
}
