// Rule: A provider's `check` runs when the program is built: each text it gives is a compile error where the model is given.
// Spec: 8.4
// expect compile error

/// A server on this machine that takes no stop text.
type Local: Provider {
    base: Anthropic

    fn check(self, model: Model) -> [String] {
        if (model.stop ?? []).is_empty() { [] } else { ["this server takes no `stop` text"] }
    }
    fn key_variable(self) -> String { "LOCAL_AI_KEY" }
    fn auth(self, model: Model) -> Auth { Auth.NoKey }
    fn request(self, call: AskCall) -> HttpCall { self.base.request(call) }
    fn read(self, call: AskCall, reply: HttpReply) -> Reply { self.base.read(call, reply) }
    fn price(self, model: String) -> Price? { none }
}

agent Sorter {
    model Model(name: "small", stop: ["END"], provider: Local(base: Anthropic()))    // error: from Local's check: this server takes no `stop` text
    can Ai
    on sort(text: String) -> Bool ! Error {
        try ask<Bool>(text)
    }
}

fn main() {
    print("never runs")
}
