// Rule: A variable given a secret anywhere in its function is secret everywhere in it: a loop comes back to the lines above.
// Spec: 8.7
// expect compile error

type Customer {
    name: String
    secret card: String
}

fn main() {
    const c = Customer(name: "asha", card: "4111")
    let last = ""
    for _ in 0..2 {
        print(last)                               // error: `last` is given a secret below
        last = c.card
    }
}
