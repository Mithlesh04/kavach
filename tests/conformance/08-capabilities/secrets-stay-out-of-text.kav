// Rule: A secret can't be interpolated into text anywhere, not only in `print`.
// Spec: 8.7
// expect compile error

type Customer {
    name: String
    secret card: String
}

fn main() {
    const c = Customer(name: "asha", card: "4242")
    const note = "card ends with {c.card}"     // error: `card` is secret
}
