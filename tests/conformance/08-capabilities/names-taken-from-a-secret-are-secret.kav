// Rule: The names an `if let` or `match` takes from a secret are secret.
// Spec: 8.7
// expect compile error

type Customer {
    name: String
    secret card: String
}

fn main() {
    const c = Customer(name: "asha", card: "4111")
    const first = [c.card].get(0)
    if let card = first {
        print(card)                               // error: taken from a secret
    }
}
