// Rule: A list of models is tried in turn, so an empty one is a compile error.
// Spec: 8.4
// expect compile error

type Verdict {
    ok: Bool
}

agent Reviewer {
    model []    // error: a list of models needs at least one model
    can Ai
    on check(text: String) -> Bool ! Error {
        (try ask<Verdict>(text)).ok
    }
}

fn main() {
    print("never runs")
}
