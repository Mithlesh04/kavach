// Rule: `reveal(value)` deliberately lets a secret through, where it would otherwise be refused.
// Spec: 8.7, 2.11
// expect output: card 4242424242424242 of Asha

type Customer {
    name: String
    secret card_number: String
}

fn main() {
    const c = Customer(name: "Asha", card_number: "4242424242424242")
    print("card {reveal(c.card_number)} of {c.name}")
}
