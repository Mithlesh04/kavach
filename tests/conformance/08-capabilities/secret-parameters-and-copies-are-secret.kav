// Rule: Inside a function, a `secret` parameter is a secret, and so is a variable set from a secret.
// Spec: 8.7
// expect compile error

type Order {
    secret card: String
}

fn charge(secret card: String) {
    const copy = card
    print("charging {copy}")                 // error: `copy` is secret
}

fn main() {
    charge(Order(card: "4242").card)
}
