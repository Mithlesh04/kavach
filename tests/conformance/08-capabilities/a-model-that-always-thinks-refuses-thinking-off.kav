// Rule: `thinking: false` on a model that always thinks first (`claude-opus-5-5`) is a compile error.
// Spec: 8.4
// expect compile error

agent Reviewer {
    model Model(name: "claude-opus-5-5", thinking: false)    // error: always thinks before it answers
    can Ai
    on check(text: String) -> Bool ! Error {
        try ask<Bool>(text)
    }
}

fn main() {
    print("never runs")
}
