// Rule: A function may only call functions whose capabilities it also has.
// Spec: 8.1
// expect compile error

use std.fs

fn has(path: String) -> Bool uses Fs.read {
    fs.exists(path)
}

pub fn work() -> Bool uses Net {
    has("notes.txt")            // error: `has` uses Fs.read, which `work` doesn't list
}
