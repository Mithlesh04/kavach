// Rule: Calling a method needs the capabilities the method uses, as calling a function does.
// Spec: 8.1
// expect compile error

use std.fs

type Note {
    path: String

    fn saved(self) -> Bool uses Fs.read {
        fs.exists(self.path)
    }
}

pub fn work(n: Note) -> Bool uses Net {
    n.saved()                   // error: `saved` uses Fs.read, which `work` doesn't list
}
