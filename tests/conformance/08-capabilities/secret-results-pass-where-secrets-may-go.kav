// Rule: A secret result goes on to `secret` parameters, other `-> secret` functions and `reveal`.
// Spec: 8.7
// expect output: charged 4 digits
// expect output: card 4242

type Order {
    secret card: String
}

fn card_of(o: Order) -> secret String {
    o.card
}

fn checked(o: Order) -> secret String {
    const card = card_of(o)
    if card.is_empty() {
        return "none"
    }
    return card
}

fn charge(secret card: String) -> Int {
    card.len()
}

fn main() {
    const o = Order(card: "4242")
    print("charged {charge(checked(o))} digits")
    print("card {reveal(card_of(o))}")
}
