// Rule: A tagged template reads escapes as every template does: `\n`, `\t`, `\{` for a brace, `` \` `` for a backtick; and it spans lines when its text starts on the line after the backtick.
// Spec: 10.15
// expect output: select '{a}', `b` from t
// expect output: where x =	$1
// expect output: select 1
// expect output:   from t

pub type Query {
    text: String
    params: [Int] = []
}

pub literal sql: Query check check_sql param pg_param

fn check_sql(text: String) -> [LiteralProblem] {
    []
}

fn pg_param(n: Int) -> String {
    `${n}`
}

fn main() {
    const q = sql`select '\{a}', \`b\` from t\nwhere x =\t{7}`
    print(q.text)
    const lines = sql`
        select 1
          from t
        `
    print(lines.text)
}
