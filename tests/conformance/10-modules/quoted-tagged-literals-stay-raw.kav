// Rule: A tagged literal in quotes stays exactly what is written, `{…}` and backslashes too, even when its tag takes parameters; its `params` is empty.
// Spec: 10.15
// expect output: select '{owner}' from t where p = 'C:\tmp'
// expect output: []

pub type Query {
    text: String
    params: [Int] = []
}

pub literal sql: Query check check_sql param pg_param

fn check_sql(text: String) -> [LiteralProblem] {
    []
}

fn pg_param(n: Int) -> String {
    `${n}`
}

fn main() {
    const q = sql"select '{owner}' from t where p = 'C:\tmp'"
    print(q.text)
    print(q.params)
}
