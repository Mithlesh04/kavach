// Rule: A library loaded while running is opened and called inside `unsafe`, as any C function is.
// Spec: 10.7
// expect compile error

extern c library Adder {
    fn add(a: Int32, b: Int32) -> Int32
}

fn main() ! LibraryError {
    const lib = unsafe { try Adder.open("adder") }
    print(lib.add(2, 3))      // error: `add` is a C function: call it inside `unsafe`
}
