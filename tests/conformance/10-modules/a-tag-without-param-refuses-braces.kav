// Rule: A tag that names no `param` function takes no parameters: a `{…}` in its tagged template is a compile error.
// Spec: 10.15
// expect compile error

pub type Query {
    text: String
}

pub literal sql: Query check check_sql

fn check_sql(text: String) -> [LiteralProblem] {
    []
}

fn main() {
    const owner = "asha"
    const q = sql`select id from orders where owner = {owner}`     // error: sql takes no parameters
    print(q.text)
}
