<?xml version="1.0" encoding="utf-8"?>
<!-- A small chip written by hand for kavach-svd's tests: one register
     of each kind the tool reads, and the parts it skips. -->
<device schemaVersion="1.3" xmlns:xs="http://www.w3.org/2001/XMLSchema-instance">
  <name>TESTCHIP</name>
  <size>32</size>
  <access>read-write</access>
  <resetValue>0x00000000</resetValue>
  <peripherals>
    <peripheral>
      <name>GPIOA</name>
      <description>General-purpose
        I/O &amp; pins</description>
      <baseAddress>0x48000000</baseAddress>
      <registers>
        <register>
          <name>MODER</name>
          <description>Mode register.</description>
          <addressOffset>0x00</addressOffset>
          <resetValue>0xA8000000</resetValue>
          <fields>
            <field><name>MODER0</name><bitOffset>0</bitOffset><bitWidth>2</bitWidth></field>
            <field><name>MODER5</name><bitRange>[11:10]</bitRange></field>
          </fields>
        </register>
        <register>
          <name>IDR</name>
          <addressOffset>0x10</addressOffset>
          <access>read-only</access>
          <fields>
            <field><name>IDR5</name><bitOffset>5</bitOffset><bitWidth>1</bitWidth></field>
          </fields>
        </register>
        <register>
          <name>ODR</name>
          <addressOffset>0x14</addressOffset>
          <fields>
            <field><name>ODR5</name><lsb>5</lsb><msb>5</msb></field>
            <field><name>IN</name><description>A keyword as a name</description><bitOffset>8</bitOffset><bitWidth>4</bitWidth><access>read-only</access></field>
          </fields>
        </register>
        <register>
          <name>BSRR</name>
          <addressOffset>0x18</addressOffset>
          <access>write-only</access>
          <resetValue>0x00000100</resetValue>
          <fields>
            <field><name>BS5</name><bitOffset>5</bitOffset><bitWidth>1</bitWidth></field>
            <field><name>BR</name><bitOffset>16</bitOffset><bitWidth>4</bitWidth></field>
          </fields>
        </register>
      </registers>
    </peripheral>
    <peripheral derivedFrom="GPIOA">
      <name>GPIOB</name>
      <baseAddress>0x48000400</baseAddress>
    </peripheral>
    <peripheral>
      <name>UART_1</name>
      <baseAddress>0x40004400</baseAddress>
      <registers>
        <register>
          <name>DR</name>
          <addressOffset>0x4</addressOffset>
          <size>8</size>
          <fields>
            <field><name>DATA</name><bitRange>[7:0]</bitRange></field>
          </fields>
        </register>
        <register>
          <name>BRR</name>
          <addressOffset>0x8</addressOffset>
          <size>16</size>
          <fields>
            <field><name>DIV</name><bitRange>[15:4]</bitRange></field>
            <field><name>FRAC</name><bitRange>[3:0]</bitRange></field>
          </fields>
        </register>
        <register>
          <name>STAMP</name>
          <addressOffset>0x10</addressOffset>
          <size>64</size>
          <fields>
            <field><name>HIGH</name><bitRange>[63:32]</bitRange></field>
          </fields>
        </register>
        <register>
          <dim>2</dim>
          <dimIncrement>4</dimIncrement>
          <name>CH%s</name>
          <addressOffset>0x20</addressOffset>
          <fields>
            <field>
              <name>EN</name><bitOffset>0</bitOffset><bitWidth>1</bitWidth>
              <enumeratedValues>
                <enumeratedValue><name>OFF</name><value>0</value></enumeratedValue>
                <enumeratedValue><name>ON</name><value>1</value></enumeratedValue>
              </enumeratedValues>
            </field>
          </fields>
        </register>
        <cluster>
          <name>FIFO</name>
          <addressOffset>0x40</addressOffset>
        </cluster>
      </registers>
    </peripheral>
  </peripherals>
</device>
