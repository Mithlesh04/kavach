// One big map split across the GPUs (spec 15.6, decision 0144): 4
// million Float32 items, each through 4,000 steps of a multiply-add,
// five times, each on a new list in main memory, so none is already in
// one GPU's memory. Compare with KAVACH_GPU_SPLIT=off (one GPU).
use std.time

gpu fn glow(x: Float32, gain: Float32) -> Float32 {
    let v = x
    for _ in 0..4000 {
        v = v * 0.999 + gain
    }
    v
}

fn main() {
    const gain: Float32 = 0.25
    for round in 0..6 {
        let xs: [Float32] = []
        for i in 0..4000000 {
            xs.push(Float32((i + round) % 1000) * 0.001)
        }
        const t0 = time.monotonic_ms()
        // A map on the GPU doesn't wait for its kernel (decision 0061):
        // the timer ends with a read, which waits and brings it back.
        const ys = xs.map(p => glow(p, gain))
        const last = ys[3999999]
        print(`round {round}: {time.monotonic_ms() - t0} ms, {last} {ys.sum(y => y)}`)
    }
}
