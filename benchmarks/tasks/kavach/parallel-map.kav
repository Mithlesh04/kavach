use std.time

// Work that only computes: a sum over 150 million rounds.
fn work(seed: Int) -> Int {
    let total = 0
    for i in 0..150_000_000 {
        total = (total + i * seed) % 1_000_000_007
    }
    total
}

fn main() {
    const seeds = [1, 2, 3, 4, 5, 6, 7, 8]
    const t0 = time.monotonic_ms()
    const one_by_one = seeds.map(s => work(s))
    const t1 = time.monotonic_ms()
    const parallel = seeds.parallel_map(s => work(s))
    const t2 = time.monotonic_ms()
    print(one_by_one == parallel)
    print("one by one {t1 - t0} ms, parallel_map {t2 - t1} ms")
}
