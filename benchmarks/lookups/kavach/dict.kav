// Single reads from a large map: 20 million lookups at keys a Lehmer
// generator picks, over 2 million entries.
fn main() {
    let m: [Int: Int] = [:]
    for i in 0..2_000_000 {
        m[i] = i * 2 + 1
    }
    let j = 12345
    let total = 0
    for _ in 0..20_000_000 {
        j = j * 48271 % 2147483647
        total += m[j % 2_000_000] ?? 0
    }
    print(total)
}
