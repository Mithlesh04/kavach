// Conditions: an if/else chain decided 200 million times.
fn main() {
    let total = 0
    for i in 0..200_000_000 {
        const x = i % 7
        if x == 0 {
            total += 3
        } else if x < 3 {
            total += x
        } else if x == 5 {
            total -= 1
        } else {
            total += 2
        }
    }
    print(total)
}
