// 10,000 round trips over TCP on this machine: a client task sends 8
// bytes, the server task sends them back. Each trip waits for the
// network twice, so the time is mostly how fast a waiting task wakes.
use std.net

fn serve(listener: Listener) -> Int ! NetError uses Net {
    const conn = try listener.accept()
    let trips = 0
    while true {
        const data = (try conn.read()) ?? break
        try conn.write(data)
        trips += 1
    }
    trips
}

fn main() ! Error {
    const listener = try net.listen("127.0.0.1:0")
    const server = spawn serve(listener)
    const conn = try net.connect(listener.address())
    const ping = "pingpong".bytes()
    let back = 0
    for _ in 0..10_000 {
        try conn.write(ping)
        back += ((try conn.read()) ?? Bytes([])).len()
    }
    conn.close()
    print("{try server.wait()} trips, {back} bytes back")
}
