// Records: create 10 million points in a list, then read their fields.
type Point {
    x: Int
    y: Int
}

fn main() {
    let points: [Point] = []
    for i in 0..10_000_000 {
        points.push(Point(x: i % 100, y: i % 7))
    }
    let total = 0
    for p in points {
        total += p.x * p.y
    }
    print(total)
}
