{
 "id": "triangle-kind",
 "given": "",
 "signature": "def triangle(a: int, b: int, c: int) -> str",
 "tests": [
  {
   "call": "triangle(2, 2, 2)",
   "prints": "equilateral"
  },
  {
   "call": "triangle(2, 2, 3)",
