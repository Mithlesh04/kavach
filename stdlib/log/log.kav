// std.log (spec 14.12): log events are records the program defines, not
// strings. Written in Kavach; the runtime writes each line (`log_write`).
// Logging needs no capability: where events go is set by the program's
// owner, in `kavach.toml`, not by the code that writes them. Spans
// (`log.span(name) { … }`, spec 4.8) and metrics go to the collector of
// `[log.otlp]` too (decision 0107).

use std.log

/// A type whose values can be logged: `type OrderPlaced: LogEvent { … }`.
/// An event is written in its printed form (spec 1.11), so secret fields
/// show as `<secret>`, and a type can choose its own form with `Display`.
pub interface LogEvent {}

/// Writes `event` at level `debug`: details for finding a problem. Left
/// out unless `kavach.toml` sets the level to `debug`.
pub fn debug<E: LogEvent>(event: E) {
    write(0, event)
}

/// Writes `event` at level `info`: what the program did.
pub fn info<E: LogEvent>(event: E) {
    write(1, event)
}

/// Writes `event` at level `warn`: something unexpected that the program
/// handled.
pub fn warn<E: LogEvent>(event: E) {
    write(2, event)
}

/// Writes `event` at level `error`: something failed.
pub fn error<E: LogEvent>(event: E) {
    write(3, event)
}

/// The name of a level as the console shows it.
fn level_name(level: Int) -> String
    example level_name(0) == "DEBUG"
    example level_name(3) == "ERROR"
{
    match level {
        0 => "DEBUG",
        1 => "INFO",
        2 => "WARN",
        _ => "ERROR",
    }
}

/// One line per event, written where `[log]` in `kavach.toml` says (the
/// console unless it says otherwise), unless below the lowest level for
/// the event's type (the runtime knows it from `event`).
fn write<E: LogEvent>(level: Int, event: E) {
    log_write(level, "{level_name(level)} {event}", event)
}

/// Adds `n` to the counter `name`, sent as an OpenTelemetry sum; each
/// set of `attributes` is a series of its own.
pub fn count(name: String, n: Int, attributes: [String: String] = [:])
    require n >= 0
{
    log.metric_id(0, series(name, attributes), Float(n))
}

/// The latest `value` of `name`, such as a queue's length.
pub fn gauge(name: String, value: Float, attributes: [String: String] = [:]) {
    log.metric_id(1, series(name, attributes), value)
}

/// One more `value` of `name`, whose spread is sent as a histogram.
pub fn histogram(name: String, value: Float, attributes: [String: String] = [:]) {
    log.metric_id(2, series(name, attributes), value)
}

/// A series as the runtime takes it: the name, then each attribute's key
/// and value, apart by a character no name holds.
fn series(name: String, attributes: [String: String]) -> String
    example series("hits", [:]) == "hits"
    example series("hits", ["route": "/a"]) == "hits\u{1}route\u{1}/a"
{
    let out = name
    for (key, value) in attributes {
        out += "\u{1}{key}\u{1}{value}"
    }
    out
}

/// Renames the current span, once the code knows what it does (a route's
/// pattern, `GET /orders/{id}`, never a path with ids in it); outside a
/// span it does nothing.
pub fn name_span(name: String) {
    log.name_span_id(name)
}

/// The current trace's id, 32 hexadecimal digits; none outside a span.
pub fn trace_id() -> String? {
    some_text(log.trace_id_text())
}

/// The current span's W3C `traceparent` header; none outside a span.
pub fn traceparent() -> String? {
    some_text(log.traceparent_text())
}

/// `text`, or none when it is empty.
fn some_text(text: String) -> String?
    example some_text("") == none
    example some_text("ab") == "ab"
{
    if text.is_empty() {
        return none
    }
    text
}

