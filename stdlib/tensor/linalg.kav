// std.tensor.linalg (spec 14.33, decision 0136): `inv`, `solve` and `det`
// of matrices, tensors of two dimensions, of floats. Each uses LU
// decomposition with partial pivoting, in one fixed order of `+ - * /`,
// never fused, so its result has the same bits on every machine
// (decision 0122). `eig` and `svd` are in `decompose.kav`; `norm` is a
// reduction, in `reduce.kav`.

use std.tensor.{Tensor, Singular}

extend<T> Tensor<T> {
    /// The inverse of a square matrix; `Singular` when it has none.
    pub fn inv(self) -> Tensor<T> ! Singular where T: Floating {
        const n = square(self, "inv")
        const lu = factor(self.items, n)
        if lu.zero_at != none {
            fail Singular(shape: self.shape)
        }
        let unit: [T] = []
        for i in 0..n * n {
            unit.push(if i % (n + 1) == 0 { T(1) } else { T(0) })
        }
        Tensor(shape: [n, n], items: solved(lu, unit, n, n))
    }

    /// The `x` with `self @ x == b`, for a square matrix and a `b` of 1 or
    /// 2 dimensions, without working out the inverse; `Singular` when the
    /// matrix has no inverse.
    pub fn solve(self, b: Tensor<T>) -> Tensor<T> ! Singular where T: Floating {
        const n = square(self, "solve")
        if b.shape.len() < 1 or b.shape.len() > 2 or b.shape[0] != n {
            panic(`\`solve\` needs a \`b\` of 1 or 2 dimensions whose first size is {self.shape}'s ({n}), and has {b.shape}`)
        }
        const lu = factor(self.items, n)
        if lu.zero_at != none {
            fail Singular(shape: self.shape)
        }
        const m = if b.shape.len() == 1 { 1 } else { b.shape[1] }
        Tensor(shape: b.shape, items: solved(lu, b.items, n, m))
    }

    /// The determinant of a square matrix: its pivots multiplied in order,
    /// negated for an odd number of row swaps; 0.0 when a pivot is 0.
    pub fn det(self) -> T where T: Floating {
        const n = square(self, "det")
        const lu = factor(self.items, n)
        if lu.zero_at != none {
            return T(0)
        }
        let d = T(1)
        for k in 0..n {
            d = d * lu.items[k * n + k]
        }
        if lu.swaps % 2 == 1 { T(0) - d } else { d }
    }
}

/// An LU decomposition with partial pivoting, `L` below the diagonal
/// (its ones not kept) and `U` on and above it, both in `items`: the rows
/// in `order`, after `swaps` swaps. `zero_at` is the first column whose
/// pivot was exactly 0, where the work stopped.
type Lu<T> {
    items: [T]
    order: [Int]
    swaps: Int
    zero_at: Int?
}

/// `n` for a square matrix `t`, `n` × `n`; another shape is a panic
/// naming it.
fn square<T>(t: Tensor<T>, what: String) -> Int {
    if t.shape.len() != 2 {
        panic(`\`{what}\` needs a matrix, of 2 dimensions, and {t.shape} has {t.shape.len()}`)
    }
    if t.shape[0] != t.shape[1] {
        panic(`\`{what}\` needs a square matrix, and has shape {t.shape}`)
    }
    t.shape[0]
}

/// How far `x` is from 0, its sign dropped.
fn size_of<T: Number>(x: T) -> T
    example size_of(-2.0) == 2.0
{
    if x < T(0) { T(0) - x } else { x }
}

/// The LU decomposition of the `n` × `n` matrix `a`. At each column the
/// pivot is the first number of largest size on or below the diagonal;
/// each row below loses `l` times the pivot's row, `l` its number over
/// the pivot.
fn factor<T: Number>(a: [T], n: Int) -> Lu<T>
    require a.len() == n * n
    example factor([2.0, 1.0, 1.0, 3.0], 2).items == [2.0, 1.0, 0.5, 2.5]
    example factor([1.0, 2.0, 3.0, 4.0], 2).order == [1, 0]
    example factor([1.0, 2.0, 2.0, 4.0], 2).zero_at == 1
{
    let lu = Lu(items: a, order: (0..n).to_list(), swaps: 0, zero_at: none)
    for k in 0..n {
        let p = k
        for i in k + 1..n {
            if size_of(lu.items[i * n + k]) > size_of(lu.items[p * n + k]) {
                p = i
            }
        }
        if lu.items[p * n + k] == T(0) {
            lu.zero_at = k
            return lu
        }
        if p != k {
            for j in 0..n {
                const keep = lu.items[k * n + j]
                lu.items[k * n + j] = lu.items[p * n + j]
                lu.items[p * n + j] = keep
            }
            const at = lu.order[k]
            lu.order[k] = lu.order[p]
            lu.order[p] = at
            lu.swaps += 1
        }
        const pivot = lu.items[k * n + k]
        for i in k + 1..n {
            const l = lu.items[i * n + k] / pivot
            lu.items[i * n + k] = l
            for j in k + 1..n {
                lu.items[i * n + j] = lu.items[i * n + j] - l * lu.items[k * n + j]
            }
        }
    }
    lu
}

/// The `x` with `a @ x == b`, `a` given by its decomposition `lu` (with no
/// zero pivot), `b` and `x` `n` × `m`, row by row: `b`'s rows put in
/// `lu.order`, then `L` and `U` undone, each sum in order.
fn solved<T: Number>(lu: Lu<T>, b: [T], n: Int, m: Int) -> [T]
    require b.len() == n * m and lu.zero_at == none
    example solved(factor([2.0, 1.0, 1.0, 3.0], 2), [3.0, 5.0], 2, 1) == [0.8, 1.4]
{
    let x: [T] = []
    for i in 0..n {
        x += b[lu.order[i] * m:(lu.order[i] + 1) * m]
    }
    for k in 0..n {
        for i in k + 1..n {
            const l = lu.items[i * n + k]
            for j in 0..m {
                x[i * m + j] = x[i * m + j] - l * x[k * m + j]
            }
        }
    }
    for i in (0..n).to_list()[::-1] {
        for j in 0..m {
            let s = x[i * m + j]
            for c in i + 1..n {
                s = s - lu.items[i * n + c] * x[c * m + j]
            }
            x[i * m + j] = s / lu.items[i * n + i]
        }
    }
    x
}
