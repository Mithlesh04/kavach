// std.tensor.ops (spec 14.33, decision 0136): a tensor's operators, item
// by item after broadcasting (NumPy's rules), each implemented twice: for
// a tensor on the right and for a number (spec 2.16). Comparisons give a
// mask, a `Tensor<Bool>`, and masks combine with `&`, `|` and `~`.
// Products go through `std.matrix`.

use std.matrix
use std.tensor.shapes

extend<T> Tensor<T>: Add<Tensor<T>>, Add<T>, Sub<Tensor<T>>, Sub<T>, Mul<Tensor<T>>, Mul<T>, Div<Tensor<T>>, Div<T>, Rem<Tensor<T>>, Rem<T>, Pow<Tensor<T>>, Pow<T>, Neg, MatMul, Compare<Tensor<T>, Tensor<Bool>>, Compare<T, Tensor<Bool>>, BitAnd<Tensor<T>>, BitAnd<T>, BitOr<Tensor<T>>, BitOr<T>, BitNot {
    pub fn add(self, other: Tensor<T>) -> Tensor<T> where T: Number {
        each(self, other, "+", (a, b) => a + b)
    }

    pub fn add(self, other: T) -> Tensor<T> where T: Number {
        self.map(x => x + other)
    }

    pub fn sub(self, other: Tensor<T>) -> Tensor<T> where T: Number {
        each(self, other, "-", (a, b) => a - b)
    }

    pub fn sub(self, other: T) -> Tensor<T> where T: Number {
        self.map(x => x - other)
    }

    pub fn mul(self, other: Tensor<T>) -> Tensor<T> where T: Number {
        each(self, other, "*", (a, b) => a * b)
    }

    pub fn mul(self, other: T) -> Tensor<T> where T: Number {
        self.map(x => x * other)
    }

    pub fn div(self, other: Tensor<T>) -> Tensor<T> where T: Number {
        each(self, other, "/", (a, b) => a / b)
    }

    pub fn div(self, other: T) -> Tensor<T> where T: Number {
        self.map(x => x / other)
    }

    pub fn rem(self, other: Tensor<T>) -> Tensor<T> where T: Number {
        each(self, other, "%", (a, b) => a % b)
    }

    pub fn rem(self, other: T) -> Tensor<T> where T: Number {
        self.map(x => x % other)
    }

    pub fn pow(self, other: Tensor<T>) -> Tensor<T> where T: Number {
        each(self, other, "**", (a, b) => a ** b)
    }

    pub fn pow(self, other: T) -> Tensor<T> where T: Number {
        self.map(x => x ** other)
    }

    pub fn neg(self) -> Tensor<T> where T: Number {
        self.map(x => -x)
    }

    pub fn lt(self, other: Tensor<T>) -> Tensor<Bool> where T: Number {
        each(self, other, "<", (a, b) => a < b)
    }

    pub fn lt(self, other: T) -> Tensor<Bool> where T: Number {
        self.map(x => x < other)
    }

    pub fn le(self, other: Tensor<T>) -> Tensor<Bool> where T: Number {
        each(self, other, "<=", (a, b) => a <= b)
    }

    pub fn le(self, other: T) -> Tensor<Bool> where T: Number {
        self.map(x => x <= other)
    }

    pub fn gt(self, other: Tensor<T>) -> Tensor<Bool> where T: Number {
        each(self, other, ">", (a, b) => a > b)
    }

    pub fn gt(self, other: T) -> Tensor<Bool> where T: Number {
        self.map(x => x > other)
    }

    pub fn ge(self, other: Tensor<T>) -> Tensor<Bool> where T: Number {
        each(self, other, ">=", (a, b) => a >= b)
    }

    pub fn ge(self, other: T) -> Tensor<Bool> where T: Number {
        self.map(x => x >= other)
    }

    /// `m & n`: both, item by item, after broadcasting; the bits of whole
    /// numbers.
    pub fn bit_and(self, other: Tensor<T>) -> Tensor<T> where T: BitAnd {
        each(self, other, "&", (a, b) => a & b)
    }

    pub fn bit_and(self, other: T) -> Tensor<T> where T: BitAnd {
        self.map(x => x & other)
    }

    /// `m | n`: either, item by item, after broadcasting.
    pub fn bit_or(self, other: Tensor<T>) -> Tensor<T> where T: BitOr {
        each(self, other, "|", (a, b) => a | b)
    }

    pub fn bit_or(self, other: T) -> Tensor<T> where T: BitOr {
        self.map(x => x | other)
    }

    /// `~m`: each `Bool` turned over; each whole number's bits.
    pub fn bit_not(self) -> Tensor<T> where T: BitNot {
        self.map(x => ~x)
    }

    /// A mask: whether each number equals `other`'s, after broadcasting.
    pub fn eq(self, other: Tensor<T>) -> Tensor<Bool> {
        each(self, other, "eq", (a, b) => a == b)
    }

    /// A mask: whether each number differs from `other`'s.
    pub fn ne(self, other: Tensor<T>) -> Tensor<Bool> {
        each(self, other, "ne", (a, b) => a != b)
    }

    /// Each number limited to `lo..=hi`, as a number's `clamp`.
    pub fn clamp(self, lo: T, hi: T) -> Tensor<T> where T: Number {
        if lo > hi {
            panic(`\`clamp\` needs \`lo\` at most \`hi\`, and has {lo} and {hi}`)
        }
        self.map(x => if lo != lo { lo } else if hi != hi { hi } else if x < lo { lo } else if x > hi { hi } else { x })
    }

    /// `a @ b`: the matrix product, each number adding its products in
    /// order, so every machine gives the same bits.
    pub fn matmul(self, other: Tensor<T>) -> Tensor<T> where T: Number {
        product(self, other, false)
    }

    /// The same product; with `fast`, floats go through `gemm`, as fast as
    /// the machine allows, and may differ in their last bits.
    pub fn matmul(self, other: Tensor<T>, fast: Bool) -> Tensor<T> where T: Number {
        product(self, other, fast)
    }
}

/// The matrix product of the last two dimensions, as NumPy's `matmul`. A
/// 1-D `a` is a row and a 1-D `b` a column, that dimension taken out of
/// the result; the dimensions before the last two are a batch, broadcast
/// as `+` broadcasts.
fn product<T: Number>(a: Tensor<T>, b: Tensor<T>, fast: Bool) -> Tensor<T> {
    if a.shape.len() == 0 or b.shape.len() == 0 {
        panic(`\`@\` needs tensors of 1 dimension or more: {a.shape} and {b.shape}`)
    }
    const sa = if a.shape.len() == 1 { [1, a.shape[0]] } else { a.shape }
    const sb = if b.shape.len() == 1 { [b.shape[0], 1] } else { b.shape }
    const (na, nb) = (sa.len(), sb.len())
    const (m, k, k2, p) = (sa[na - 2], sa[na - 1], sb[nb - 2], sb[nb - 1])
    if k != k2 {
        const which = if b.shape.len() == 1 { "size" } else { "next to last" }
        panic(`\`@\` needs {a.shape}'s last size ({k}) to match {b.shape}'s {which} ({k2})`)
    }
    const batch = shapes.broadcast(sa[:na - 2], sb[:nb - 2]) ?? panic(shapes.no_broadcast(sa[:na - 2], sb[:nb - 2], "@"))
    const xa = shapes.spread(sa, a.items, batch + [m, k])
    const xb = shapes.spread(sb, b.items, batch + [k, p])
    let out: [T] = []
    for at in 0..shapes.sized(batch) {
        if k == 0 {
            for _ in 0..m * p {
                out.push(T(0))
            }
            continue
        }
        const left = matrix.Matrix(rows: m, cols: k, items: xa[at * m * k:(at + 1) * m * k])
        const right = matrix.Matrix(rows: k, cols: p, items: xb[at * k * p:(at + 1) * k * p])
        out += left.product(right, fast: fast).items
    }
    let shape = batch
    if a.shape.len() > 1 {
        shape.push(m)
    }
    if b.shape.len() > 1 {
        shape.push(p)
    }
    Tensor(shape: shape, items: out)
}

/// `f(x, y)` for each pair of numbers of `a` and `b`, broadcast to one
/// shape; `op` names the operator in a panic.
fn each<T, U>(a: Tensor<T>, b: Tensor<T>, op: String, f: fn(T, T) -> U) -> Tensor<U> {
    const out = shapes.broadcast(a.shape, b.shape) ?? panic(shapes.no_broadcast(a.shape, b.shape, op))
    const (xa, xb) = (shapes.spread(a.shape, a.items, out), shapes.spread(b.shape, b.items, out))
    let items: [U] = []
    for i in 0..xa.len() {
        items.push(f(xa[i], xb[i]))
    }
    Tensor(shape: out, items: items)
}
