// std.table.csv (spec 14.34): CSV read and written by RFC 4180, strict
// as JSON decoding is. A row type's columns come from its JSON Schema
// (`json.schema<R>()`, spec 2.12). Each row's cells are read straight
// into the row by `json.decode_texts`, each as its field's type reads
// text, with its defaults and invariants; and written by `json.encode_texts`,
// each as `print` writes it.

use std.json
use std.fs

/// What reading a CSV does with a column the row type has no field for:
/// `Refuse` makes it an `Unknown`; `Ignore` skips it.
pub type CsvUnknown = Refuse | Ignore

/// Why a CSV could not be read or written (spec 14.34).
pub type CsvError = File(error: FsError) |
    Syntax(line: Int, message: String) |
    Missing(column: String) |
    Unknown(column: String) |
    Value(line: Int, column: String, expected: String, found: String)

/// The columns of `R`, in the order its fields are written: each one's
/// name; what its cells hold (`whole`, `number`, `bool`, `string` for a
/// `String`, `text` for other text: a `Char`, a date or a category);
/// whether a cell may be empty for `none`; and whether the column must
/// be there.
pub fn columns<R>() -> [(name: String, kind: String, optional: Bool, required: Bool)] {
    const schema = json.schema<R>()
    const required = (schema.get("required").list() ?? []).map(j => j.text() ?? "")
    let out: [(name: String, kind: String, optional: Bool, required: Bool)] = []
    for (name, field) in schema.get("properties").object() ?? {:} {
        const (kind, optional) = kind_of(field)
        out.push((name: name, kind: kind, optional: optional, required: required.contains(name)))
    }
    out
}

/// What a field's schema says its cells hold, and whether it is optional.
fn kind_of(field: Json) -> (String, Bool)
    example kind_of({"type": "integer"}) == ("whole", false)
    example kind_of({"anyOf": [{"type": "number"}, {"type": "null"}]}) == ("number", true)
    example kind_of({"type": "string", "format": "date"}) == ("text", false)
{
    const any = field.get("anyOf").list() ?? []
    if any.len() == 2 and any[1].get("type").text() == "null" {
        return (kind_of(any[0]).0, true)
    }
    if not any.is_empty() {
        return ("text", false)
    }
    const kind = match field.get("type").text() ?? "" {
        "integer" => "whole",
        "number" => "number",
        "boolean" => "bool",
        "string" => if plain_text(field) { "string" } else { "text" },
        _ => "text",
    }
    (kind, false)
}

/// Whether a `"string"` schema is a `String`'s: no format, pattern,
/// length or list of values, which a `Char`, a date or a category has.
fn plain_text(field: Json) -> Bool {
    for key in ["format", "pattern", "enum", "minLength", "maxLength", "contentEncoding"] {
        if not field.get(key).is_null() {
            return false
        }
    }
    true
}

/// The cells being read: a row may go on over several lines inside a
/// quoted cell.
type Reader {
    sep: Char
    /// The line read last, counted from 1.
    line: Int = 0
    /// The line the row being read started on.
    start: Int = 0
    cells: [String] = []
    cell: [Char] = []
    /// Inside quotes that go on to the next line.
    open: Bool = false
    /// The cell being read was quoted, and its quotes are closed.
    closed: Bool = false
}

/// Reads one line into `r`: the cells of the row it ends, or `none`
/// when a quoted cell goes on to the next line.
fn feed(inout r: Reader, text: String) -> [String]? ! CsvError
    require r.line >= 0 and r.line < 1 << 62
{
    r.line += 1
    if r.open {
        r.cell.push('\n')
    } else {
        r.start = r.line
        r.cells = []
        r.cell = []
        r.closed = false
        // A line with no quotes, as most are: its cells at once.
        if not text.contains('"') and not text.starts_with(`\u{FEFF}`) {
            return text.split(String(r.sep))
        }
    }
    let quoted = r.open
    const chars = text.chars()
    let i = if r.line == 1 and not chars.is_empty() and chars[0] == '\u{FEFF}' { 1 } else { 0 }
    while i < chars.len() {
        const c = chars[i]
        i += 1
        if quoted {
            if c != '"' {
                r.cell.push(c)
            } else if i < chars.len() and chars[i] == '"' {
                r.cell.push('"')
                i += 1
            } else {
                quoted = false
                r.closed = true
            }
        } else if c == r.sep {
            r.cells.push(r.cell.join(""))
            r.cell = []
            r.closed = false
        } else if r.closed {
            fail CsvError.Syntax(line: r.line, message: `text after a cell's closing quote: \`{c}\``)
        } else if c == '"' {
            if not r.cell.is_empty() {
                fail CsvError.Syntax(line: r.line, message: "a quote inside a cell that doesn't start with one")
            }
            quoted = true
        } else {
            r.cell.push(c)
        }
    }
    r.open = quoted
    if quoted {
        return none
    }
    r.cells.push(r.cell.join(""))
    r.cells
}

/// The rows of CSV lines, read as the lines come: the first names the
/// columns.
type Rows<R> {
    plan: [(name: String, kind: String, optional: Bool, required: Bool)]
    unknown: CsvUnknown
    /// For each column of the file, its place in `plan`, or -1 when
    /// `R` has no field for it.
    slots: [Int] = []
    header: [String] = []
    /// The line of column names was read.
    named: Bool = false
}

/// The row of one line's cells, or `none` for the line of column
/// names, which comes first. The rows are kept by the caller, so
/// `into` stays small to pass.
fn take<R>(inout into: Rows<R>, cells: [String], line: Int) -> R? ! CsvError {
    if not into.named {
        try name_columns(into, cells)
        return none
    }
    if cells.len() != into.header.len() {
        const what = if cells.len() == 1 { "1 cell" } else { `{cells.len()} cells` }
        fail CsvError.Syntax(line: line, message: `{what}, and the first line has {into.header.len()}`)
    }
    let names: [String] = []
    let texts: [String?] = []
    for (i, cell) in cells.enumerate() {
        const at = into.slots[i]
        if at >= 0 {
            const column = into.plan[at]
            // An empty cell: `none`, `""`, or the field's default; else
            // reading it says what was wanted.
            if cell == "" and column.optional {
                names.push(column.name)
                texts.push(none)
            } else if cell != "" or column.kind == "string" or column.required {
                names.push(column.name)
                texts.push(cell)
            }
        }
    }
    json.decode_texts<R>(names, texts) catch e => {
        fail refused(e, line, into.header, cells)
    }
}

/// Reads the line of column names.
fn name_columns<R>(inout into: Rows<R>, names: [String]) ! CsvError {
    for (i, name) in names.enumerate() {
        if names[0:i].contains(name) {
            fail CsvError.Syntax(line: 1, message: `the column \`{name}\` is named twice`)
        }
        const at = into.plan.find_index(c => c.name == name) ?? -1
        if at < 0 and into.unknown == CsvUnknown.Refuse {
            fail CsvError.Unknown(column: name)
        }
        into.slots.push(at)
    }
    for column in into.plan {
        if column.required and not column.optional and not names.contains(column.name) {
            fail CsvError.Missing(column: column.name)
        }
    }
    into.header = names
    into.named = true
}

/// A decoding problem as a `Value` error, at the column its path names;
/// an invariant (7.3) is at no one column, so its `found` is the row.
fn refused(e: JsonError, line: Int, header: [String], cells: [String]) -> CsvError
    require header.len() == cells.len()
{
    const problem = match e {
        JsonError.Invalid(problems) if not problems.is_empty() => problems[0],
        _ => JsonProblem(path: "", expected: String(e)),
    }
    const column = problem.path.remove_prefix("$").remove_prefix(".")
    let found = cells.join(",")
    if let at = header.index_of(column) {
        found = cells[at]
    }
    CsvError.Value(line: line, column: column, expected: problem.expected, found: found)
}

/// The rows of the CSV `text`.
pub fn parse<R>(text: String, sep: Char, unknown: CsvUnknown) -> [R] ! CsvError {
    let r = Reader(sep: sep)
    let into = Rows<R>(plan: columns<R>(), unknown: unknown)
    let rows: [R] = []
    for line in text.lines() {
        if let cells = try feed(r, line) {
            if let row = try take(into, cells, r.start) {
                rows.push(row)
            }
        }
    }
    try finish(r, into)
    rows
}

/// The rows of the CSV file at `path`, read line by line.
pub fn read<R>(path: String, sep: Char, unknown: CsvUnknown) -> [R] ! CsvError uses Fs.read {
    let r = Reader(sep: sep)
    let into = Rows<R>(plan: columns<R>(), unknown: unknown)
    let rows: [R] = []
    for line in fs.lines(path) catch e => {
        fail CsvError.File(error: e)
    } {
        if let cells = try feed(r, line) {
            if let row = try take(into, cells, r.start) {
                rows.push(row)
            }
        }
    }
    try finish(r, into)
    rows
}

/// The end of the text: no quote left open, and the column names read.
fn finish<R>(r: Reader, inout into: Rows<R>) ! CsvError {
    if r.open {
        fail CsvError.Syntax(line: r.start, message: "a quote left open")
    }
    if not into.named {
        try name_columns(into, [])
    }
}

/// `rows` as CSV text: a line of column names, then a line for each row.
pub fn write<R>(rows: [R], plan: [(name: String, kind: String, optional: Bool, required: Bool)], sep: Char) -> String {
    let out = TextBuilder()
    out.push(plan.map(c => quoted(c.name, sep)).join(String(sep)))
    out.push_char('\n')
    for row in rows {
        out.push(json.encode_texts(row).map(t => quoted(t ?? "", sep)).join(String(sep)))
        out.push_char('\n')
    }
    out.to_string()
}

/// `cell` quoted when it holds `sep`, a quote or a line break.
fn quoted(cell: String, sep: Char) -> String
    example quoted("late, paid", ',') == `"late, paid"`
    example quoted("north", ',') == "north"
    example quoted(`say "hi"`, ',') == `"say ""hi"""`
{
    if cell.contains(sep) or cell.contains('"') or cell.contains('\n') or cell.contains('\r') {
        const doubled = cell.replace(`"`, `""`)
        return `"{doubled}"`
    }
    cell
}
