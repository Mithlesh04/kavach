// std.http (spec 14.11): HTTP/1.1 and HTTP/2 clients and servers,
// written in Kavach on top of std.net. A client's HTTP/1.1 connection
// carries one request and its response (`connection: close`), and a
// session (`http.open`) keeps one open for several; a server keeps a
// connection open for the next request. Bodies are sized by
// `content-length` or sent in chunks. `https://` goes through TLS (`net.connect_tls`,
// decision 0021) and speaks HTTP/2 when the server chooses it; HTTP/2
// itself is in `h2.kav` (decision 0022). `get3` speaks HTTP/3, over
// QUIC (`h3.kav`). The server is in `server.kav`. Variants are written
// `HttpError.BadUrl`: a program may have its own.

use std.fs
use std.http.h2
use std.http.h3
use std.http.hpack
use std.json
use std.log
use std.http.message
use std.http.multipart
use std.http.server
use std.http.upgrade
use std.net
use std.time

/// An HTTP request, as a server's handler gets it.
pub type Request {
    pub method: String
    pub path: String
    /// In the order they came, names in lower case, repeats kept.
    pub headers: [Header]
    /// The body, when it was read whole (spec 14.11); empty otherwise.
    pub body: Bytes
    /// A body too large to read whole, set by the server: read it with
    /// `read_body`.
    pub stream: BodyStream? = none
    /// The address of whoever opened the connection (`203.0.113.7:51234`),
    /// set by the server; empty for a request made by hand. Behind a proxy
    /// it is the proxy's.
    pub peer: String = ""
    /// With mutual TLS, the names of the certificate the client showed
    /// (decision 0099); `none` otherwise, and for a request made by hand.
    pub client_cert: ClientCert? = none

    /// The value of the first header named `name`, if any.
    pub fn header(self, name: String) -> String? {
        message.first_header(self.headers, name.lower())
    }

    /// The values of every header named `name`, in order.
    pub fn headers_named(self, name: String) -> [String] {
        message.all_headers(self.headers, name.lower())
    }

    /// The next piece of a large body (spec 14.11), or `none` once it has
    /// all come; `none` for a body read whole.
    pub fn read_body(self) -> Bytes? ! NetError uses Net {
        const s = self.stream ?? return none
        if s.left.get() <= 0 {
            return none
        }
        let piece = s.first.get()
        if piece.is_empty() {
            const got = try s.conn.read().timeout(s.wait)
            const closed = NetError.Failed(address: "", reason: "the client closed the connection")
            piece = got ?? fail closed
        } else {
            s.first.update(_ => Bytes([]))
        }
        // What comes after the body is the next request's.
        const take = piece.len().min(s.left.get())
        s.left.update(n => n - take)
        if take < piece.len() {
            s.after.update(_ => piece.slice(take, piece.len()))
        }
        piece.slice(0, take)
    }
}

/// The part of a large request body not read yet, made by the server:
/// kept across tasks, so the server sees how much the handler read.
pub type BodyStream {
    pub conn: Connection
    /// What came with the request's head, not handed out yet.
    pub first: Shared<Bytes>
    /// How many bytes of the body are left.
    pub left: Shared<Int>
    /// What came after the body: the start of the next request.
    pub after: Shared<Bytes>
    /// How long one piece may take to come.
    pub wait: Duration
}

/// An HTTP response.
pub type Response {
    pub status: Int
    /// In the order they are sent, names in lower case; a name may come
    /// more than once (`set-cookie`).
    pub headers: [Header]
    pub body: Bytes
    /// Sent after `body` as it is read (spec 14.11): a reader of
    /// `fs.chunks`.
    pub stream: Chunks? = none
    /// What runs on the connection after the head: a WebSocket's
    /// session or an event stream's feed (`http.websocket`, `http.events`).
    pub take_over: TakeOver? = none

    /// The value of the first header named `name`, if any.
    pub fn header(self, name: String) -> String? {
        message.first_header(self.headers, name.lower())
    }

    /// The values of every header named `name`, in order.
    pub fn headers_named(self, name: String) -> [String] {
        message.all_headers(self.headers, name.lower())
    }
}

/// What `http.serve` allows each client (spec 14.11), so a slow or
/// hostile one can't hold the server: every limit has a safe default.
pub type ServeLimits {
    /// The most a request's line and headers may take: 431 past it.
    pub max_header_bytes: Int = 16_384
    /// The most a request's body may take: 413 past it, refused by its
    /// `content-length` before it is read.
    pub max_body_bytes: Int = 10_000_000
    /// How long a request's line and headers may take to come: 408 past
    /// it (a client sending them a byte at a time can't hold a task).
    pub header_timeout: Duration = 10.seconds
    /// The slowest a body may come, in bytes a second, after a second's
    /// grace: 408 when slower.
    pub min_body_rate: Int = 1_000
    /// How long a kept-open connection may wait for its next request.
    pub idle_timeout: Duration = 5.seconds
    /// The most connections at once: past it, 503 with `retry-after`.
    pub max_connections: Int = 10_000
    /// The most requests being answered at once: past it, 503.
    pub max_in_flight: Int = 1_000
    /// The largest request body read whole into `r.body`; a larger one is
    /// read by the handler with `r.read_body()`.
    pub buffered_body: Int = 1_000_000
    /// What `retry-after` says on a 503, in seconds.
    pub retry_after: Int = 1
    /// On a stop signal, how long to finish the requests under way
    /// (spec 5.8): `http.serve` holds the program's stop that long.
    pub drain_timeout: Duration = 10.seconds
    /// Whether a request's span continues the trace its `traceparent`
    /// names (spec 14.12); `false`, for a server the internet reaches
    /// directly, starts a trace of its own for each request.
    pub follow_trace: Bool = true
}

/// Why an HTTP request failed: `Status` and `BadJson` come from the
/// JSON calls (`get_json`, `post_json`).
pub type HttpError = Network(error: NetError) |
    BadUrl(url: String) |
    BadMessage(reason: String) |
    Status(code: Int) |
    BadJson(error: JsonError)

/// A response with text: `http.text(200, "hello")`.
pub fn text(status: Int, body: String) -> Response {
    const headers = [Header(name: "content-type", value: "text/plain; charset=utf-8")]
    Response(status: status, headers: headers, body: body.bytes())
}

/// A request with any `method`, `headers` and `body`, over HTTP/2 when
/// the server offers it with TLS, else HTTP/1.1 (spec 14.11).
pub fn request(method: String, url: String, headers: [Header] = [], body: Bytes = Bytes([])) -> Response ! HttpError uses Net {
    try call(method, url, headers, body)
}

/// `GET url`.
pub fn get(url: String) -> Response ! HttpError uses Net {
    try plain_request("GET", url, Bytes([]), "")
}

/// `POST url` with `body`.
pub fn post(url: String, body: Bytes) -> Response ! HttpError uses Net {
    try plain_request("POST", url, body, "")
}

/// `GET url`, its JSON body decoded into a `T`.
pub fn get_json<T>(url: String) -> T ! HttpError uses Net {
    const r = try plain_request("GET", url, Bytes([]), "")
    try decoded<T>(r)
}

/// `POST url` with the JSON `body`, the JSON answer decoded into a `T`.
pub fn post_json<T>(url: String, body: Json) -> T ! HttpError uses Net {
    const text = json.stringify(body, 0)
    const r = try plain_request("POST", url, text.bytes(), "application/json")
    try decoded<T>(r)
}

/// A response with the file at `path` (spec 14.11), sent as it is read:
/// its `content-type` from its extension, its `content-length` from its
/// size.
pub fn file(path: String) -> Response ! FsError uses Fs.read {
    const info = try fs.info(path)
    const reader = try fs.chunks(path, 65_536)
    const headers = [
        Header(name: "content-type", value: message.content_type(path)),
        Header(name: "content-length", value: "{info.size}"),
    ]
    Response(status: 200, headers: headers, body: Bytes([]), stream: reader)
}

/// What a response that takes over runs on the connection, with what
/// came after the request and the largest message allowed.
pub type TakeOver {
    pub run: fn(Connection, Bytes, Int) ! NetError
}

/// Accepts the WebSocket request `r` and runs `session` on it (spec
/// 14.11); 400 when `r` isn't one.
pub fn websocket(r: Request, session: fn(WebSocket) ! NetError) -> Response {
    upgrade.accept(r, session)
}

/// Server-sent events, sent by `feed` (spec 14.11).
pub fn events(r: Request, feed: fn(EventStream) ! NetError) -> Response {
    upgrade.events(feed)
}

/// A WebSocket to `url`, `ws://` or `wss://` (spec 14.11).
pub fn websocket_connect(url: String) -> WebSocket ! HttpError uses Net {
    try upgrade.connect(url)
}

/// The `multipart/form-data` form in `r`, read part by part (spec 14.11).
pub fn form(r: Request) -> Form ! HttpError {
    try multipart.open(r)
}

/// A response with JSON: `http.json_response(200, json.of(order))`.
pub fn json_response(status: Int, value: Json) -> Response {
    const headers = [Header(name: "content-type", value: "application/json")]
    Response(status: status, headers: headers, body: json.stringify(value, 0).bytes())
}

/// A request's JSON body decoded into a `T`.
pub fn read_json<T>(r: Request) -> T ! JsonError {
    const text = r.body.text() ?? fail JsonError.Invalid(problems: [JsonProblem(path: "", expected: "UTF-8 text")])
    try json.decode<T>(text)
}

/// A response's JSON body as a `T`, when its status is 2xx. Fields `T`
/// doesn't have are skipped: a service may add fields without breaking
/// its clients (decision 0096).
fn decoded<T>(r: Response) -> T ! HttpError {
    if r.status < 200 or r.status > 299 {
        fail HttpError.Status(code: r.status)
    }
    const text = r.body.text() ?? fail HttpError.BadMessage(reason: "the body isn't UTF-8")
    json.decode<T>(text, unknown: JsonUnknown.Ignore) catch e => fail HttpError.BadJson(error: e)
}

/// `GET url` over HTTP/3 (an `https://` URL).
pub fn get3(url: String) -> Response ! HttpError uses Net {
    const target = try split_url(url)
    if not target.secure {
        fail HttpError.BadUrl(url: url)
    }
    const name = target.host.slice(0, target.host.index_of(":") ?? target.host.len())
    const conn = net.connect_quic(target.host, ["h3"]) catch e => {
        fail HttpError.Network(error: e)
    }
    const pseudo = [
        Header(name: ":method", value: "GET"),
        Header(name: ":scheme", value: "https"),
        Header(name: ":authority", value: name),
        Header(name: ":path", value: target.path),
    ]
    const reply = h3.request(conn, pseudo, Bytes([])) catch e => {
        conn.close()
        fail match e {
            H3Error.Network(n) => HttpError.Network(error: n),
            H3Error.Protocol(reason) => HttpError.BadMessage(reason: reason),
        }
    }
    conn.close()
    const status = Int(reply.headers.get(":status") ?? "") catch e => {
        fail HttpError.BadMessage(reason: "no status in an HTTP/3 response")
    }
    Response(status: status, headers: message.plain(reply.headers), body: reply.body)
}

/// One HTTP/1.1 connection kept open for several requests to one server
/// (spec 14.11). For one task at a time.
pub type Session {
    conn: Connection
    host: String

    /// `GET path` on the session's connection.
    pub fn get(self, path: String) -> Response ! HttpError uses Net {
        try self.send("GET", path, [], Bytes([]))
    }

    /// `POST path` with `body` on the session's connection.
    pub fn post(self, path: String, body: Bytes) -> Response ! HttpError uses Net {
        try self.send("POST", path, [], body)
    }

    /// A request with any `method`, `headers` and `body` on the session's
    /// connection.
    pub fn request(self, method: String, path: String, headers: [Header] = [], body: Bytes = Bytes([])) -> Response ! HttpError uses Net {
        try self.send(method, path, headers, body)
    }

    /// Closes the session's connection.
    pub fn close(self) uses Net {
        self.conn.close()
    }

    /// Sends a request and reads its response, which must say its length.
    fn send(self, method: String, path: String, given: [Header], body: Bytes) -> Response ! HttpError uses Net {
        const crlf = message.crlf()
        let head = "{method} {path} HTTP/1.1{crlf}host: {self.host}{crlf}"
        for h in traced(given) {
            if not own_header(h.name) {
                head = head + "{h.name}: {h.value}{crlf}"
            }
        }
        head = head + "content-length: {body.len()}{crlf}{crlf}"
        self.conn.write(head.bytes() + body) catch e => {
            fail HttpError.Network(error: e)
        }
        let data = Bytes([])
        while true {
            if let got = message.whole(data) {
                const parts = got.message.first.split(" ")
                const status = Int(parts.get(1) ?? "") catch e => {
                    fail HttpError.BadMessage(reason: "no status in `{got.message.first}`")
                }
                return Response(status: status, headers: got.message.headers, body: got.message.body)
            }
            const piece = self.conn.read() catch e => {
                fail HttpError.Network(error: e)
            }
            const closed = NetError.Failed(address: self.host, reason: "the server closed the connection")
            data = data + (piece ?? fail HttpError.Network(error: closed))
        }
        fail HttpError.BadMessage(reason: "no response")
    }
}

/// A session with the server of `url`: one connection, kept open.
pub fn open(url: String) -> Session ! HttpError uses Net {
    const target = try split_url(url)
    const conn = if target.secure {
        net.connect_tls(target.host, protocols: ["http/1.1"]) catch e => fail HttpError.Network(error: e)
    } else {
        net.connect(target.host) catch e => fail HttpError.Network(error: e)
    }
    const host = target.host.slice(0, target.host.index_of(":") ?? target.host.len())
    Session(conn: conn, host: host)
}

/// Serves HTTP on `listener`: each connection in a task of its own, on
/// any core (spec 14.11), its requests answered by `handler`, each client
/// held to `limits`. Runs until the function that called it returns (its
/// tasks are cancelled then, spec 9.2).
pub fn serve(listener: Listener, handler: fn(Request) -> Response, limits: ServeLimits = ServeLimits()) ! NetError uses Net {
    try server.serve(listener, handler, limits)
}

/// Where a URL points: its host (with the port), its path, and whether
/// it is `https://`.
type Target {
    host: String
    path: String
    secure: Bool
}

fn split_url(url: String) -> Target ! HttpError {
    const secure = url.starts_with("https://")
    if not secure and not url.starts_with("http://") {
        fail HttpError.BadUrl(url: url)
    }
    const rest = url.slice(if secure { 8 } else { 7 }, url.len())
    const slash = rest.index_of("/") ?? rest.len()
    let host = rest.slice(0, slash)
    if host.is_empty() {
        fail HttpError.BadUrl(url: url)
    }
    if not host.contains(":") {
        host = host + if secure { ":443" } else { ":80" }
    }
    const path = if slash < rest.len() { rest.slice(slash, rest.len()) } else { "/" }
    Target(host: host, path: path, secure: secure)
}

/// `kind` is the body's `content-type` (none when empty).
/// `headers`, with the current span's `traceparent` when the code runs in
/// one and they don't name one already (spec 14.11, 14.12).
fn traced(headers: [Header]) -> [Header] {
    const parent = log.traceparent() ?? return headers
    if headers.any(h => h.name.lower() == "traceparent") {
        return headers
    }
    let all = headers
    all.push(Header(name: "traceparent", value: parent))
    all
}

fn plain_request(method: String, url: String, body: Bytes, kind: String) -> Response ! HttpError uses Net {
    let headers: [Header] = []
    if not kind.is_empty() {
        headers.push(Header(name: "content-type", value: kind))
    }
    try call(method, url, headers, body)
}

/// Whether the client writes header `name` itself.
fn own_header(name: String) -> Bool {
    const n = name.lower()
    n == "host" or n == "content-length" or n == "connection"
}

/// A request to `url` on a connection of its own.
fn call(method: String, url: String, given: [Header], body: Bytes) -> Response ! HttpError uses Net {
    const headers = traced(given)
    const target = try split_url(url)
    const name = target.host.slice(0, target.host.index_of(":") ?? target.host.len())
    const conn = connect(target) catch e => {
        fail HttpError.Network(error: e)
    }
    if conn.protocol() == "h2" {
        let pseudo = [
            Header(name: ":method", value: method),
            Header(name: ":scheme", value: "https"),
            Header(name: ":authority", value: name),
            Header(name: ":path", value: target.path),
        ]
        for h in headers {
            if not own_header(h.name) {
                pseudo.push(Header(name: h.name.lower(), value: h.value))
            }
        }
        const reply = h2.request(conn, pseudo, body) catch e => {
            conn.close()
            fail from_h2(e)
        }
        conn.close()
        const status = Int(reply.headers.get(":status") ?? "") catch e => {
            fail HttpError.BadMessage(reason: "no status in an HTTP/2 response")
        }
        return Response(status: status, headers: message.plain(reply.headers), body: reply.body)
    }
    let head = "{method} {target.path} HTTP/1.1{message.crlf()}host: {name}{message.crlf()}"
    for h in headers {
        if not own_header(h.name) {
            head = head + "{h.name}: {h.value}{message.crlf()}"
        }
    }
    head = head + "content-length: {body.len()}{message.crlf()}connection: close{message.crlf()}{message.crlf()}"
    const all = exchange(conn, head.bytes() + body) catch e => {
        fail HttpError.Network(error: e)
    }
    const reply = message.parse(all) ?? fail HttpError.BadMessage(reason: "the response is not HTTP")
    const parts = reply.first.split(" ")
    const status = Int(parts.get(1) ?? "") catch e => {
        fail HttpError.BadMessage(reason: "no status in `{reply.first}`")
    }
    const body = if message.chunked(reply.headers) {
        message.dechunk(reply.body) ?? fail HttpError.BadMessage(reason: "a chunked body is cut off")
    } else {
        reply.body
    }
    Response(status: status, headers: reply.headers, body: body)
}

/// A connection to `target`; with TLS, HTTP/2 is offered too.
fn connect(target: Target) -> Connection ! NetError uses Net {
    if target.secure {
        return try net.connect_tls(target.host, protocols: ["h2", "http/1.1"])
    }
    try net.connect(target.host)
}

/// Sends `data` on `conn` and reads everything that comes back.
fn exchange(conn: Connection, data: Bytes) -> Bytes ! NetError uses Net {
    try conn.write(data)
    let all = Bytes([])
    while true {
        const piece = (try conn.read()) ?? break
        all = all + piece
    }
    conn.close()
    all
}

fn from_h2(e: H2Error) -> HttpError {
    match e {
        H2Error.Network(n) => HttpError.Network(error: n),
        H2Error.Protocol(reason) => HttpError.BadMessage(reason: reason),
        H2Error.Reset(_, code) => HttpError.BadMessage(reason: "the server reset the stream (code {code})"),
    }
}
