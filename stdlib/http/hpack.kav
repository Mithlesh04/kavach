// HPACK (RFC 7541): how HTTP/2 compresses headers, for std.http
// (decision 0022). Decoding is complete: the static and dynamic tables
// and Huffman codes. Encoding writes every header as a literal, without
// indexing or Huffman codes, which RFC 7541 allows.

/// One header: its name and value.
pub type Header {
    pub name: String
    pub value: String
}

/// Why a header block can't be read.
pub type HpackError = Malformed(reason: String)

/// The dynamic table: entries oldest first, their size, and its limit.
pub type Table {
    pub entries: [Header]
    pub size: Int
    pub limit: Int
}

/// A header block's headers, and the table after it.
pub type Decoded {
    pub headers: [Header]
    pub table: Table
}

/// An empty table that holds up to `limit` bytes (4096 to start with).
pub fn new_table(limit: Int) -> Table {
    Table(entries: [], size: 0, limit: limit)
}

/// Reads a header block, with the table the earlier blocks left.
pub fn decode(block: Bytes, table: Table) -> Decoded ! HpackError {
    let t = table
    let headers: [Header] = []
    let i = 0
    while i < block.len() {
        const b = Int(block[i])
        if b & 128 != 0 {
            // An indexed header.
            const n = try number(block, i, 7)
            headers.push(try entry(t, n.value))
            i = n.next
        } else if b & 64 != 0 {
            // A literal that goes into the table.
            const f = try literal(block, i, 6, t)
            headers.push(f.header)
            t = add(t, f.header)
            i = f.next
        } else if b & 32 != 0 {
            // A new table size: at most what we allowed.
            const n = try number(block, i, 5)
            if n.value > table.limit {
                fail HpackError.Malformed(reason: "a table size over the limit")
            }
            t = fit(t.entries, n.value)
            i = n.next
        } else {
            // A literal that stays out of the table.
            const f = try literal(block, i, 4, t)
            headers.push(f.header)
            i = f.next
        }
    }
    Decoded(headers: headers, table: t)
}

/// A header block for `headers`: literals, names in lower case.
pub fn encode(headers: [Header]) -> Bytes {
    let out = Bytes([])
    for h in headers {
        out = out + Bytes([UInt8(0)]) + text(h.name.lower()) + text(h.value)
    }
    out
}

/// `s` as a string literal: its length, then its bytes.
fn text(s: String) -> Bytes {
    const b = s.bytes()
    number_bytes(b.len(), 7, 0) + b
}

/// `value` with an `n`-bit prefix, after the bits `flags` (RFC 7541 5.1).
fn number_bytes(value: Int, n: Int, flags: Int) -> Bytes
    require value >= 0
    require n >= 1 and n <= 8
    require flags >= 0 and flags <= 255
    example number_bytes(10, 5, 0) == Bytes([10])
    example number_bytes(1337, 5, 0) == Bytes([31, 154, 10])
{
    const full = (1 << n) - 1
    if value < full {
        return Bytes([UInt8(flags | value)])
    }
    let out: [UInt8] = [UInt8(flags | full)]
    let rest = value - full
    while rest >= 128 {
        out.push(UInt8(rest % 128 + 128))
        rest = rest / 128
    }
    out.push(UInt8(rest))
    Bytes(out)
}

/// A number read at `at`, and where what follows it starts.
type Number {
    value: Int
    next: Int
}

/// The number with an `n`-bit prefix at `at`.
fn number(data: Bytes, at: Int, n: Int) -> Number ! HpackError
    require at >= 0 and at < data.len()
    require n >= 1 and n <= 8
{
    const full = (1 << n) - 1
    let value = Int(data[at]) & full
    let i = at + 1
    if value < full {
        return Number(value: value, next: i)
    }
    let shift = 0
    while true {
        const b = Int(data.get(i) ?? fail HpackError.Malformed(reason: "a number is cut off"))
        i += 1
        if shift > 28 {
            fail HpackError.Malformed(reason: "a number is too large")
        }
        value += (b & 127) << shift
        shift += 7
        if b & 128 == 0 {
            break
        }
    }
    Number(value: value, next: i)
}

/// A header read at `at`, and where the next one starts.
type Field {
    header: Header
    next: Int
}

/// A literal header: its name (indexed, or a string) and value.
fn literal(data: Bytes, at: Int, n: Int, t: Table) -> Field ! HpackError
    require at >= 0 and at < data.len()
    require n >= 1 and n <= 8
{
    const index = try number(data, at, n)
    let i = index.next
    let name = ""
    if index.value == 0 {
        const s = try string(data, i)
        name = s.value
        i = s.next
    } else {
        name = (try entry(t, index.value)).name
    }
    const value = try string(data, i)
    Field(header: Header(name: name, value: value.value), next: value.next)
}

/// A text read at `at`, and where what follows it starts.
type Text {
    value: String
    next: Int
}

/// A string literal: a length, then bytes, maybe Huffman-coded.
fn string(data: Bytes, at: Int) -> Text ! HpackError {
    const first = data.get(at) ?? fail HpackError.Malformed(reason: "a string is missing")
    const n = try number(data, at, 7)
    const end = n.next + n.value
    if end > data.len() {
        fail HpackError.Malformed(reason: "a string is cut off")
    }
    const raw = data.slice(n.next, end)
    const bytes = if Int(first) & 128 != 0 { try huffman(raw) } else { raw }
    const value = bytes.text() ?? fail HpackError.Malformed(reason: "a header is not UTF-8")
    Text(value: value, next: end)
}

/// Entry `index`: 1 to 61 in the static table, then the dynamic
/// table, newest first.
fn entry(t: Table, index: Int) -> Header ! HpackError {
    if index < 1 or index - 61 > t.entries.len() {
        fail HpackError.Malformed(reason: "no header at index {index}")
    }
    if index <= 61 {
        return static_table()[index - 1]
    }
    t.entries[t.entries.len() - (index - 61)]
}

/// An entry's size: its name and value, and 32 (RFC 7541 4.1).
fn size_of(h: Header) -> Int {
    h.name.bytes().len() + h.value.bytes().len() + 32
}

/// `t` with `h` added, the oldest entries dropped to make room.
fn add(t: Table, h: Header) -> Table {
    let entries = t.entries
    entries.push(h)
    fit(entries, t.limit)
}

/// A table of `entries` without the oldest, until they fit in `limit`.
fn fit(entries: [Header], limit: Int) -> Table {
    let size = 0
    for h in entries {
        size += size_of(h)
    }
    let drop = 0
    while size > limit and drop < entries.len() {
        size -= size_of(entries[drop])
        drop += 1
    }
    Table(entries: entries.skip(drop), size: size, limit: limit)
}

/// Decodes Huffman-coded bytes (RFC 7541 appendix B). The code is
/// canonical: codes of one length are consecutive numbers, in symbol
/// order, so four small tables decode it. QPACK (`h3.kav`) uses
/// the same code.
pub fn huffman(data: Bytes) -> Bytes ! HpackError {
    const order = huffman_order()
    const first = huffman_first()
    const count = huffman_count()
    const offset = huffman_offset()
    let out: [UInt8] = []
    let code = 0
    let len = 0
    for b in data.to_list() {
        let bit = 7
        while bit >= 0 {
            code = code << 1 | (Int(b) >> bit) & 1
            len += 1
            const k = code - first[len]
            if k >= 0 and k < count[len] {
                const symbol = order[offset[len] + k]
                if symbol == 256 {
                    fail HpackError.Malformed(reason: "end of string inside a string")
                }
                out.push(UInt8(symbol))
                code = 0
                len = 0
            } else if len >= 30 {
                fail HpackError.Malformed(reason: "not a Huffman code")
            }
            bit -= 1
        }
    }
    // What is left is padding: under 8 bits, all ones.
    if len > 7 or code != (1 << len) - 1 {
        fail HpackError.Malformed(reason: "bad Huffman padding")
    }
    Bytes(out)
}

/// The symbols, shortest codes first, in symbol order within a length.
fn huffman_order() -> [Int] {
    [
        48, 49, 50, 97, 99, 101, 105, 111, 115, 116, 32, 37, 45, 46, 47, 51, 52,
        53, 54, 55, 56, 57, 61, 65, 95, 98, 100, 102, 103, 104, 108, 109, 110, 112,
        114, 117, 58, 66, 67, 68, 69, 70, 71, 72, 73, 74, 75, 76, 77, 78, 79, 80,
        81, 82, 83, 84, 85, 86, 87, 89, 106, 107, 113, 118, 119, 120, 121, 122, 38,
        42, 44, 59, 88, 90, 33, 34, 40, 41, 63, 39, 43, 124, 35, 62, 0, 36, 64, 91,
        93, 126, 94, 125, 60, 96, 123, 92, 195, 208, 128, 130, 131, 162, 184, 194,
        224, 226, 153, 161, 167, 172, 176, 177, 179, 209, 216, 217, 227, 229, 230,
        129, 132, 133, 134, 136, 146, 154, 156, 160, 163, 164, 169, 170, 173, 178,
        181, 185, 186, 187, 189, 190, 196, 198, 228, 232, 233, 1, 135, 137, 138,
        139, 140, 141, 143, 147, 149, 150, 151, 152, 155, 157, 158, 165, 166, 168,
        174, 175, 180, 182, 183, 188, 191, 197, 231, 239, 9, 142, 144, 145, 148,
        159, 171, 206, 215, 225, 236, 237, 199, 207, 234, 235, 192, 193, 200, 201,
        202, 205, 210, 213, 218, 219, 238, 240, 242, 243, 255, 203, 204, 211, 212,
        214, 221, 222, 223, 241, 244, 245, 246, 247, 248, 250, 251, 252, 253, 254,
        2, 3, 4, 5, 6, 7, 8, 11, 12, 14, 15, 16, 17, 18, 19, 20, 21, 23, 24, 25,
        26, 27, 28, 29, 30, 31, 127, 220, 249, 10, 13, 22, 256
    ]
}

/// The first code of each length (0 to 30 bits).
fn huffman_first() -> [Int] {
    [
        0, 0, 0, 0, 0, 0, 20, 92, 248, 0, 1016, 2042, 4090, 8184, 16380, 32764, 0,
        0, 0, 524272, 1048550, 2097116, 4194258, 8388568, 16777194, 33554412,
        67108832, 134217694, 268435426, 0, 1073741820
    ]
}

/// How many codes each length has.
fn huffman_count() -> [Int] {
    [
        0, 0, 0, 0, 0, 10, 26, 32, 6, 0, 5, 3, 2, 6, 2, 3, 0, 0, 0, 3, 8, 13, 26,
        29, 12, 4, 15, 19, 29, 0, 4
    ]
}

/// Where each length's symbols start in `huffman_order()`.
fn huffman_offset() -> [Int] {
    [
        0, 0, 0, 0, 0, 0, 10, 36, 68, 74, 74, 79, 82, 84, 90, 92, 95, 95, 95, 95,
        98, 106, 119, 145, 174, 186, 190, 205, 224, 253, 253
    ]
}

/// The static table (RFC 7541 appendix A): entries 1 to 61.
fn static_table() -> [Header] {
    [
        Header(name: ":authority", value: ""),
        Header(name: ":method", value: "GET"),
        Header(name: ":method", value: "POST"),
        Header(name: ":path", value: "/"),
        Header(name: ":path", value: "/index.html"),
        Header(name: ":scheme", value: "http"),
        Header(name: ":scheme", value: "https"),
        Header(name: ":status", value: "200"),
        Header(name: ":status", value: "204"),
        Header(name: ":status", value: "206"),
        Header(name: ":status", value: "304"),
        Header(name: ":status", value: "400"),
        Header(name: ":status", value: "404"),
        Header(name: ":status", value: "500"),
        Header(name: "accept-charset", value: ""),
        Header(name: "accept-encoding", value: "gzip, deflate"),
        Header(name: "accept-language", value: ""),
        Header(name: "accept-ranges", value: ""),
        Header(name: "accept", value: ""),
        Header(name: "access-control-allow-origin", value: ""),
        Header(name: "age", value: ""),
        Header(name: "allow", value: ""),
        Header(name: "authorization", value: ""),
        Header(name: "cache-control", value: ""),
        Header(name: "content-disposition", value: ""),
        Header(name: "content-encoding", value: ""),
        Header(name: "content-language", value: ""),
        Header(name: "content-length", value: ""),
        Header(name: "content-location", value: ""),
        Header(name: "content-range", value: ""),
