// std.net (spec 14.10): the `NetError` union network operations fail with,
// and the `Datagram` record, written in Kavach. Listening, connecting,
// reading, writing and datagrams need the operating system, so the
// runtime provides them.

use std.net

/// Why a network operation failed.
pub type NetError = Refused(address: String) |
    TimedOut(address: String) |
    Failed(address: String, reason: String)

/// The names of the certificate a client showed a server, with mutual TLS
/// (spec 14.10): its common name, and its DNS and URI subject-alternative
/// names (a SPIFFE id such as `spiffe://shop/orders` is a URI).
pub type ClientCert {
    pub common_name: String
    pub dns: [String]
    pub uris: [String]
}

/// A UDP datagram that came in, with the address it came from.
pub type Datagram {
    pub data: Bytes
    pub from: String
}

/// A TCP port nothing listens on now, chosen by the system: listened on
/// for a moment, then let go (spec 14.25). Another program may take it
/// before this one listens on it.
pub fn free_port() -> Int ! NetError uses Net {
    const listener = try net.listen("127.0.0.1:0")
    const address = listener.address()
    const parts = address.split(":")
    Int(parts[parts.len() - 1]) catch _ => 0
}

/// Whether this program could listen on `port` now.
pub fn is_free(port: Int) -> Bool uses Net
    require port >= 0 and port <= 65535
{
    const listener = net.listen("127.0.0.1:{port}") catch _ => return false
    listener.address() != ""
}
