// std.ai (spec 8.4): the error `ask<T>` fails with, the `Model` it asks,
// the `Provider` interface that translates an `ask` into one provider's
// API (decision 0140), and what an `ask` took and cost. Sending, keys,
// retries, gates and limits are the runtime's. `Anthropic`, the default
// provider, is in `std.ai.anthropic`, and `wire` is how the runtime calls
// a provider.

use std.json
use std.ai
use std.ai.anthropic

/// Why an AI call failed (spec 8.4): each kind of trouble means the same
/// for every provider.
pub type AiError = NoKey(variable: String) |
    RateLimited(message: String) |
    QuotaUsedUp(message: String) |
    Overloaded(message: String) |
    BadKey(message: String) |
    NotFound(model: String) |
    BadRequest(message: String) |
    Refused(reason: String?) |
    CutOff(max_tokens: Int) |
    TimedOut(after: Duration) |
    Network(message: String) |
    InvalidOutput(answer: String) |
    Denied(reason: String) |
    Failed(status: Int, message: String)

/// How hard a model works on an answer, and how many tokens it spends
/// (spec 8.4).
pub type Effort = Low | Medium | High | XHigh | Max

/// Which model an `ask` uses, and with what settings (spec 8.4, decisions
/// 0056 and 0059): an agent's `model`, or a call's `model:`, alone or in a
/// list of models tried in turn (spec 8.4, *Fallbacks*).
pub type Model {
    /// the provider's name for the model, such as "claude-haiku-5-5"
    pub name: String
    /// none: the model's own; how hard it works on an answer, from `Low`
    /// to `Max`: more effort, better answers and more tokens
    pub effort?: Effort
    /// none: 4,096; the most tokens an answer may take, thinking included,
    /// from 1 to 128,000
    pub max_tokens?: Int
    /// none: the model's own; false: answer without thinking first, for
    /// fewer output tokens (spec 8.4)
    pub thinking?: Bool
    /// none: none; standing instructions sent with every `ask` (a system
    /// prompt)
    pub instructions?: String
    /// none: none; text that ends the answer where the model writes it
    pub stop?: [String]
    /// none: 120 seconds; how long one try may take before it is sent again
    pub timeout?: Duration
    /// none: 4; how many times a busy, dropped or late call is sent again,
    /// from 0 to 10
    pub retries?: Int
    /// none: `KAVACH_AI_URL`, or the provider's address; where the calls go
    pub api_url?: String
    /// none: the provider's, "ANTHROPIC_API_KEY" for Anthropic; the
    /// environment variable holding the key
    pub api_key_env?: String
    /// none: none; more request fields, as the text of a JSON object
    pub extra?: String
    /// none: `Anthropic()`; whose API the model is reached through
    pub provider?: Provider
}

/// How an agent treats its limits and approvals (spec 8.5).
pub type AgentMode = Enforce | Suggest | Observe

/// How each audit entry is written (spec 8.6).
pub type AuditFormat = Text | JsonLines

/// An agent's audit log (spec 8.6): on when its settings have one.
pub type Audit {
    /// none: "audit.log", in the agent's folder; the file's path
    pub file?: String
    /// none: Text; JsonLines: one JSON object per entry, for log shippers
    pub format?: AuditFormat
    /// none: false; true: each entry to the `[log.otlp]` collector too
    pub otlp?: Bool
}

/// An agent's settings (spec 8.5, decision 0060): its `settings`.
pub type AgentSettings {
    /// none: Enforce; how the agent treats its limits and approvals
    pub mode?: AgentMode
    /// none: no audit log; an `Audit` turns it on
    pub audit?: Audit
    /// none: true in a project; false: limit totals last only while the
    /// program runs
    pub state?: Bool
    /// none: true in a project; false: a handler cut off half way is not
    /// run again after a restart
    pub journal?: Bool
    /// none: `agents/<Name>/` beside kavach.toml; the folder the agent's
    /// files go in
    pub folder?: String
    /// none: Average; how a `tokens` limit counts the `ask`s still waiting
    /// for their answer (spec 8.3)
    pub asks_under_way?: UnderWay
}

/// How a `tokens` limit counts the `ask`s still waiting for their answer
/// (spec 8.3). Average: at the average size of the answered ones, and a
/// new `ask` the limit would refuse waits for them. Largest: at the most
/// each can take. NotCounted: not at all.
pub type UnderWay = Average | Largest | NotCounted

/// How `ask` talks to one AI provider (spec 8.4, decision 0140). It only
/// translates; the runtime reads the key, sends, retries and keeps the
/// limits, so provider code never holds the key.
pub interface Provider {
    /// The settings of `model` this provider can't take, each with why:
    /// compile errors, as the compiler runs it when it builds the program.
    fn check(self, model: Model) -> [String]
    /// The variable holding the key when the `Model` names none.
    fn key_variable(self) -> String
    /// Where the key goes in a request; the runtime puts it there.
    fn auth(self, model: Model) -> Auth
    /// The request for one `ask`.
    fn request(self, call: AskCall) -> HttpCall
    /// What came back: an answer, or why there is none.
    fn read(self, call: AskCall, reply: HttpReply) -> Reply
    /// The price of a model's tokens; none: not known. Worked out when
    /// the program is built, as `check` is (spec 8.4, *Prices*).
    fn price(self, model: String) -> Price?
}

/// One `ask`, as the provider sees it.
pub type AskCall {
    pub model: Model
    pub prompt: String
    /// the JSON Schema built from `T`
    pub schema: Json
    /// true: hold the answer to `schema` with the provider's own mode;
    /// false: the type is already written into `prompt` (decision 0057)
    pub strict: Bool
}

/// A request for the runtime to send.
pub type HttpCall {
    pub url: String
    pub headers: {String: String}
    pub body: String
}

/// What came back; header names are in lowercase.
pub type HttpReply {
    pub status: Int
    pub headers: {String: String}
    pub body: String
}

/// Where the key goes. The runtime reads it and puts it there.
pub type Auth = NoKey |
    Bearer |
    InHeader(name: String) |
    AwsSignature(service: String, region: String) |
    GoogleToken(scope: String)

/// What a reply means, as the provider reads it.
pub type Reply = Answer(text: String, usage: Usage) |
    Refused(reason: String?, usage: Usage) |
    CutOff(usage: Usage) |
    Problem(kind: Trouble, message: String, wait: Duration?)

/// What went wrong, as the provider means it, not as its status says.
pub type Trouble = RateLimited | QuotaUsedUp | Overloaded | BadKey |
    NotFound | BadRequest | TimedOut | Other(status: Int)

/// Tokens as the provider counts them; none: it didn't say.
pub type Usage {
    /// every input token, cached ones included
    pub input?: Int
    /// every output token, thinking included
    pub output?: Int
    pub cached_input?: Int
    pub thinking?: Int
}

/// The price of a model's tokens, in US dollars (spec 8.4, *Prices*).
pub type Price {
    /// per `per` input tokens
    pub input: Decimal
    /// per `per` output tokens, thinking included
    pub output: Decimal
    /// per `per` input tokens read from the provider's cache; none: as
    /// `input`
    pub cached_input?: Decimal
    /// usually 1,000,000
    pub per: Int
    /// the day the price was read
    pub as_of: Date
    pub from: PriceSource
}

/// Where a price comes from: Kavach's own table, the program, or a
/// package.
pub type PriceSource = Kavach | Program | Package(name: String)

/// What an `ask` cost, worked out from prices: an estimate, and how far
/// to trust it (spec 8.4, *Usage and cost*).
pub type Cost: Display {
    /// in US dollars
    pub dollars: Decimal
    /// how far to trust it
    pub note: String

    /// `about $0.0042 (estimate: prices as of 2026-11-16; the provider's
    /// bill is exact)`.
    pub fn display(self) -> String
        example Cost(dollars: 0.0042, note: "estimate").display() == "about $0.0042 (estimate)"
    {
        `about ${self.dollars} ({self.note})`
    }
}

/// An answer, with what it took (`ai.ask_full<T>`, spec 8.4).
pub type Asked<T> {
    pub value: T
    /// every try's tokens, added up
    pub usage: Usage
    /// none: a model it used has no known price, or a reply gave no counts
    pub cost: Cost?
    /// the model that answered
    pub model: String
}

/// What the `ask`s of a run, or of one agent, took (`ai.spent`, spec 8.4).
pub type Spent {
    /// the asks that reached a model
    pub asks: Int
    /// their tokens, added up
    pub usage: Usage
    /// the asks whose cost is known; none: no such ask
    pub cost: Cost?
    /// the asks whose cost isn't known, left out of `cost`
    pub unpriced: Int
}

/// What every `ask` of the run took so far, or, given an agent's name,
/// what that agent's took, since the program started (spec 8.4).
pub fn spent(by: String? = none) -> Spent {
    const empty = Spent(asks: 0, usage: Usage(), cost: none, unpriced: 0)
    json.decode<Spent>(ai.spent_text(by ?? "")) catch e => empty
}

/// The settings the compiler worked out for a `Model` (spec 8.4), as the
/// runtime gives them to `wire`.
type WireModel {
    model: String
    max_tokens?: Int
    effort?: String
    thinking?: Bool
    instructions?: String
    stop?: [String]
    timeout_ms?: Int
    retries?: Int
    api_url?: String
    api_key_env?: String
    extra?: String
}

/// What the runtime asks of a provider: `op` is `check`, `price`,
/// `request` or `read`; a reply's fields come with `read`.
type WireIn {
    op: String
    prompt?: String
    schema?: Json
    strict?: Bool
    status?: Int
    headers?: {String: String}
    body?: String
}

/// A request, where its key goes, and the variable that holds the key.
type WireOut {
    url: String
    headers: {String: String}
    body: String
    auth: Auth
    key_variable: String
}

/// The effort a setting's name gives.
fn effort_of(name: String?) -> Effort?
    example effort_of("high") == Effort.High
    example effort_of(none) == none
{
    match name ?? "" {
        "low" => Effort.Low,
        "medium" => Effort.Medium,
        "high" => Effort.High,
        "xhigh" => Effort.XHigh,
        "max" => Effort.Max,
        _ => none,
    }
}

/// How the runtime calls a provider (spec 8.4): `given`, or `Anthropic()`,
/// with the `Model` whose settings are `settings`. The function it gives
/// takes a `WireIn` as JSON text and gives the provider's answer as JSON
/// text, so the runtime needs no Kavach types.
fn wire(given: Provider?, settings: String) -> fn(String) -> String {
    const p: Provider = given ?? Anthropic()
    const s = json.decode<WireModel>(settings, unknown: JsonUnknown.Ignore) catch e => WireModel(model: "")
    const timeout = if let ms = s.timeout_ms { Duration(ms: ms) } else { none }
    const model = Model(name: s.model, effort: effort_of(s.effort), max_tokens: s.max_tokens,
        thinking: s.thinking, instructions: s.instructions, stop: s.stop, timeout: timeout,
        retries: s.retries, api_url: s.api_url, api_key_env: s.api_key_env, extra: s.extra,
        provider: p)
    input => {
        const w = json.decode<WireIn>(input) catch e => return "null"
        if w.op == "check" {
            return json.stringify(p.check(model))
        }
        if w.op == "price" {
            return json.stringify(p.price(model.name), big_as_text: true)
        }
        const call = AskCall(model: model, prompt: w.prompt ?? "", schema: w.schema ?? Json.Null,
            strict: w.strict ?? false)
        if w.op == "request" {
            const r = p.request(call)
            return json.stringify(WireOut(url: r.url, headers: r.headers, body: r.body,
                auth: p.auth(model), key_variable: p.key_variable()))
        }
        const reply = HttpReply(status: w.status ?? 0, headers: w.headers ?? {:}, body: w.body ?? "")
        json.stringify(p.read(call, reply))
    }
}
