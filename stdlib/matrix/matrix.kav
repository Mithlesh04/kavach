// std.matrix (spec 2.17, decision 0111): `Matrix<T>`, a grid of numbers
// kept row by row in one flat list. The heavy work is the runtime's
// (`runtime/matrix`), by the items' type; this file gives it the sizes.

use std.matrix

/// A grid of numbers, `rows` × `cols`, its items row by row.
pub type Matrix<T>: Add, Sub, Mul, Neg, MatMul {
    pub rows: Int
    pub cols: Int
    pub items: [T]

    /// Where the item in row `i`, column `j` is in `items`: so
    /// `m.items[m.index(i, j)] = v` changes it.
    pub fn index(self, i: Int, j: Int) -> Int
        require i >= 0 and i < self.rows
        require j >= 0 and j < self.cols
    {
        i * self.cols + j
    }

    /// The item in row `i`, column `j`.
    pub fn at(self, i: Int, j: Int) -> T
        require i >= 0 and i < self.rows
        require j >= 0 and j < self.cols
    {
        self.items[i * self.cols + j]
    }

    /// Row `i`.
    pub fn row(self, i: Int) -> [T]
        require i >= 0 and i < self.rows
    {
        self.items.slice(i * self.cols, (i + 1) * self.cols)
    }

    /// Column `j`.
    pub fn col(self, j: Int) -> [T]
        require j >= 0 and j < self.cols
    {
        let out: [T] = []
        for i in 0..self.rows {
            out.push(self.items[i * self.cols + j])
        }
        out
    }

    /// The rows, each a list.
    pub fn to_rows(self) -> [[T]] {
        let out: [[T]] = []
        for i in 0..self.rows {
            out.push(self.items.slice(i * self.cols, (i + 1) * self.cols))
        }
        out
    }

    /// `a + b`, item by item.
    pub fn add(self, other: Matrix<T>) -> Matrix<T>
        require self.rows == other.rows and self.cols == other.cols
    {
        Matrix(rows: self.rows, cols: self.cols, items: matrix.zip_id<T>(self.items, other.items, 0))
    }

    /// `a - b`, item by item.
    pub fn sub(self, other: Matrix<T>) -> Matrix<T>
        require self.rows == other.rows and self.cols == other.cols
    {
        Matrix(rows: self.rows, cols: self.cols, items: matrix.zip_id<T>(self.items, other.items, 1))
    }

    /// `a * b`, item by item.
    pub fn mul(self, other: Matrix<T>) -> Matrix<T>
        require self.rows == other.rows and self.cols == other.cols
    {
        Matrix(rows: self.rows, cols: self.cols, items: matrix.zip_id<T>(self.items, other.items, 2))
    }

    /// `-a`.
    pub fn neg(self) -> Matrix<T> {
        Matrix(rows: self.rows, cols: self.cols, items: matrix.negate_id<T>(self.items))
    }

    /// Every item times `x`.
    pub fn scale(self, x: T) -> Matrix<T> {
        Matrix(rows: self.rows, cols: self.cols, items: matrix.scale_id<T>(self.items, x))
    }

    /// `a @ b`: each item's products added in order, so every machine
    /// gives the same bits.
    pub fn matmul(self, other: Matrix<T>) -> Matrix<T>
        require self.cols == other.rows
        require self.cols > 0
    {
        self.product(other)
    }

    /// The product; with `fast`, worked out as fast as the machine allows,
    /// so a `Float` result may differ in its last bits.
    pub fn product(self, other: Matrix<T>, fast: Bool = false) -> Matrix<T>
        require self.cols == other.rows
        require self.cols > 0
    {
        const sizes = [self.rows, self.cols, other.cols, if fast { 1 } else { 0 }]
        Matrix(rows: self.rows, cols: other.cols, items: matrix.product_id<T>(self.items, other.items, sizes))
    }

    /// Rows become columns.
    pub fn transpose(self) -> Matrix<T> {
        Matrix(rows: self.cols, cols: self.rows, items: matrix.transpose_id<T>(self.items, [self.rows, self.cols]))
    }

    /// The sum of every item, row by row.
    pub fn sum(self) -> T
        require self.rows > 0 and self.cols > 0
    {
        matrix.sums_id<T>(self.items, [self.rows, self.cols, 0])[0]
    }

    /// The sum of each row.
    pub fn sum_rows(self) -> [T] {
        matrix.sums_id<T>(self.items, [self.rows, self.cols, 1])
    }

    /// The sum of each column.
    pub fn sum_cols(self) -> [T] {
        matrix.sums_id<T>(self.items, [self.rows, self.cols, 2])
    }

    /// The rows from `row_start` up to `row_end`, and the columns from
    /// `col_start` up to `col_end`, as a new matrix.
    pub fn slice(self, row_start: Int, row_end: Int, col_start: Int, col_end: Int) -> Matrix<T>
        require row_start >= 0 and row_start <= row_end and row_end <= self.rows
        require col_start >= 0 and col_start <= col_end and col_end <= self.cols
    {
        let items: [T] = []
        for i in row_start..row_end {
            items += self.items.slice(i * self.cols + col_start, i * self.cols + col_end)
        }
        Matrix(rows: row_end - row_start, cols: col_end - col_start, items: items)
    }
}

/// The matrix with these rows, which must all be as long.
pub fn of<T>(rows: [[T]]) -> Matrix<T> {
    const cols = if rows.is_empty() { 0 } else { rows[0].len() }
    let items: [T] = []
    for r in rows {
        if r.len() != cols {
            panic("the rows of a matrix must be as long: one has {r.len()} items, the first {cols} (spec 2.17)")
        }
        items += r
    }
    Matrix(rows: rows.len(), cols: cols, items: items)
}

/// A `rows` × `cols` matrix with every item `value`.
pub fn filled<T>(rows: Int, cols: Int, value: T) -> Matrix<T>
    require rows >= 0 and cols >= 0
{
    let items: [T] = []
    for _ in 0..rows * cols {
        items.push(value)
    }
    Matrix(rows: rows, cols: cols, items: items)
}

/// `n` × `n`, `one` on the diagonal and zeros elsewhere.
pub fn identity<T>(n: Int, one: T) -> Matrix<T>
    require n >= 0
{
    const zero = matrix.zip_id<T>([one], [one], 1)[0]
    let m = filled(n, n, zero)
    for i in 0..n {
        m.items[i * n + i] = one
    }
    m
}
