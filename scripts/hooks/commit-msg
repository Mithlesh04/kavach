#!/bin/sh
# Git commit-msg hook: enforces the commit rules in AGENTS.md (section 10).
#   - subject: required, at most 60 characters, no trailing period
#   - blank line between subject and body; body at most 8 lines of at most 72 characters
#   - no AI attribution: AI tools are never co-authors; human co-authors are welcome
# Install: sh scripts/install-hooks.sh   CI can also run: sh scripts/hooks/commit-msg <message-file>

# Count characters, not bytes, so non-English subjects are measured fairly.
export LC_ALL=C.UTF-8

MAX_SUBJECT=60
MAX_BODY_LINES=8
MAX_LINE=72

[ -f "$1" ] || { echo "usage: commit-msg <message-file>" >&2; exit 2; }

# The message as git will store it: no comment lines, nothing below the --verbose scissors line.
msg=$(sed -e '/^# -* >8 -*$/,$d' -e '/^#/d' -e 's/[[:space:]]*$//' "$1")
fail=0
err() { echo "commit-msg: $*" >&2; fail=1; }

subject=$(printf '%s\n' "$msg" | sed -n '1p')
second=$(printf '%s\n' "$msg" | sed -n '2p')
# Body: everything after line 2, without trailing blank lines and without trailers.
body=$(printf '%s\n' "$msg" | sed '1,2d' | sed -e :a -e '/^\n*$/{$d;N;ba' -e '}' \
    | grep -viE '^(co-authored-by|signed-off-by|reviewed-by|refs|fixes):')

# 1. Subject
case "$subject" in
    "") err "the subject line is empty." ;;
    "Merge "*|"Revert \""*|"fixup! "*|"squash! "*) ;;      # generated by git
    *)
        len=$(printf '%s' "$subject" | wc -m | tr -d ' ')
        [ "$len" -le "$MAX_SUBJECT" ] || err "subject has $len characters (limit $MAX_SUBJECT). Say what changed, not how."
        case "$subject" in *.) err "end the subject without a period." ;; esac
        ;;
esac

# 2. Body
[ -z "$second" ] || err "leave line 2 empty, between the subject and the body."
if [ -n "$body" ]; then
    n=$(printf '%s\n' "$body" | grep -c '')
    [ "$n" -le "$MAX_BODY_LINES" ] || err "body has $n lines (limit $MAX_BODY_LINES). Keep the details in the PR or the docs."
    long=$(printf '%s\n' "$body" | awk -v max="$MAX_LINE" 'length($0) > max { c++ } END { print c + 0 }')
    [ "$long" -eq 0 ] || err "$long body line(s) longer than $MAX_LINE characters."
fi

# 3. No AI co-authors or AI attribution. Keep this list in sync with AGENTS.md section 10.
ai='claude|anthropic|copilot|chatgpt|openai|gpt-?[0-9]|gemini|cursor|codeium|windsurf|tabnine|codewhisperer|amazon q|aider|sourcegraph cody|[[]bot[]]'
bad_trailer=$(printf '%s\n' "$msg" | grep -iE '^(co-authored-by|signed-off-by):' | grep -iE "$ai")
[ -z "$bad_trailer" ] || err "AI tools can't be co-authors. Remove: $bad_trailer"
if printf '%s\n' "$msg" | grep -iqE 'generated (with|by) .*('"$ai"')|🤖'; then
    err "remove the 'generated with AI' line. Commits name only the people responsible."
fi

# 4. Human co-authors must use the standard form, so GitHub can credit them.
printf '%s\n' "$msg" | grep -iE '^co-authored-by:' | grep -viqE '^co-authored-by: [^<]+ <[^>@ ]+@[^> ]+>$' \
    && err "write co-authors as: Co-authored-by: Full Name <email@example.com>"

if [ "$fail" -ne 0 ]; then
    echo "commit-msg: rules are in AGENTS.md, section 10. Your message is saved in $1" >&2
fi
exit "$fail"
