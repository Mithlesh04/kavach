{
  "name": "kavach",
  "displayName": "Kavach",
  "description": "Kavach for VS Code: syntax highlighting (.kav files and ```kavach blocks in Markdown), errors as you type, hover and go to definition through `kavach lsp`.",
  "version": "0.2.0",
  "publisher": "kavach",
  "license": "Apache-2.0 OR MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/Mithlesh04/kavach.git",
    "directory": "editors/vscode"
  },
  "engines": {
    "vscode": "^1.75.0"
  },
  "categories": ["Programming Languages"],
  "main": "./extension.js",
  "activationEvents": ["onLanguage:kavach"],
  "contributes": {
    "languages": [
      {
        "id": "kavach",
        "aliases": ["Kavach", "kavach"],
        "extensions": [".kav"],
        "configuration": "./language-configuration.json",
        "icon": {
          "light": "./icons/kavach.svg",
          "dark": "./icons/kavach.svg"
        }
      }
    ],
    "grammars": [
      {
        "language": "kavach",
        "scopeName": "source.kavach",
        "path": "./syntaxes/kavach.tmLanguage.json",
        "embeddedLanguages": {
          "meta.embedded.block.sql": "sql",
          "meta.embedded.line.sql": "sql"
        }
      },
      {
        "scopeName": "markdown.kavach.codeblock",
        "path": "./syntaxes/kavach-markdown.tmLanguage.json",
        "injectTo": ["text.html.markdown"],
        "embeddedLanguages": {
          "meta.embedded.block.kavach": "kavach"
        }
      }
    ],
    "configurationDefaults": {
      "editor.semanticTokenColorCustomizations": {
        "rules": {
          "*.imported:kavach": "#C3A6FF",
          "method.defaultLibrary:kavach": "#D7BA7D"
        },
        "[*Light*]": {
          "rules": {
            "*.imported:kavach": "#7A3E9D",
            "method.defaultLibrary:kavach": "#8A6D00"
          }
        }
      },
      "editor.tokenColorCustomizations": {
        "textMateRules": [
          {
            "scope": "comment.line.documentation.kavach",
            "settings": { "foreground": "#4FA8A8" }
          }
        ],
        "[*Light*]": {
          "textMateRules": [
            {
              "scope": "comment.line.documentation.kavach",
              "settings": { "foreground": "#1D7A7A" }
            }
          ]
        }
      }
    },
    "configuration": {
      "title": "Kavach",
      "properties": {
        "kavach.path": {
          "type": "string",
          "default": "kavach",
          "description": "The kavach program that runs the language server (`kavach lsp`): a full path, or a name found on PATH."
        }
      }
    }
  },
  "scripts": {
    "test": "npx --yes vscode-tmgrammar-test@0.1.3 -g syntaxes/kavach.tmLanguage.json \"tests/*.kav\"",
    "test:client": "node tests/client.test.js ../../target/debug/kavach",
    "package": "npx --yes @vscode/vsce@3.2.1 package --skip-license --allow-missing-repository"
  }
}
