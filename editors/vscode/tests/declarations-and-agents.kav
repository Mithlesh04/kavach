type Query {
    limit: Int = 100
//  ^^^^^ - keyword.other.agent.kavach

    fn take(self, n: Int) -> Query {
        self with { limit: n }
//      ^^^^ variable.language.self.kavach
//                  ^^^^^ - keyword.other.agent.kavach
    }

    fn show(self) -> String {
        `LIMIT {self.limit}`
//                   ^^^^^ - keyword.other.agent.kavach
    }
}

